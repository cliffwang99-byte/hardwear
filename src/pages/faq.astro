---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Frequently Asked Questions - MrKB">
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-primary-600 via-primary-500 to-orange-500 dark:from-primary-700 dark:via-primary-600 dark:to-orange-600 text-white py-16 sm:py-20 overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-10 start-10 w-72 h-72 bg-white rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 end-10 w-96 h-96 bg-white rounded-full blur-3xl"></div>
    </div>

    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <div class="w-20 h-20 bg-white/20 backdrop-blur-sm rounded-2xl flex items-center justify-center mx-auto mb-6">
          <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold mb-4">Frequently Asked Questions</h1>
        <p class="text-lg sm:text-xl text-white/90 leading-relaxed">
          Payment terms, production lead times, ocean freight and customs, QC and warranty. The commercial details behind every project quote.
        </p>
      </div>
    </div>
  </section>

  <!-- Search Bar -->
  <section class="py-8 bg-white dark:bg-dark-900 border-b border-gray-200 dark:border-dark-800">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto">
        <div class="relative">
          <input
            type="text"
            id="faq-search"
            placeholder="Search for answers..."
            class="w-full px-6 py-4 ps-14 bg-gray-50 dark:bg-dark-800 border-2 border-gray-200 dark:border-dark-700 rounded-xl focus:outline-none focus:border-primary-500 dark:focus:border-primary-500 text-gray-900 dark:text-white transition-colors"
          />
          <svg class="w-6 h-6 text-gray-400 absolute start-4 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- Category Navigation -->
  <section class="py-8 bg-gray-50 dark:bg-dark-800 border-b border-gray-200 dark:border-dark-800">
    <div class="container mx-auto px-4">
      <div class="flex flex-wrap gap-3 justify-center">
        <button class="category-filter active px-6 py-2.5 bg-primary-600 text-white rounded-lg font-semibold hover:bg-primary-700 transition-colors" data-category="all">
          All Questions
        </button>
        <button class="category-filter px-6 py-2.5 bg-white dark:bg-dark-900 text-gray-700 dark:text-gray-300 rounded-lg font-semibold hover:bg-gray-100 dark:hover:bg-dark-700 transition-colors border border-gray-200 dark:border-dark-700" data-category="pricing">
          Pricing &amp; Access
        </button>
        <button class="category-filter px-6 py-2.5 bg-white dark:bg-dark-900 text-gray-700 dark:text-gray-300 rounded-lg font-semibold hover:bg-gray-100 dark:hover:bg-dark-700 transition-colors border border-gray-200 dark:border-dark-700" data-category="payment">
          Payment Terms
        </button>
        <button class="category-filter px-6 py-2.5 bg-white dark:bg-dark-900 text-gray-700 dark:text-gray-300 rounded-lg font-semibold hover:bg-gray-100 dark:hover:bg-dark-700 transition-colors border border-gray-200 dark:border-dark-700" data-category="leadtime">
          Lead Times
        </button>
        <button class="category-filter px-6 py-2.5 bg-white dark:bg-dark-900 text-gray-700 dark:text-gray-300 rounded-lg font-semibold hover:bg-gray-100 dark:hover:bg-dark-700 transition-colors border border-gray-200 dark:border-dark-700" data-category="shipping">
          Shipping &amp; Customs
        </button>
        <button class="category-filter px-6 py-2.5 bg-white dark:bg-dark-900 text-gray-700 dark:text-gray-300 rounded-lg font-semibold hover:bg-gray-100 dark:hover:bg-dark-700 transition-colors border border-gray-200 dark:border-dark-700" data-category="quality">
          QC &amp; Warranty
        </button>
      </div>
    </div>
  </section>

  <!-- FAQ Content -->
  <section class="py-16 sm:py-20 bg-white dark:bg-dark-900">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">

        <!-- Group 1: Pricing & Access -->
        <div class="mb-12 faq-category" data-category="pricing">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 bg-primary-100 dark:bg-primary-900/30 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <div>
              <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Commercial Pricing Protection &amp; Sourcing Access</h2>
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Why prices stay hidden, and how trade buyers get verified.</p>
            </div>
          </div>

          <div class="space-y-4">
            <div class="faq-item bg-gray-50 dark:bg-dark-800 rounded-xl overflow-hidden">
              <button class="faq-trigger w-full px-6 py-5 text-start flex items-center justify-between hover:bg-gray-100 dark:hover:bg-dark-700 transition-colors">
                <span class="font-semibold text-gray-900 dark:text-white">Why are exact prices hidden, and why is there no account login?</span>
                <svg class="w-5 h-5 text-gray-500 transition-transform faq-icon shrink-0 ms-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="faq-content hidden px-6 pb-5">
                <p class="text-gray-600 dark:text-gray-400">
                  We only sell to B2B trade buyers, not retail consumers. Hiding prices ($??.??) protects your project bid margins from local competitors. You do not need to register an account &mdash; just add items to your Quote List, and our team will verify your business info and send your tiered quote within 24 hours.
                </p>
              </div>
            </div>

            <div class="faq-item bg-gray-50 dark:bg-dark-800 rounded-xl overflow-hidden">
              <button class="faq-trigger w-full px-6 py-5 text-start flex items-center justify-between hover:bg-gray-100 dark:hover:bg-dark-700 transition-colors">
                <span class="font-semibold text-gray-900 dark:text-white">What is your minimum order quantity (MOQ) across different categories?</span>
                <svg class="w-5 h-5 text-gray-500 transition-transform faq-icon shrink-0 ms-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="faq-content hidden px-6 pb-5">
                <p class="text-gray-600 dark:text-gray-400">
                  Our standard wholesale MOQ is 10 sets for bathroom vanities and 50 pieces for basin faucets and drains. If you need to check quality or match a custom space before bulk production, we accept 1-piece sample or single-unit vanity orders at sample pricing.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Group 2: Payment Terms -->
        <div class="mb-12 faq-category" data-category="payment">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 bg-orange-100 dark:bg-orange-900/30 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
              </svg>
            </div>
            <div>
              <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Payment Terms &amp; Settlement</h2>
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Deposits, letters of credit, and price locking for phased projects.</p>
            </div>
          </div>

          <div class="space-y-4">
            <div class="faq-item bg-gray-50 dark:bg-dark-800 rounded-xl overflow-hidden">
              <button class="faq-trigger w-full px-6 py-5 text-start flex items-center justify-between hover:bg-gray-100 dark:hover:bg-dark-700 transition-colors">
                <span class="font-semibold text-gray-900 dark:text-white">What payment terms do you accept for sample orders and bulk containers?</span>
                <svg class="w-5 h-5 text-gray-500 transition-transform faq-icon shrink-0 ms-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="faq-content hidden px-6 pb-5">
                <p class="text-gray-600 dark:text-gray-400">
                  For sample orders, we accept 100% upfront payment via T/T (wire transfer) or Wise/PayPal. For standard bulk orders, our term is 30% T/T deposit to start production and 70% balance before container loading (after you approve our pre-shipment QC photos and inspection report).
                </p>
              </div>
            </div>

            <div class="faq-item bg-gray-50 dark:bg-dark-800 rounded-xl overflow-hidden">
              <button class="faq-trigger w-full px-6 py-5 text-start flex items-center justify-between hover:bg-gray-100 dark:hover:bg-dark-700 transition-colors">
                <span class="font-semibold text-gray-900 dark:text-white">Do you accept Letters of Credit (L/C) for large commercial projects?</span>
                <svg class="w-5 h-5 text-gray-500 transition-transform faq-icon shrink-0 ms-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="faq-content hidden px-6 pb-5">
                <p class="text-gray-600 dark:text-gray-400">
                  Yes. For full container orders (40HQ) or large multi-phase hotel and apartment contracts, we accept irrevocable L/C at sight from top-tier international banks, subject to project review.
                </p>
              </div>
            </div>

            <div class="faq-item bg-gray-50 dark:bg-dark-800 rounded-xl overflow-hidden">
              <button class="faq-trigger w-full px-6 py-5 text-start flex items-center justify-between hover:bg-gray-100 dark:hover:bg-dark-700 transition-colors">
                <span class="font-semibold text-gray-900 dark:text-white">Can I lock in material costs for a multi-phase building project?</span>
                <svg class="w-5 h-5 text-gray-500 transition-transform faq-icon shrink-0 ms-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="faq-content hidden px-6 pb-5">
                <p class="text-gray-600 dark:text-gray-400">
                  Yes. Once you confirm a master supply contract and place a deposit, we lock your unit pricing for scheduled phased shipments (for example, 3 containers over 6 months) so raw material fluctuations do not break your budget.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Group 3: Lead Times -->
        <div class="mb-12 faq-category" data-category="leadtime">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Sampling &amp; Production Lead Times</h2>
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Sample turnaround, bulk schedules, and when the clock starts.</p>
            </div>
          </div>

          <div class="space-y-4">
            <div class="faq-item bg-gray-50 dark:bg-dark-800 rounded-xl overflow-hidden">
              <button class="faq-trigger w-full px-6 py-5 text-start flex items-center justify-between hover:bg-gray-100 dark:hover:bg-dark-700 transition-colors">
                <span class="font-semibold text-gray-900 dark:text-white">How long does it take to produce samples vs. a full container?</span>
                <svg class="w-5 h-5 text-gray-500 transition-transform faq-icon shrink-0 ms-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="faq-content hidden px-6 pb-5">
                <p class="text-gray-600 dark:text-gray-400">
                  Standard catalogue samples ship in 7 to 10 days, while custom-sized vanity samples take 12 to 15 days. For bulk production, standard orders take 30 to 35 days after deposit and drawing approval. Custom OEM finishes or large 40HQ mixed containers take 35 to 45 days.
                </p>
              </div>
            </div>

            <div class="faq-item bg-gray-50 dark:bg-dark-800 rounded-xl overflow-hidden">
              <button class="faq-trigger w-full px-6 py-5 text-start flex items-center justify-between hover:bg-gray-100 dark:hover:bg-dark-700 transition-colors">
                <span class="font-semibold text-gray-900 dark:text-white">When does the production clock officially start?</span>
                <svg class="w-5 h-5 text-gray-500 transition-transform faq-icon shrink-0 ms-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="faq-content hidden px-6 pb-5">
                <p class="text-gray-600 dark:text-gray-400">
                  Production starts on the day we receive both your 30% deposit and your signed 2D CAD / finish confirmation sheet. Getting drawings approved early prevents production delays.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Group 4: Shipping & Customs -->
        <div class="mb-12 faq-category" data-category="shipping">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 bg-indigo-100 dark:bg-indigo-900/30 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
              </svg>
            </div>
            <div>
              <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Shipping, FCL Consolidation &amp; Customs</h2>
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Incoterms, cavity loading, and clearance paperwork.</p>
            </div>
          </div>

          <div class="space-y-4">
            <div class="faq-item bg-gray-50 dark:bg-dark-800 rounded-xl overflow-hidden">
              <button class="faq-trigger w-full px-6 py-5 text-start flex items-center justify-between hover:bg-gray-100 dark:hover:bg-dark-700 transition-colors">
                <span class="font-semibold text-gray-900 dark:text-white">Which shipping terms (Incoterms) do you quote?</span>
                <svg class="w-5 h-5 text-gray-500 transition-transform faq-icon shrink-0 ms-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="faq-content hidden px-6 pb-5">
                <p class="text-gray-600 dark:text-gray-400">
                  We quote EXW, FOB (Shenzhen, Guangzhou, or Nansha), CIF to your destination port, and DDP (door-to-door) for select markets. If you already work with your own freight forwarder in China, we coordinate loading directly with them at zero extra handling fees.
                </p>
              </div>
            </div>

            <div class="faq-item bg-gray-50 dark:bg-dark-800 rounded-xl overflow-hidden">
              <button class="faq-trigger w-full px-6 py-5 text-start flex items-center justify-between hover:bg-gray-100 dark:hover:bg-dark-700 transition-colors">
                <span class="font-semibold text-gray-900 dark:text-white">How do you consolidate faucets inside vanity containers without customs issues?</span>
                <svg class="w-5 h-5 text-gray-500 transition-transform faq-icon shrink-0 ms-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="faq-content hidden px-6 pb-5">
                <p class="text-gray-600 dark:text-gray-400">
                  We place boxed faucets and drains inside protected vanity bottom cavities with high-density EPE foam to save container space (CBM). On your Commercial Invoice and Packing List, every item is listed separately with its exact quantity, weight, and HS Code, ensuring smooth customs clearance at your port.
                </p>
              </div>
            </div>

            <div class="faq-item bg-gray-50 dark:bg-dark-800 rounded-xl overflow-hidden">
              <button class="faq-trigger w-full px-6 py-5 text-start flex items-center justify-between hover:bg-gray-100 dark:hover:bg-dark-700 transition-colors">
                <span class="font-semibold text-gray-900 dark:text-white">Do you hold ready-to-ship stock in local US or overseas warehouses?</span>
                <svg class="w-5 h-5 text-gray-500 transition-transform faq-icon shrink-0 ms-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="faq-content hidden px-6 pb-5">
                <p class="text-gray-600 dark:text-gray-400">
                  No. All orders ship 100% factory-direct from China. Skipping overseas warehouse storage fees keeps our unit prices significantly lower for your project bids.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Group 5: QC & Warranty -->
        <div class="mb-12 faq-category" data-category="quality">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 bg-green-100 dark:bg-green-900/30 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 013.296-1.043 3.745 3.745 0 013.296 1.043A3.745 3.745 0 0121 12z" />
              </svg>
            </div>
            <div>
              <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Quality Control, Claims &amp; Warranty</h2>
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Pre-shipment inspection, damage claims, and warranty coverage.</p>
            </div>
          </div>

          <div class="space-y-4">
            <div class="faq-item bg-gray-50 dark:bg-dark-800 rounded-xl overflow-hidden">
              <button class="faq-trigger w-full px-6 py-5 text-start flex items-center justify-between hover:bg-gray-100 dark:hover:bg-dark-700 transition-colors">
                <span class="font-semibold text-gray-900 dark:text-white">How do you inspect goods before loading, and can I send my own inspector?</span>
                <svg class="w-5 h-5 text-gray-500 transition-transform faq-icon shrink-0 ms-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="faq-content hidden px-6 pb-5">
                <p class="text-gray-600 dark:text-gray-400">
                  Our independent QC team checks every batch before loading &mdash; verifying cross-factory color match (Delta E &lt; 1.5), 1.6 MPa faucet water pressure, and pre-cut drainage openings. You receive a full photo and video inspection log before paying the balance. You are also welcome to send third-party inspectors (such as SGS, BV, or Intertek) to our factories.
                </p>
              </div>
            </div>

            <div class="faq-item bg-gray-50 dark:bg-dark-800 rounded-xl overflow-hidden">
              <button class="faq-trigger w-full px-6 py-5 text-start flex items-center justify-between hover:bg-gray-100 dark:hover:bg-dark-700 transition-colors">
                <span class="font-semibold text-gray-900 dark:text-white">What happens if goods arrive damaged, and what is your warranty?</span>
                <svg class="w-5 h-5 text-gray-500 transition-transform faq-icon shrink-0 ms-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="faq-content hidden px-6 pb-5 space-y-3">
                <p class="text-gray-600 dark:text-gray-400">
                  <strong>12-Month Limited Warranty (From B/L Date):</strong> We provide a 12-month limited warranty from the Bill of Lading (B/L) date, covering manufacturing defects in material and workmanship only (such as brass casting defects, faulty ceramic cartridges, substandard plating peel-off, or cabinet structural defects).
                </p>
                <p class="text-gray-600 dark:text-gray-400">
                  <strong>What Is Excluded:</strong> Normal wear and tear, shipping damage reported more than 14 days after delivery, improper installation, high water pressure / water hammer, scale or corrosion from local hard water, chemical or abrasive cleaning, and modified units. Consumables&mdash;including seals, hoses, aerators, and filters&mdash;carry a 3-to-6-month defect coverage only.
                </p>
                <p class="text-gray-600 dark:text-gray-400">
                  <strong>How Claims Are Resolved (Parts &amp; Replacement Only):</strong> Send photos or videos of the defect along with the carton batch number within the warranty period. We respond within 48 hours and, once confirmed, supply free replacement parts or units shipped with your next container order (or via courier at buyer's freight cost for urgent job sites). (Note: Warranty covers replacement parts/units only and does not cover local installation or labor costs).
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- No Results -->
        <div id="faq-empty" class="hidden text-center py-12">
          <svg class="w-12 h-12 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <p class="text-gray-600 dark:text-gray-400">No answers matched that search. Try a different keyword or contact our trade desk.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Still Have Questions -->
  <section class="py-16 sm:py-20 bg-gray-50 dark:bg-dark-800">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
