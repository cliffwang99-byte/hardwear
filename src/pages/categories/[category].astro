---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import FilterSidebar from '../../components/FilterSidebar.astro';
import CatalogLeadBanner from '../../components/CatalogLeadBanner.astro';

import { decodeSlug, getSeoMeta, getSiteSettings } from 'emdash';
import { createPublicPageContext } from 'emdash/page';
import { PortableText, Image } from 'emdash/ui';
import { localizePath } from '../../lib/i18n';
const currentLocale = Astro.currentLocale ?? 'en';
function localizeUrl(url: string): string {
  return localizePath(url, currentLocale);
}
import { getCategoryPageData, getProductsByCategory, getCategoryFilterData, getCategories, getTopics, faqBlocksToItems } from '../../lib/shop';

const { category } = Astro.params;

// Category lookup — merge taxonomy (collection) term with rich `categories` entry
const taxCategorySlug = decodeSlug(category ?? '');
const catMeta = await getCategoryPageData(taxCategorySlug);
const taxProducts = catMeta ? await getProductsByCategory(taxCategorySlug) : [];
const categories = await getCategories();
const topics = await getTopics();

// Category data
const categoryData: Record<string, any> = {
  'cement': {
    name: 'Cement & Concrete',
    icon: '🏗️',
    description: 'Premium cement and concrete products for all your construction needs',
    banner: 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1200&h=400&fit=crop',
    totalProducts: 2450
  },
  'cement-concrete': {
    name: 'Cement & Concrete',
    icon: '🏗️',
    description: 'Premium cement and concrete products for all your construction needs',
    banner: 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1200&h=400&fit=crop',
    totalProducts: 2450
  },
  'steel-metal': {
    name: 'Steel & Metal',
    icon: '⚙️',
    description: 'High-quality steel and metal materials for structural projects',
    banner: 'https://images.unsplash.com/photo-1587293852726-70cdb56c2866?w=1200&h=400&fit=crop',
    totalProducts: 1890
  },
  'steel-&-metal': {
    name: 'Steel & Metal',
    icon: '⚙️',
    description: 'High-quality steel and metal materials for structural projects',
    banner: 'https://images.unsplash.com/photo-1587293852726-70cdb56c2866?w=1200&h=400&fit=crop',
    totalProducts: 1890
  },
  'lumber-wood': {
    name: 'Lumber & Wood',
    icon: '🪵',
    description: 'Premium lumber and wood products for construction and finishing',
    banner: 'https://images.unsplash.com/photo-1563453392212-326f5e854473?w=1200&h=400&fit=crop',
    totalProducts: 3200
  },
  'lumber-&-wood': {
    name: 'Lumber & Wood',
    icon: '🪵',
    description: 'Premium lumber and wood products for construction and finishing',
    banner: 'https://images.unsplash.com/photo-1563453392212-326f5e854473?w=1200&h=400&fit=crop',
    totalProducts: 3200
  },
  'tools-equipment': {
    name: 'Tools & Equipment',
    icon: '🔨',
    description: 'Professional tools and equipment for every construction task',
    banner: 'https://images.unsplash.com/photo-1504148455328-c376907d081c?w=1200&h=400&fit=crop',
    totalProducts: 5600
  },
  'tools-&-equipment': {
    name: 'Tools & Equipment',
    icon: '🔨',
    description: 'Professional tools and equipment for every construction task',
    banner: 'https://images.unsplash.com/photo-1504148455328-c376907d081c?w=1200&h=400&fit=crop',
    totalProducts: 5600
  }
};

const currentCategory = catMeta
  ? {
      name: catMeta.name || categoryData[taxCategorySlug]?.name || categoryData['cement'].name,
      icon: '🛁',
      description: catMeta.termDescription || catMeta.seoDescription || categoryData[taxCategorySlug]?.description || 'Products in this collection.',
      banner: catMeta.banner || categoryData[taxCategorySlug]?.banner || 'https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?w=1200&h=400&fit=crop',
      totalProducts: catMeta.totalProducts || categoryData[taxCategorySlug]?.totalProducts || categoryData['cement'].totalProducts
    }
  : categoryData[taxCategorySlug] || categoryData['cement'];

const longtextBlocks = catMeta?.longDescriptionBlocks ?? [];
const hasLongtext = longtextBlocks.length > 0;
const faqBlocks = catMeta?.faqBlocks ?? [];
const faqItems = faqBlocksToItems(faqBlocks);
const hasFaq = faqItems.length > 0;

const products = taxProducts.length ? taxProducts : [];

// 动态筛选（静态属性 + 变体维度）：仅在确实由 taxonomy 驱动产品时计算，
// 静态 fallback 数据无属性、groups 为空，筛选栏自动不渲染该区块。
const refine = taxProducts.length
  ? await getCategoryFilterData(taxCategorySlug)
  : { groups: [], productValues: {} };
const refineGroups = refine.groups;
const refineByProduct = refine.productValues;

const siteSettings = await getSiteSettings();
const siteTitle = siteSettings.title || 'MrKB';
const titleSeparator = siteSettings.seo?.titleSeparator || ' | ';
const siteUrl = siteSettings.url || Astro.url.origin;

const seoMeta = getSeoMeta(
  {
    data: {
      seo: {
        title: catMeta?.seoTitle || null,
        description: catMeta?.seoDescription || null,
        image: catMeta?.seoImage || null,
        canonical: catMeta?.seoCanonical || null,
        noIndex: catMeta?.seoNoIndex ?? false,
      },
    },
  },
  {
    siteTitle,
    siteUrl,
    titleSeparator,
    path: Astro.url.pathname,
    defaultTitle: currentCategory.name,
    defaultDescription: currentCategory.description,
    defaultOgImage: currentCategory.banner,
  },
);

const pageContext = createPublicPageContext({
  Astro,
  kind: 'content',
  pageType: 'website',
  title: seoMeta.title,
  description: seoMeta.description,
  canonical: seoMeta.canonical,
  image: seoMeta.ogImage || currentCategory.banner,
  content: catMeta?.entryId ? { collection: catMeta.collection, id: catMeta.entryId, slug: taxCategorySlug } : undefined,
  seo: {
    ogTitle: seoMeta.ogTitle,
    ogDescription: seoMeta.ogDescription,
    ogImage: seoMeta.ogImage,
    robots: seoMeta.robots,
  },
  siteName: siteTitle,
  siteUrl,
  breadcrumbs: [
    { name: 'Home', url: localizeUrl('/') },
    { name: 'Categories', url: localizeUrl('/categories') },
    { name: currentCategory.name, url: Astro.url.pathname },
  ],
});
---

<BaseLayout title={pageContext.title ?? ''} page={pageContext}>
  <!-- Category Banner -->
  <section class="relative bg-gradient-to-br from-dark-950 via-primary-950 to-dark-950 text-white overflow-hidden">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0">
      <Image image={currentCategory.banner} alt={currentCategory.name} width={1600} height={600} class="w-full h-full object-cover opacity-20" />
      <div class="absolute inset-0 bg-gradient-to-r from-dark-950/90 via-dark-950/70 to-dark-950/90"></div>
    </div>

    <!-- Animated Pattern -->
    <div class="absolute inset-0 opacity-[0.03]">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="category-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
            <path d="M 100 0 L 0 0 0 100" fill="none" stroke="white" stroke-width="0.5"/>
            <circle cx="0" cy="0" r="2" fill="white"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#category-pattern)"/>
      </svg>
    </div>

    <div class="container mx-auto px-4 py-16 md:py-20 relative z-10">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm mb-6 animate-fade-in">
        <a href={localizeUrl("/")} class="text-primary-300 hover:text-white transition-colors duration-300">Home</a>
        <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <a href={localizeUrl("/categories")} class="text-primary-300 hover:text-white transition-colors duration-300">Categories</a>
        <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-white font-medium">{currentCategory.name}</span>
      </nav>

      <!-- Category Header -->
      <div class="max-w-3xl">
        <div style="animation: fadeInUp 0.6s ease-in-out 0.1s both;">
          <h1 class="text-3xl md:text-4xl font-bold mb-2">{catMeta?.customizationH1 || currentCategory.name}</h1>
        </div>
        <p class="text-base text-white/80 leading-relaxed" style="animation: fadeInUp 0.6s ease-in-out 0.2s both;">
          {currentCategory.description}
        </p>
      </div>
    </div>

    <!-- Wave Divider -->
    <div class="absolute bottom-0 start-0 end-0">
      <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
        <path d="M0 80L60 70C120 60 240 40 360 35C480 30 600 40 720 45C840 50 960 50 1080 45C1200 40 1320 30 1380 25L1440 20V80H1380C1320 80 1200 80 1080 80C960 80 840 80 720 80C600 80 480 80 360 80C240 80 120 80 60 80H0Z" class="fill-white dark:fill-dark-950"/>
      </svg>
    </div>
  </section>

  <!-- Main Content -->
  <section class="container mx-auto px-4 py-12">
    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Sidebar Filters -->
      <aside class="lg:w-64 flex-shrink-0">
        <FilterSidebar categories={categories} topics={topics} attributeGroups={refineGroups} />
      </aside>

      <!-- Products Grid -->
      <div class="flex-1">
        <!-- Toolbar -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8 pb-6 border-b border-gray-200 dark:border-dark-800">
          <div>
            <p class="text-gray-600 dark:text-gray-400">
              Showing <span class="font-semibold text-gray-900 dark:text-white" data-filter-count>{products.length}</span> of 
              <span class="font-semibold text-gray-900 dark:text-white">{currentCategory.totalProducts}</span> products
            </p>
          </div>

          <!-- Sort Dropdown -->
          <div class="flex items-center gap-4">
            <label for="sort" class="text-sm font-medium text-gray-700 dark:text-gray-300">Sort by:</label>
            <select id="sort" class="px-4 py-2 rounded-xl border-2 border-gray-200 dark:border-dark-700 bg-white dark:bg-dark-800 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 transition-all duration-300">
              <option>Best Selling</option>
              <option>Price: Low to High</option>
              <option>Price: High to Low</option>
              <option>Newest</option>
              <option>Rating</option>
            </select>
          </div>
        </div>

        <!-- Products Grid -->
        <div data-filter-grid class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
          {products.map((product, i) => (
            <div style={`animation: fadeInUp 0.6s ease-in-out ${i * 0.05}s both;`} data-refine={JSON.stringify(refineByProduct[product.id] ?? {})}>
              <ProductCard {...product} />
            </div>
          ))}
        </div>

        <p data-filter-empty class="hidden text-center text-gray-500 dark:text-gray-400 py-16">
          No products match the selected filters.
        </p>

        <!-- Pagination -->
        <div class="flex justify-center items-center gap-2">
          <button class="px-4 py-2 rounded-xl border-2 border-gray-200 dark:border-dark-700 hover:border-primary-500 dark:hover:border-primary-500 transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed" disabled>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          
          {[1, 2, 3, 4, 5].map(page => (
            <button class={`px-4 py-2 rounded-xl border-2 transition-all duration-300 ${page === 1 ? 'bg-primary-600 text-white border-primary-600' : 'border-gray-200 dark:border-dark-700 hover:border-primary-500 dark:hover:border-primary-500'}`}>
              {page}
            </button>
          ))}
          
          <button class="px-4 py-2 rounded-xl border-2 border-gray-200 dark:border-dark-700 hover:border-primary-500 dark:hover:border-primary-500 transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <CatalogLeadBanner categoryName={currentCategory.name} scopeType="category" />

  <!-- Category Info Section -->
  <section class="bg-gray-50 dark:bg-dark-900 py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-6">About {currentCategory.name}</h2>
        <div class="richtext max-w-none">
          {
            hasLongtext
              ? <PortableText value={longtextBlocks as any} />
              : (
                  <>
                    <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-4">
                      Our {currentCategory.name.toLowerCase()} collection features premium quality products from trusted manufacturers. 
                      Whether you're working on a residential project or a large commercial construction, we have the right materials for your needs.
                    </p>
                    <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                      All products are tested for quality and durability, ensuring they meet industry standards. 
                      We offer competitive pricing, fast delivery, and expert support to help you choose the right products for your project.
                    </p>
                  </>
              )
          }
        </div>

        <!-- FAQ -->
        {hasFaq && (
          <div class="mt-10">
            <h2 class="text-3xl font-bold mb-6 text-gray-900 dark:text-white">Frequently Asked Questions</h2>
            <div class="space-y-4">
              {faqItems.map((item) => (
                <div class="faq-item bg-gray-50 dark:bg-dark-800 rounded-xl overflow-hidden">
                  <button type="button" class="faq-trigger w-full px-6 py-5 text-start flex items-center justify-between hover:bg-gray-100 dark:hover:bg-dark-700 transition-colors">
                    <span class="font-semibold text-gray-900 dark:text-white pe-4">{item.question}</span>
                    <svg class="w-5 h-5 shrink-0 text-gray-500 transition-transform faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                  <div class="faq-content hidden px-6 pb-5 richtext max-w-none">
                    <PortableText value={item.answerBlocks as any} />
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Features -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
          {[
            { icon: '✓', title: 'Quality Assured', desc: 'All products tested and certified' },
            { icon: '🚚', title: 'Fast Delivery', desc: 'Deliver as agreed on time' },
            { icon: '💬', title: 'Expert Support', desc: '24/7 technical assistance' }
          ].map(feature => (
            <div class="bg-white dark:bg-dark-800 rounded-2xl p-6 border border-gray-200 dark:border-dark-700 hover:border-primary-500 dark:hover:border-primary-500 transition-all duration-500 hover:shadow-xl hover:-translate-y-1">
              <div class="text-4xl mb-3">{feature.icon}</div>
              <h3 class="font-bold text-lg mb-2">{feature.title}</h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm">{feature.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll('.faq-trigger').forEach(function (trigger) {
      trigger.addEventListener('click', function () {
        var content = trigger.nextElementSibling;
        var icon = trigger.querySelector('.faq-icon');
        if (!content) return;
        content.classList.toggle('hidden');
        if (icon) icon.classList.toggle('rotate-180');
      });
    });
  </script>
</BaseLayout>