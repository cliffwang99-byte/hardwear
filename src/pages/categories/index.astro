---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'emdash/ui';
import { getSiteSettings } from 'emdash';
import { localizePath } from '../../lib/i18n';
import { getCategoryIndex } from '../../lib/shop';

const currentLocale = Astro.currentLocale ?? 'en';
function localizeUrl(url: string): string {
  return localizePath(url, currentLocale);
}

// 品类索引：展示 level-1 以下全部有产品的分类。
// 一级分类作为分组标题，二级分类作为大卡（subtree 聚合产品数），
// 三级分类作为小卡，不限数量。空分类由分类详情页重定向至此，故仅列 count > 0。
const sections = (await getCategoryIndex())
  .map((section) => ({
    ...section,
    groups: section.groups
      .filter((g) => g.count > 0)
      .map((g) => ({
        ...g,
        children: g.children.filter((c) => c.count > 0),
      })),
  }))
  .filter((section) => section.groups.length > 0);

const visibleGroups = sections.flatMap((s) => s.groups);
const totalSkus = visibleGroups.reduce((sum, g) => sum + g.count, 0);

const siteSettings = await getSiteSettings();
const siteTitle = siteSettings.title || 'MrKB';
const siteUrl = siteSettings.url || Astro.url.origin;
const siteBaseUrl = siteUrl.replace(/\/+$/, '');

const pageTitle = `Product Categories | ${siteTitle}`;
const pageDescription =
  'Browse our full range of bathroom hardware product categories. Find faucets, showers, sinks and more, each with spec-ready SKUs for project buyers.';

const currentPath = Astro.url.pathname;
const localizedBase = siteBaseUrl + currentPath;

// ==== 结构化数据（JSON-LD） ====
const breadcrumbJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${localizedBase}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteBaseUrl}${localizeUrl('/')}` },
    { '@type': 'ListItem', position: 2, name: 'Categories', item: `${siteBaseUrl}${localizeUrl('/categories')}` },
  ],
});

// 二级 + 三级分类全部列入 ItemList，二级优先级高（排前），三级随后。
const itemElements = sections.flatMap((section) =>
  section.groups.flatMap((group) => [
    { name: group.name, url: `${siteBaseUrl}${localizeUrl(`/categories/${group.slug}`)}` },
    ...group.children.map((child) => ({
      name: child.name,
      url: `${siteBaseUrl}${localizeUrl(`/categories/${child.slug}`)}`,
    })),
  ]),
);

const categoryListJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${localizedBase}#item-list`,
  name: 'Bathroom Hardware Product Categories',
  numberOfItems: itemElements.length,
  itemListElement: itemElements.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    url: item.url,
  })),
});
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={breadcrumbJsonLd}></script>
  {categoryListJsonLd && visibleGroups.length > 0 && (
    <script type="application/ld+json" set:html={categoryListJsonLd}></script>
  )}

  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-dark-950 via-primary-950 to-dark-950 text-white py-16 sm:py-20 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="categories-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
            <path d="M 100 0 L 0 0 0 100" fill="none" stroke="white" stroke-width="0.5"/>
            <circle cx="0" cy="0" r="2" fill="white"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#categories-pattern)"/>
      </svg>
    </div>

    <div class="container mx-auto px-4 relative z-10">
      <nav class="flex items-center gap-2 text-sm mb-6 animate-fade-in">
        <a href={localizeUrl('/')} class="text-primary-300 hover:text-white transition-colors duration-300">Home</a>
        <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-white font-medium">Categories</span>
      </nav>

      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl font-bold mb-3">Product Categories</h1>
        <p class="text-base text-white/80 leading-relaxed">
          {pageDescription}
        </p>
        {visibleGroups.length > 0 && (
          <p class="mt-4 text-xs uppercase tracking-widest text-primary-300">
            {visibleGroups.length} {visibleGroups.length === 1 ? 'category' : 'categories'} - {totalSkus} SKUs ready to spec
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- Category Sections: level-1 as group headings, level-2 as large bento cards,
       level-3 as small cards, unlimited count. -->
  <section class="container mx-auto px-4 py-12 sm:py-16">
    {sections.length > 0 ? (
      sections.map((section) => (
        <div class="mb-14 last:mb-0">
          <div class="flex items-center gap-4 mb-6">
            <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">{section.name}</h2>
            <div class="flex-1 h-px bg-gray-200 dark:bg-dark-700"></div>
          </div>

          <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 auto-rows-[130px] sm:auto-rows-[170px] lg:auto-rows-[190px]">
            {section.groups.map((group) => (
              <>
                <!-- Level-2: large card spanning 2x2 -->
                <a
                  href={localizeUrl(`/categories/${group.slug}`)}
                  class="group relative overflow-hidden rounded-3xl col-span-2 lg:col-span-2 row-span-2 text-white transition-all duration-500 ease-in-out hover:shadow-2xl hover:scale-[1.02] animate-on-scroll"
                >
                  {group.image ? (
                    <Image
                      image={group.image}
                      alt={group.name}
                      width={800}
                      height={600}
                      class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500 ease-in-out"
                    />
                  ) : (
                    <div class="absolute inset-0 bg-gradient-to-br from-primary-500 via-primary-600 to-primary-800"></div>
                  )}

                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/10"></div>

                  <div class="relative z-10 p-4 sm:p-6 h-full flex flex-col justify-end">
                    <h3 class="font-bold leading-tight drop-shadow-md text-lg sm:text-2xl lg:text-3xl">{group.name}</h3>
                    {group.count > 0 && (
                      <p class="mt-1.5 sm:mt-2 text-xs sm:text-sm text-white/80">{group.count} SKUs ready to spec</p>
                    )}
                  </div>

                  <div class="absolute bottom-4 end-4 opacity-0 group-hover:opacity-100 transform translate-x-2 group-hover:translate-x-0 transition-all duration-500 ease-in-out">
                    <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </div>
                </a>

                <!-- Level-3: small cards filling the remaining bento slots -->
                {group.children.map((child) => (
                  <a
                    href={localizeUrl(`/categories/${child.slug}`)}
                    class="group relative overflow-hidden rounded-2xl col-span-1 row-span-1 text-white transition-all duration-500 ease-in-out hover:shadow-xl hover:scale-[1.02] animate-on-scroll"
                  >
                    {child.image ? (
                      <Image
                        image={child.image}
                        alt={child.name}
                        width={400}
                        height={400}
                        class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500 ease-in-out"
                      />
                    ) : (
                      <div class="absolute inset-0 bg-gradient-to-br from-primary-500/90 via-primary-600/90 to-primary-800/90"></div>
                    )}

                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-black/5"></div>

                    <div class="relative z-10 p-3 sm:p-4 h-full flex flex-col justify-end">
                      <h3 class="font-semibold leading-tight drop-shadow-md text-xs sm:text-sm lg:text-base">{child.name}</h3>
                    </div>
                  </a>
                ))}
              </>
            ))}
          </div>
        </div>
      ))
    ) : (
      <p class="text-center text-gray-500 dark:text-gray-400 py-16">No categories yet</p>
    )}
  </section>
</BaseLayout>