---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About Us | Kitchen & Bath OEM/ODM & FCL Supply Chain"
  description="Learn how our manufacturing consortium supplies custom bathroom vanities, basins, and color-matched faucets with FCL consolidation and strict QC. Request a quote."
>
  <!-- ===== 1. Hero 身份定调区 ===== -->
  <section class="relative bg-gradient-to-br from-primary-600 via-primary-500 to-orange-500 dark:from-primary-700 dark:via-primary-600 dark:to-orange-600 text-white py-20 sm:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-10 start-10 w-72 h-72 bg-white rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 end-10 w-96 h-96 bg-white rounded-full blur-3xl"></div>
    </div>

    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-sm sm:text-base font-semibold tracking-widest uppercase text-white/80 mb-4">
          About Our Supply Chain
        </p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold mb-6">
          Kitchen &amp; Bath Manufacturing Consortium &amp; Supply Chain Integrator
        </h1>
        <p class="text-lg sm:text-xl text-white/90 mb-8 leading-relaxed">
          We are not a single small factory, and we are not a middleman trading agent. We unite
          specialized cabinet mills and plumbing factories in China to supply custom bathroom
          vanities, countertops, basins, and color-matched faucets in one consolidated container.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#" class="px-8 py-4 bg-white text-primary-600 rounded-xl font-semibold hover:bg-gray-100 transition-all duration-300 hover:scale-105 hover:shadow-2xl">
            Explore Bathroom Vanities &rarr;
          </a>
          <a href="#" class="px-8 py-4 bg-white/10 backdrop-blur-sm border-2 border-white/30 text-white rounded-xl font-semibold hover:bg-white/20 transition-all duration-300 hover:scale-105">
            Submit Project BOM / Request Quote
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 2. 硬核业务数据条 ===== -->
  <section class="py-16 sm:py-20 bg-white dark:bg-dark-900">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
        <div class="bg-gray-50 dark:bg-dark-800 rounded-2xl p-6 text-center shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
          <div class="text-4xl sm:text-5xl font-bold text-primary-600 dark:text-primary-400 mb-2">
            10 Sets
          </div>
          <p class="font-semibold text-gray-900 dark:text-white mb-1">Custom Vanity MOQ</p>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            1-piece sample or single custom unit available
          </p>
        </div>

        <div class="bg-gray-50 dark:bg-dark-800 rounded-2xl p-6 text-center shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
          <div class="text-4xl sm:text-5xl font-bold text-primary-600 dark:text-primary-400 mb-2">
            50 Pcs
          </div>
          <p class="font-semibold text-gray-900 dark:text-white mb-1">Basin Faucet &amp; Drain MOQ</p>
          <p class="text-sm text-gray-600 dark:text-gray-400">Chrome &amp; PVD finishes</p>
        </div>

        <div class="bg-gray-50 dark:bg-dark-800 rounded-2xl p-6 text-center shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
          <div class="text-4xl sm:text-5xl font-bold text-primary-600 dark:text-primary-400 mb-2">
            Delta E &lt; 1.5
          </div>
          <p class="font-semibold text-gray-900 dark:text-white mb-1">Cross-Factory Color Match</p>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            Spectrophotometer verified across wood &amp; metal
          </p>
        </div>

        <div class="bg-gray-50 dark:bg-dark-800 rounded-2xl p-6 text-center shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
          <div class="text-4xl sm:text-5xl font-bold text-primary-600 dark:text-primary-400 mb-2">
            20GP / 40HQ
          </div>
          <p class="font-semibold text-gray-900 dark:text-white mb-1">Nested FCL Consolidation</p>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            Mix vanities, tops, basins, and hardware in one load
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 3. 为什么选择多工厂联合体？ ===== -->
  <section class="py-16 sm:py-20 bg-gray-50 dark:bg-dark-800">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            One Container. Zero Color Mismatch.
          </h2>
          <div class="w-20 h-1 bg-gradient-to-r from-primary-600 to-orange-500 mx-auto rounded-full mb-6"></div>
          <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto leading-relaxed">
            Buying bathroom vanities from one factory and faucets from another usually creates two
            problems: mismatched finishes and wasted container space. Our supply model solves both
            before your goods leave China.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white dark:bg-dark-900 rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
            <div class="text-5xl font-bold text-primary-600/20 dark:text-primary-400/20 mb-4">01</div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">Nested FCL Consolidation</h3>
            <p class="text-sm text-black/80 dark:text-white/80 font-semibold mb-2">
              Buy from different factories? We pack them into one container.
            </p>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
              We place boxed basin faucets and pop-up drains inside the protected bottom cavities of
              your bathroom vanities. You use the container space (CBM) you already pay for and cut
              extra ocean freight costs.
            </p>
          </div>

          <div class="bg-white dark:bg-dark-900 rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
            <div class="text-5xl font-bold text-primary-600/20 dark:text-primary-400/20 mb-4">02</div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
              Unified Finish Control (Delta E &lt; 1.5)
            </h3>
            <p class="text-sm text-black/80 dark:text-white/80 font-semibold mb-2">
              Your cabinet handles and faucets match in color.
            </p>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
              Different factories often produce slightly different shades of Matte Black or Brushed
              Gold. We test metal hardware and faucets side by side with a spectrophotometer to keep
              color variation within Delta E &lt; 1.5.
            </p>
          </div>

          <div class="bg-white dark:bg-dark-900 rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
            <div class="text-5xl font-bold text-primary-600/20 dark:text-primary-400/20 mb-4">03</div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
              Factory Pre-Cut Drainage &amp; Hardware
            </h3>
            <p class="text-sm text-black/80 dark:text-white/80 font-semibold mb-2">
              No cutting wood on the job site.
            </p>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
              Tell us if your project uses wall drainage (P-trap) or floor drainage (S-trap). Our
              cabinet mills pre-cut and waterproof edge-band the back or bottom panels before
              shipping, saving your plumbers hours of labor.
            </p>
          </div>

          <div class="bg-white dark:bg-dark-900 rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
            <div class="text-5xl font-bold text-primary-600/20 dark:text-primary-400/20 mb-4">04</div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
              Single-Point QC &amp; Customs Paperwork
            </h3>
            <p class="text-sm text-black/80 dark:text-white/80 font-semibold mb-2">
              One invoice, itemized HS codes, and photo proof.
            </p>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
              Our quality team inspects every batch on the factory floor. Even when faucets are
              nested inside vanity crates, we list each item separately with its exact HS code on
              your Commercial Invoice and Packing List for smooth customs clearance.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 4. 核心供应品类与 OEM/ODM 能力 ===== -->
  <section class="py-16 sm:py-20 bg-white dark:bg-dark-900">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            Focused on Bathroom Vanities &amp; Matched Plumbing
          </h2>
          <div class="w-20 h-1 bg-gradient-to-r from-primary-600 to-orange-500 mx-auto rounded-full mb-6"></div>
          <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto leading-relaxed">
            While our consortium covers kitchen and bath hardware, our core production focus is
            complete bathroom vanity packages for builders, distributors, and importers.
          </p>
        </div>

        <div class="space-y-6">
          <div class="bg-gray-50 dark:bg-dark-800 rounded-2xl p-8 shadow-lg transition-all duration-300 hover:shadow-xl">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
              Bathroom Vanities <span class="text-sm text-primary-600 dark:text-primary-400 font-semibold">(Core Flagship)</span>
            </h3>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-4">
              E1 moisture-resistant plywood, solid wood veneer, and waterproof aluminum honeycomb
              cabinets. Available as cabinet bases only (no top) for stone fabricators, or as
              complete sets.
            </p>
            <a href="https://mrkb.net/categories/bathroom-vanities" class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 font-semibold text-sm hover:gap-3 transition-all duration-300">
              Browse Bathroom Vanities &rarr;
            </a>
          </div>

          <div class="bg-gray-50 dark:bg-dark-800 rounded-2xl p-8 shadow-lg transition-all duration-300 hover:shadow-xl">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
              Vanity Countertops &amp; Basins
            </h3>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-4">
              15mm sintered stone, solid surface, engineered quartz countertops, and integrated or
              undermount ceramic sinks cut 1:1 to fit your vanity cabinets.
            </p>
            <a href="https://mrkb.net/categories/bathroom-sinks" class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 font-semibold text-sm hover:gap-3 transition-all duration-300">
              View Countertops &amp; Basins &rarr;
            </a>
          </div>

          <div class="bg-gray-50 dark:bg-dark-800 rounded-2xl p-8 shadow-lg transition-all duration-300 hover:shadow-xl">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
              Basin Faucets &amp; Pop-Up Drains
            </h3>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-4">
              Lead-free brass and SUS304 stainless steel faucets, angle valves, and brass drains
              color-matched to your vanity hardware.
            </p>
            <a href="https://mrkb.net/categories/bathroom-faucets" class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 font-semibold text-sm hover:gap-3 transition-all duration-300">
              View Bathroom Faucets &rarr;
            </a>
          </div>

          <div class="bg-gray-50 dark:bg-dark-800 rounded-2xl p-8 shadow-lg transition-all duration-300 hover:shadow-xl">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3">
              OEM &amp; Private-Label Programs
            </h3>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
              We build to your CAD drawings and brand standards. Services include custom cabinet
              widths, laser-engraved logos on faucets, custom retail or builder cartons, and
              room-by-room project labeling.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 5. 工厂车间品控四道防线 ===== -->
  <section class="py-16 sm:py-20 bg-gray-50 dark:bg-dark-800">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            How We Inspect Your Order Before Loading
          </h2>
          <div class="w-20 h-1 bg-gradient-to-r from-primary-600 to-orange-500 mx-auto rounded-full mb-6"></div>
          <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto leading-relaxed">
            We do not rely on factory self-reports. Our engineers check physical samples and bulk
            runs against four clear standards.
          </p>
        </div>

        <div class="space-y-4">
          <div class="bg-white dark:bg-dark-900 rounded-2xl p-6 sm:p-8 shadow-lg flex items-start gap-5">
            <div class="flex-shrink-0 w-10 h-10 bg-primary-600 text-white rounded-xl flex items-center justify-center font-bold">1</div>
            <div>
              <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">
                Color &amp; Surface Durability Audit
              </h3>
              <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                We measure finish color with a spectrophotometer (Delta E &lt; 1.5) and run 48-hour
                acid salt spray tests on PVD finishes to prevent peeling or rust in humid bathrooms.
              </p>
            </div>
          </div>

          <div class="bg-white dark:bg-dark-900 rounded-2xl p-6 sm:p-8 shadow-lg flex items-start gap-5">
            <div class="flex-shrink-0 w-10 h-10 bg-primary-600 text-white rounded-xl flex items-center justify-center font-bold">2</div>
            <div>
              <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">
                Valve &amp; Pressure Testing
              </h3>
              <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                Every faucet batch undergoes 1.6 MPa static water pressure testing to ensure ceramic
                disc cartridges (the internal valve that controls water flow) do not leak under high
                building pressure.
              </p>
            </div>
          </div>

          <div class="bg-white dark:bg-dark-900 rounded-2xl p-6 sm:p-8 shadow-lg flex items-start gap-5">
            <div class="flex-shrink-0 w-10 h-10 bg-primary-600 text-white rounded-xl flex items-center justify-center font-bold">3</div>
            <div>
              <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">
                Dry-Fit &amp; Pre-Cut Verification
              </h3>
              <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                Before packing, we test-fit countertops, undermount basins, and drawer slides on the
                assembly line, and verify all wall-drain or floor-drain cutouts match your approved
                2D CAD sheet.
              </p>
            </div>
          </div>

          <div class="bg-white dark:bg-dark-900 rounded-2xl p-6 sm:p-8 shadow-lg flex items-start gap-5">
            <div class="flex-shrink-0 w-10 h-10 bg-primary-600 text-white rounded-xl flex items-center justify-center font-bold">4</div>
            <div>
              <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">
                Foam-Protected Cavity Loading
              </h3>
              <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                We pack faucets in reinforced 5-layer corrugated boxes with EPE foam inside vanity
                cavities, mark outer crates clearly (+ Faucet &amp; Drain Inside), and send you full
                container-loading photos.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 6. 目标市场合规与工程文档支持 ===== -->
  <section class="py-16 sm:py-20 bg-white dark:bg-dark-900">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            Built for Your Market's Building Codes
          </h2>
          <div class="w-20 h-1 bg-gradient-to-r from-primary-600 to-orange-500 mx-auto rounded-full mb-6"></div>
          <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto leading-relaxed">
            Certification needs vary by country and project tier. We supply compliant specifications
            for your region and provide technical files to support your local approval process.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-gray-50 dark:bg-dark-800 rounded-2xl p-8 shadow-lg transition-all duration-300 hover:shadow-xl">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">
              North America (USA &amp; Canada)
            </h3>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed text-sm">
              cUPC and NSF-61 compliant brass faucets and ceramic basins, Lead-Free waterways, 1/2"
              NPT threads, and unbranded 2D CAD rough-in drawings for fast submittal approval.
            </p>
          </div>

          <div class="bg-gray-50 dark:bg-dark-800 rounded-2xl p-8 shadow-lg transition-all duration-300 hover:shadow-xl">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">
              Middle East (Saudi Arabia &amp; UAE)
            </h3>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed text-sm">
              High-durability solid brass bodies, 48-hour acid salt-spray tested PVD finishes, 5.7
              LPM water-saving aerators, and technical documentation to support SASO / SABER
              registration.
            </p>
          </div>

          <div class="bg-gray-50 dark:bg-dark-800 rounded-2xl p-8 shadow-lg transition-all duration-300 hover:shadow-xl">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Latin America</h3>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed text-sm">
              Dual-thread compatibility (1/2" NPT and G1/2" BSP), easy-clean aerators built for
              low-pressure gravity water tanks, and value-engineered builder-grade options.
            </p>
          </div>
        </div>

        <div class="mt-6 p-5 bg-blue-50 dark:bg-blue-900/20 border-s-4 border-blue-500 rounded-e-lg max-w-4xl mx-auto">
          <p class="text-gray-700 dark:text-gray-300 text-sm">
            <strong>Note:</strong> Certification scope depends on the specific model and finish. For
            OEM/ODM private-label orders, we provide full technical documentation to assist your
            local certification application.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 7. 底部行动号召区 ===== -->
  <section class="py-16 sm:py-20 bg-gradient-to-br from-primary-700 via-primary-600 to-orange-500 dark:from-primary-800 dark:via-primary-700 dark:to-orange-600 text-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">
          Ready to Plan Your Next Container Order?
        </h2>
        <p class="text-lg text-white/90 mb-8 leading-relaxed">
          Send us your vanity specifications, target quantities, or project BOM. Our engineering
          team will reply within 24 hours with itemized FOB or CIF pricing.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/categories/bathroom-vanities" class="px-8 py-4 bg-white text-primary-600 rounded-xl font-semibold hover:bg-gray-100 transition-all duration-300 hover:scale-105 hover:shadow-2xl">
            Add Products to My Quote List &rarr;
          </a>
          <a href="/cart" class="px-8 py-4 bg-white/10 backdrop-blur-sm border-2 border-white/30 text-white rounded-xl font-semibold hover:bg-white/20 transition-all duration-300 hover:scale-105">
            Request Custom OEM Quote
          </a>
        </div>

        <div class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-5xl mx-auto text-start">
          <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/20">
            <p class="text-sm font-semibold text-white/70 mb-2">Quotes &amp; BOMs</p>
            <p class="text-white break-all">sales@mrkb.net</p>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/20">
            <p class="text-sm font-semibold text-white/70 mb-2">Custom CAD &amp; OEM Projects</p>
            <p class="text-white break-all">projects@mrkb.net</p>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 border border-white/20">
            <p class="text-sm font-semibold text-white/70 mb-2">Manufacturing Hubs</p>
            <p class="text-white">ZhongshanFoshan &amp; Jiangmen, Guangdong, China</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>