---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteSettings } from 'emdash';
import { localizePath } from '../lib/i18n';

const currentLocale = Astro.currentLocale ?? 'en';
function localizeUrl(url: string): string {
  return localizePath(url, currentLocale);
}

const pageTitle = 'How to Place a Wholesale Order | B2B Sourcing Guide';
const pageDescription =
  'Step-by-step B2B ordering guide for bathroom vanities, ceramic basins, and faucets from China. Learn how to get itemized quotes and FCL loading plans.';

const siteSettings = await getSiteSettings();
const siteUrl = (siteSettings.url || Astro.url.origin).replace(/\/+$/, '');
const pageUrl = `${siteUrl}${Astro.url.pathname}`;

const buyerRoles = [
  {
    title: 'Contractors & Property Developers',
    bestFor:
      'Hotel, multifamily, or commercial builds that need complete bathroom vanities and plumbing packages matched to architectural drawings.',
    fastest:
      'Send your floor plans or Bill of Materials (BOM) directly—no need to browse individual catalog pages one by one.',
    details: [
      'Total room or unit count and your target delivery schedule;',
      'Your BOQ / BOM spreadsheet or bathroom layout drawings (PDF, Excel, or DWG);',
      'Your destination port and local code requirements (such as cUPC for North America or SABER for Saudi Arabia).',
    ],
    action: { label: 'Upload Your Project BOM or Drawings', url: '/contact' },
  },
  {
    title: 'Building Material Wholesalers & Regional Importers',
    bestFor:
      'Distributors comparing styles, materials, and container volumes to expand local stock lines.',
    fastest:
      'Browse our product categories and add target items to your Quote List to calculate full-container margins.',
    details: [
      'Your target country and destination port (so we match 1/2" NPT or G1/2" BSP plumbing threads);',
      'Your estimated order volume (such as a 20GP or 40HQ mixed container);',
      'Your preferred models and material tier (cost-effective builder-grade or heavy-duty spec-grade).',
    ],
    action: { label: 'Browse Catalog & Build Your Quote List', url: '/categories' },
  },
  {
    title: 'Private-Label Brands & Retail Chains',
    bestFor:
      'Brand owners sourcing OEM or ODM products manufactured under their own brand name and packaging.',
    fastest:
      'Select existing base models or send reference photos/samples to confirm branding and packaging specs.',
    details: [
      'Your target product lines and order quantities (starting at 10 sets per vanity model and 50–100 pcs per faucet model);',
      'Your vector logo files and custom box or shipping mark guidelines;',
      'Your target market compliance needs (we provide full technical documentation so you can register certifications under your brand).',
    ],
    action: { label: 'Submit Your OEM / ODM Requirements', url: '/contact' },
  },
  {
    title: 'Countertop & Stone Fabricators',
    bestFor:
      'Stone shops that cut quartz or natural marble tops locally and only need cabinet bases from China.',
    fastest:
      'Select your cabinet styles and standard widths—skip countertop and sink selection completely.',
    details: [
      'Your required cabinet base widths (such as standard 600 mm to 1800 mm sizes);',
      'Your preferred carcass material and door finish (such as 100% waterproof PVC foam board or moisture-resistant plywood);',
      'Any top reinforcement needs (such as heavy-duty steel stretchers to support thick stone slabs).',
    ],
    action: { label: 'Explore Cabinet Base Specs & Request Pricing', url: '/categories/bathroom-vanities' },
  },
];

const orderSteps = [
  {
    title: 'Share Your List or Project Plans',
    body: 'Add models to your Project Quote List on our website, or send us your BOM, floor plans, or reference photos. Just include your destination port and estimated quantities.',
  },
  {
    title: 'Get Your Itemized Quote & Container Plan in 24–72 Hours',
    body: 'Our engineering team checks thread standards (1/2" NPT or G1/2" BSP) and local compliance for your market. Depending on order complexity, you will get a clear quote within 24–72 business hours, complete with unit prices, total volume (CBM), and a plan to pack everything into one container.',
  },
  {
    title: 'Approve Drawings & Optional Samples (No Unnecessary Delays)',
    bullets: [
      'Standard Catalog Models: Confirm the spec sheet and finish, and go straight to production—no sample delay needed.',
      'Custom & Project Orders: Review and sign off on our unbranded 2D CAD drawings before we start. Want to check the finish color in hand first? We ship physical samples on request (sample fees credit back toward your bulk order).',
    ],
  },
  {
    title: 'Production Starts with Cross-Factory Color Matching',
    body: 'Once you confirm the Proforma Invoice (PI) and deposit, our partner workshops begin production (30–45 days standard lead time). If your order mixes faucets, hardware, and vanities, our on-site engineers check color swatches across factories so finishes like brushed gold or matte black match with zero color difference (Delta E < 1.5).',
  },
  {
    title: 'Pre-Shipment Inspection & Smart Container Loading',
    body: 'Our inspectors test water pressure, check surface finishes, and send you inspection photos and videos before shipping. When loading, we pack smaller faucet and hardware boxes inside vanity cavities (nested loading) to maximize your 20GP or 40HQ container space and cut ocean freight costs.',
  },
  {
    title: 'Smooth Customs Docs & Job-Site Spare Parts',
    body: 'After final balance, we ship under your preferred terms (FOB, CIF, or DDP) and send all commercial invoices, packing lists, bills of lading, and compliance files right away. We also include free spare parts in every project shipment to keep your installation on schedule.',
  },
];

const tradeTerms = [
  {
    term: 'Minimum Order Quantity (MOQ)',
    policy:
      '10 sets per vanity model; 50 pcs per standard chrome faucet/hardware model, or 100 pcs per special PVD finish (brushed gold, gunmetal, matte black). Mix categories in one container.',
  },
  {
    term: 'Production Lead Time',
    policy:
      '30–45 days after spec sheet or 2D CAD sign-off and deposit receipt. Phased delivery by floor is available for large developments.',
  },
  {
    term: 'Trade & Payment Terms',
    policy:
      'EXW, FOB Guangzhou / Shenzhen, CIF Destination Port, or DDP. Standard payment is 30% deposit and 70% balance before shipment against inspection reports and loading photos.',
  },
  {
    term: 'Container Consolidation',
    policy:
      'We load consolidated containers at Guangzhou or Shenzhen ports. If you already work with a China forwarder or buy tiles and lighting elsewhere, we can also deliver your goods to your designated warehouse for combined loading.',
  },
];

const avoidItems = [
  {
    title: 'ask for a "Generic Full Price List."',
    why: 'We unite multiple specialized workshops working with solid brass, SUS304 stainless steel, zinc alloy, waterproof PVC foam board, and honeycomb aluminum. Costs change widely based on cartridge specs, PVD finishes, and market certifications.',
    instead:
      'Pick 3–10 target models (or send your BOM) with estimated quantities so we can give you real, itemized pricing.',
  },
  {
    title: 'ask for a catalog without sharing your target market.',
    why: 'North America and Mexico use 1/2" NPT threads, while the Middle East, South America, and Europe mostly use metric G1/2" (BSP). Water pressure and compliance rules also vary by country.',
    instead: 'Always mention your destination country or port and your target buyer segment first.',
  },
  {
    title: 'inquire for single-piece retail orders or dropshipping.',
    why: 'We only handle factory-direct bulk and project orders—no retail stock, no overseas retail warehouses, and no dropshipping.',
    instead:
      'Plan around our wholesale minimums of 10 sets per vanity model and 50 pcs per faucet model, and combine categories into one container.',
  },
  {
    title: 'rush production before signing off on specs.',
    why: 'A wrong thread type or countertop cutout causes costly delays once goods arrive on your job site.',
    instead: 'Always review and approve our spec sheet or 2D CAD drawing before we begin production.',
  },
  {
    title: 'ask for unrelated products on your first order.',
    why: 'For new buyers, we focus strictly on our core lines: bathroom vanities, ceramic basins, faucets, sinks, showers, LED mirrors, and bath hardware. This keeps your first shipment fast and error-free.',
    instead:
      'Start with our core kitchen and bath lines on your first order. Once we build a repeat partnership, our team can act as your sourcing agent in China to procure other building materials and hardware accessories for your containers.',
  },
  {
    title: 'assume every model carries every global certification.',
    why: 'Certifications vary by model and destination, and brand-specific certificates belong to registered license holders.',
    instead:
      'Tell us your compliance requirements (cUPC, NSF-61, CE, or SABER) up front. We will match pre-certified models or provide complete technical files to support certification under your own brand.',
  },
];

const faqs = [
  {
    question: 'Can I request a quote if my project is still in the early budget stage?',
    answer:
      'Yes. Share your project type (hotel, multifamily apartment, or affordable housing), estimated unit count, and budget tier (value-engineered or spec-grade). Our engineering team will recommend 2–3 proven product packages with ballpark container estimates.',
  },
  {
    question: 'Do I need separate orders for vanities, ceramic basins, faucets, and bath accessories?',
    answer:
      'No. As a multi-workshop supply chain integrator, we combine all categories under one Purchase Order (PO) and one commercial invoice. We match finishes across factories and load everything into one container.',
  },
  {
    question:
      'How do you make sure faucets and drains fit local plumbing in the US, Middle East, or Latin America?',
    answer:
      'Before production starts, we verify the exact connection standard for your destination port. Orders for the US and Mexico ship with 1/2" NPT threads, while orders for the Middle East, South America, and Europe ship with metric G1/2" (BSP) threads.',
  },
  {
    question: 'Why are exact prices hidden behind the Quote List instead of listed publicly?',
    answer:
      'We supply wholesale distributors and commercial builders exclusively. Unit costs depend on your order volume, base materials (such as solid brass vs. zinc alloy or waterproof PVC vs. plywood), finish process, and container mix. Submitting a Quote List protects your local channel pricing and ensures you receive accurate tiered factory quotes.',
  },
];

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
});
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={pageUrl} ogType="article">
  <script type="application/ld+json" set:html={faqJsonLd} />

  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-primary-600 via-primary-500 to-orange-500 dark:from-primary-700 dark:via-primary-600 dark:to-orange-600 text-white py-16 sm:py-20 overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-10 start-10 w-72 h-72 bg-white rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 end-10 w-96 h-96 bg-white rounded-full blur-3xl"></div>
    </div>

    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-sm sm:text-base font-semibold tracking-widest uppercase text-white/80 mb-4">
          B2B Sourcing Guide
        </p>
        <h1 class="text-4xl sm:text-5xl font-bold mb-6">
          How to Place an Order: Factory-Direct Sourcing &amp; FCL Consolidation Guide
        </h1>
        <p class="text-lg sm:text-xl font-semibold text-white/95 mb-4">
          Get accurate quotes faster, save time, and cut back-and-forth emails&mdash;then source
          vanities, ceramic basins, and faucets from specialized Chinese factories in one container
          to save up to 30% on ocean freight.
        </p>
        <p class="text-base sm:text-lg text-white/90 leading-relaxed max-w-3xl mx-auto mb-4">
          Not a broker. Not a single workshop. Your on-site engineering team in China.
        </p>
        <p class="text-base sm:text-lg text-white/90 leading-relaxed max-w-3xl mx-auto">
          We unite specialized workshops across China—covering bathroom vanities, glazed ceramic
          basins, solid brass faucets, and bath hardware—under one quality control system and one
          shipping container. Whether you have a full project floor plan or just a few target models,
          follow the steps below to get an itemized quote and container loading plan within
          <strong>24–72 business hours</strong>.
        </p>
      </div>
    </div>
  </section>

  <!-- Step 1: Buyer role routing -->
  <section class="py-16 sm:py-20 bg-white dark:bg-dark-900">
    <div class="container mx-auto px-4" data-ai-content data-ai-type="page">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            Step 1: Pick Your Buyer Role to Start Fast
          </h2>
          <div class="w-20 h-1 bg-gradient-to-r from-primary-600 to-orange-500 mx-auto rounded-full mb-6"></div>
          <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto leading-relaxed">
            Different buyers start with different project files. Find your business type below and
            share the 3 basic details listed to start your quote right away:
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {buyerRoles.map((role, index) => (
            <div class="bg-gray-50 dark:bg-dark-800 rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300 hover:-translate-y-1 flex flex-col">
              <div class="flex items-start gap-4 mb-4">
                <div class="w-10 h-10 shrink-0 bg-primary-600 text-white rounded-xl flex items-center justify-center font-bold">
                  {index + 1}
                </div>
                <h3 class="text-xl font-bold text-gray-900 dark:text-white leading-snug">
                  {role.title}
                </h3>
              </div>

              <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
                <strong class="text-gray-900 dark:text-white">Best for:</strong> {role.bestFor}
              </p>
              <p class="text-sm text-gray-600 dark:text-gray-400 mb-5">
                <strong class="text-gray-900 dark:text-white">Fastest way to start:</strong>
                {' '}{role.fastest}
              </p>

              <p class="font-semibold text-gray-900 dark:text-white mb-2">
                Please share these 3 details:
              </p>
              <ul class="space-y-2 mb-6">
                {role.details.map((detail) => (
                  <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-gray-400">
                    <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-primary-500"></span>
                    <span>{detail}</span>
                  </li>
                ))}
              </ul>

              <a
                href={localizeUrl(role.action.url)}
                class="mt-auto inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 font-semibold hover:underline"
              >
                {role.action.label} &rarr;
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Step 2: Six-step order process -->
  <section class="py-16 sm:py-20 bg-gray-50 dark:bg-dark-800">
    <div class="container mx-auto px-4" data-ai-content>
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            Step 2: How Your Order Moves from Quote to Your Port
          </h2>
          <div class="w-20 h-1 bg-gradient-to-r from-primary-600 to-orange-500 mx-auto rounded-full mb-6"></div>
          <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed">
            From spec check to container loading, our on-site engineering team manages every
            workshop step so your order arrives on time and free of surprises.
          </p>
        </div>

        <div class="space-y-4">
          {orderSteps.map((step, index) => (
            <div class="bg-white dark:bg-dark-900 rounded-2xl p-6 sm:p-8 shadow-lg flex gap-5">
              <div class="w-12 h-12 shrink-0 rounded-xl bg-gradient-to-br from-primary-600 to-orange-500 text-white flex items-center justify-center text-lg font-bold">
                {index + 1}
              </div>
              <div>
                <h3 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-white mb-2">
                  {step.title}
                </h3>
                {step.body && (
                  <p class="text-gray-600 dark:text-gray-400 leading-relaxed">{step.body}</p>
                )}
                {step.bullets && (
                  <ul class="space-y-2">
                    {step.bullets.map((bullet) => (
                      <li class="flex items-start gap-2 text-gray-600 dark:text-gray-400 leading-relaxed">
                        <span class="mt-2 w-1.5 h-1.5 shrink-0 rounded-full bg-primary-500"></span>
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Trade terms -->
  <section class="py-16 sm:py-20 bg-white dark:bg-dark-900">
    <div class="container mx-auto px-4" data-ai-content>
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            Standard Order Minimums &amp; Trade Terms
          </h2>
          <div class="w-20 h-1 bg-gradient-to-r from-primary-600 to-orange-500 mx-auto rounded-full mb-6"></div>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-gray-200 dark:border-dark-700 shadow-lg">
          <table class="w-full text-start">
            <thead class="bg-gray-100 dark:bg-dark-800">
              <tr>
                <th class="px-5 py-4 text-start text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wide">
                  Order Term
                </th>
                <th class="px-5 py-4 text-start text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wide">
                  Standard Policy
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-dark-700">
              {tradeTerms.map((row) => (
                <tr class="bg-white dark:bg-dark-900">
                  <td class="px-5 py-4 align-top text-sm font-semibold text-gray-900 dark:text-white w-1/3">
                    {row.term}
                  </td>
                  <td class="px-5 py-4 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                    {row.policy}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- Before you request a quote -->
  <section class="py-16 sm:py-20 bg-gray-50 dark:bg-dark-800">
    <div class="container mx-auto px-4" data-ai-content>
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            How to Get Your Quote Faster: 6 Common Mistakes to Avoid
          </h2>
          <div class="w-20 h-1 bg-gradient-to-r from-primary-600 to-orange-500 mx-auto rounded-full mb-6"></div>
          <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed">
            To save your team time and prevent inaccurate pricing, please avoid these 6 common
            mistakes when sending your inquiry.
          </p>
        </div>

        <div class="space-y-4">
          {avoidItems.map((item, index) => (
            <div class="bg-white dark:bg-dark-900 rounded-2xl p-6 sm:p-8 shadow-lg border-s-4 border-red-500">
              <div class="flex items-start gap-4">
                <span class="w-8 h-8 shrink-0 rounded-lg bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 flex items-center justify-center font-bold text-sm">
                  {index + 1}
                </span>
                <div>
                  <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">
                    Please do not {item.title}
                  </h3>
                  <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed mb-3">
                    {item.why}
                  </p>
                  <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
                    <strong class="text-primary-600 dark:text-primary-400">What to do instead:</strong>
                    {' '}{item.instead}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 sm:py-20 bg-white dark:bg-dark-900">
    <div class="container mx-auto px-4" data-ai-content>
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            Frequently Asked Questions About Ordering
          </h2>
          <div class="w-20 h-1 bg-gradient-to-r from-primary-600 to-orange-500 mx-auto rounded-full mb-6"></div>
        </div>

        <div class="space-y-4">
          {faqs.map((item) => (
            <div class="bg-gray-50 dark:bg-dark-800 rounded-xl p-6 shadow-sm">
              <h3 class="font-semibold text-gray-900 dark:text-white mb-2">{item.question}</h3>
              <p class="text-gray-600 dark:text-gray-400 leading-relaxed">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 sm:py-20 bg-gradient-to-br from-primary-700 via-primary-600 to-orange-500 dark:from-primary-800 dark:via-primary-700 dark:to-orange-600 text-white">
    <div class="container mx-auto px-4" data-ai-ignore>
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">Ready to Start Your Next Project Order?</h2>
        <p class="text-lg text-white/90 mb-8 leading-relaxed">
          Choose the easiest way to share your specs, and our engineering team in China will reply
          within 24–72 business hours.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={localizeUrl('/categories')}
            class="px-8 py-4 bg-white text-primary-600 rounded-xl font-semibold hover:bg-gray-100 transition-all duration-300 hover:scale-105 hover:shadow-2xl"
          >
            Add Products to My Quote List &rarr;
          </a>
          <a
            href={localizeUrl('/contact')}
            class="px-8 py-4 bg-white/10 backdrop-blur-sm border-2 border-white/30 text-white rounded-xl font-semibold hover:bg-white/20 transition-all duration-300 hover:scale-105"
          >
            Submit Project BOM / Request Quote
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>