  <script>
    const triggers = document.querySelectorAll('.faq-trigger');
    const categoryButtons = document.querySelectorAll('.category-filter');
    const faqCategories = document.querySelectorAll('.faq-category');
    const searchInput = document.getElementById('faq-search');
    const emptyState = document.getElementById('faq-empty');

    const inactiveClasses = ['bg-white', 'dark:bg-dark-900', 'text-gray-700', 'dark:text-gray-300', 'border', 'border-gray-200', 'dark:border-dark-700'];
    const activeClasses = ['bg-primary-600', 'text-white'];

    let activeCategory = 'all';

    function applyFilter() {
      const term = (searchInput.value || '').trim().toLowerCase();
      let totalVisible = 0;

      faqCategories.forEach(category => {
        const categoryMatch = activeCategory === 'all' || category.dataset.category === activeCategory;
        let visibleItems = 0;

        category.querySelectorAll('.faq-item').forEach(item => {
          const text = item.textContent.toLowerCase();
          const matchesTerm = !term || text.includes(term);
          const show = categoryMatch && matchesTerm;
          item.style.display = show ? '' : 'none';
          if (show) visibleItems++;
        });

        category.style.display = categoryMatch && visibleItems > 0 ? '' : 'none';
        totalVisible += visibleItems;
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', totalVisible > 0);
      }
    }

    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const content = trigger.nextElementSibling;
        const icon = trigger.querySelector('.faq-icon');

        content.classList.toggle('hidden');
        icon.classList.toggle('rotate-180');
      });
    });

    categoryButtons.forEach(button => {
      button.addEventListener('click', () => {
        activeCategory = button.dataset.category;

        categoryButtons.forEach(btn => {
          btn.classList.remove('active', ...activeClasses, ...inactiveClasses);
          if (btn === button) {
            btn.classList.add('active', ...activeClasses);
          } else {
            btn.classList.add(...inactiveClasses);
          }
        });

        applyFilter();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', applyFilter);
    }
  </script>
