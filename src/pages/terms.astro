---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Terms of Service - MrKB">
  <section class="py-16 bg-white dark:bg-gray-900">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">
          Terms of Service
        </h1>
        <p class="text-gray-500 dark:text-gray-400 mb-8">
          Last Updated: February 11, 2026
        </p>

        <div class="space-y-8 leading-relaxed text-gray-600 dark:text-gray-300">
          <p>
            Welcome to MrKB. These Terms of Service ("Terms") govern your access to and use of our
            website, products, and services. By accessing or using MrKB, you agree to be bound by
            these Terms. If you do not agree, please do not use our services.
          </p>

          <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Acceptance of Terms</h2>
            <p>
              You must be at least 18 years old to use our services, provide accurate and complete
              information, and keep your account secure. We may update these Terms at any time, and
              your continued use of the services constitutes acceptance of the changes.
            </p>
          </div>

          <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Account & Security</h2>
            <p>
              Create one account with accurate, current information and keep your password
              confidential. Notify us immediately of any unauthorized access. We may suspend or
              terminate accounts that violate these Terms or engage in fraudulent activity.
            </p>
          </div>

          <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Orders, Payment & Shipping</h2>
            <p>
              All orders are subject to acceptance and availability. Prices may change without
              notice. Payment is due at the time of ordering and processing is secure. Delivery
              times are estimates; title and risk of loss pass to you upon delivery to the carrier.
            </p>
          </div>

          <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Returns & Refunds</h2>
            <p>
              Most products can be returned within 30 days of delivery, unused and in original
              condition. Refunds are issued to the original payment method within 5-10 business days
              after we receive and inspect the returned item.
            </p>
          </div>

          <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Intellectual Property</h2>
            <p>
              All content on MrKB is the property of MrKB or its licensors. You may not copy,
              reproduce, or distribute it without our written permission.
            </p>
          </div>

          <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Limitation of Liability</h2>
            <p>
              Our services are provided "as is" and "as available". To the maximum extent permitted
              by law, MrKB is not liable for indirect or consequential damages, and our liability is
              limited to the amount paid for the product or service.
            </p>
          </div>

          <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Contact Us</h2>
            <p>
              If you have questions about these Terms, please contact us at
              <a href="mailto:info@mrkb.net" class="text-orange-600 dark:text-orange-400 hover:underline">
                info@mrkb.net
              </a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>