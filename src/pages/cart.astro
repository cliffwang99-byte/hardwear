---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Request a Quote - BuildMart">
  <div class="container mx-auto px-4 py-6 sm:py-8">
    <h1 class="text-2xl sm:text-3xl font-bold mb-2 sm:mb-3 animate-fade-in">Request a Quote</h1>
    <p class="text-sm sm:text-base text-gray-600 dark:text-gray-400 mb-6 sm:mb-8">
      Review the products below, fill in your contact details, and our sales team will get back to you with a tailored quotation.
    </p>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8">
      <!-- Quote Items - Mobile Optimized -->
      <div class="lg:col-span-2 space-y-3 sm:space-y-4">
        <div id="quote-items" class="space-y-4">
          <!-- Quote items will be rendered here by JavaScript -->
        </div>

        <div id="empty-quote" class="hidden bg-white dark:bg-dark-800 rounded-2xl p-8 sm:p-12 text-center border border-gray-200 dark:border-dark-700">
          <svg class="w-16 h-16 sm:w-24 sm:h-24 mx-auto mb-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <h2 class="text-xl sm:text-2xl font-bold mb-2">Your quote list is empty</h2>
          <p class="text-sm sm:text-base text-gray-600 dark:text-gray-400 mb-6">Add some products to get started!</p>
          <a href="/products" class="inline-block px-6 sm:px-8 py-2.5 sm:py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-xl font-semibold transition-colors text-sm sm:text-base active:scale-95">
            Continue Shopping
          </a>
        </div>
      </div>

      <!-- Contact Form - Mobile Optimized -->
      <div class="lg:col-span-1">
        <form id="quote-form" class="bg-white dark:bg-dark-800 rounded-2xl p-5 sm:p-6 border border-gray-200 dark:border-dark-700 lg:sticky lg:top-24 animate-slide-up">
          <h2 class="text-lg sm:text-xl font-bold mb-4 sm:mb-6">Your Contact Details</h2>

          <div class="space-y-3 sm:space-y-4 mb-4 sm:mb-6">
            <div>
              <label class="block text-xs sm:text-sm font-semibold mb-1.5" for="quote-name">Full Name *</label>
              <input
                id="quote-name"
                type="text"
                required
                placeholder="John Doe"
                class="w-full px-3 sm:px-4 py-2 rounded-lg border border-gray-200 dark:border-dark-700 bg-white dark:bg-dark-900 focus:outline-none focus:border-primary-500 text-sm"
              />
            </div>
            <div>
              <label class="block text-xs sm:text-sm font-semibold mb-1.5" for="quote-email">Email *</label>
              <input
                id="quote-email"
                type="email"
                required
                placeholder="you@company.com"
                class="w-full px-3 sm:px-4 py-2 rounded-lg border border-gray-200 dark:border-dark-700 bg-white dark:bg-dark-900 focus:outline-none focus:border-primary-500 text-sm"
              />
            </div>
            <div>
              <label class="block text-xs sm:text-sm font-semibold mb-1.5" for="quote-company">Company</label>
              <input
                id="quote-company"
                type="text"
                placeholder="ACME Corp"
                class="w-full px-3 sm:px-4 py-2 rounded-lg border border-gray-200 dark:border-dark-700 bg-white dark:bg-dark-900 focus:outline-none focus:border-primary-500 text-sm"
              />
            </div>
            <div>
              <label class="block text-xs sm:text-sm font-semibold mb-1.5" for="quote-phone">Phone</label>
              <input
                id="quote-phone"
                type="tel"
                placeholder="+1 555 000 0000"
                class="w-full px-3 sm:px-4 py-2 rounded-lg border border-gray-200 dark:border-dark-700 bg-white dark:bg-dark-900 focus:outline-none focus:border-primary-500 text-sm"
              />
            </div>
            <div>
              <label class="block text-xs sm:text-sm font-semibold mb-1.5" for="quote-message">Message</label>
              <textarea
                id="quote-message"
                rows="4"
                placeholder="Tell us about your project, quantities, delivery location, etc."
                class="w-full px-3 sm:px-4 py-2 rounded-lg border border-gray-200 dark:border-dark-700 bg-white dark:bg-dark-900 focus:outline-none focus:border-primary-500 text-sm resize-y"
              ></textarea>
            </div>
          </div>

          <div id="quote-error" class="hidden mb-4 px-4 py-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700 text-red-700 dark:text-red-300 rounded-xl text-sm">
          </div>

          <button
            id="submit-quote-btn"
            type="submit"
            class="w-full py-3 sm:py-4 bg-primary-600 hover:bg-primary-700 text-white rounded-xl font-bold transition-all duration-300 hover:shadow-lg transform hover:scale-105 active:scale-95 text-sm sm:text-base disabled:opacity-60 disabled:cursor-not-allowed"
          >
            Submit Quote Request
          </button>
          <a href="/products" class="block w-full py-2.5 sm:py-3 bg-gray-200 dark:bg-dark-700 hover:bg-gray-300 dark:hover:bg-dark-600 text-center rounded-xl font-semibold transition-colors text-sm sm:text-base active:scale-95 mt-2 sm:mt-3">
            Continue Shopping
          </a>
        </form>
      </div>
    </div>

    <!-- Success Modal -->
    <div id="quote-success" class="hidden fixed inset-0 z-[70] flex items-center justify-center p-4">
      <div class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
      <div class="relative bg-white dark:bg-dark-800 rounded-2xl p-8 sm:p-10 max-w-md w-full text-center border border-gray-200 dark:border-dark-700 shadow-2xl animate-scale-in">
        <div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto mb-4 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center">
          <svg class="w-8 h-8 sm:w-10 sm:h-10 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold mb-2">Quote Request Sent</h2>
        <p class="text-sm sm:text-base text-gray-600 dark:text-gray-400 mb-6">
          Thank you! Your quote request has been submitted. Our team will contact you shortly.
        </p>
        <a href="/products" class="inline-block w-full py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-xl font-bold transition-colors text-sm sm:text-base">
          Continue Shopping
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function renderQuoteItems() {
    const cart = JSON.parse(localStorage.getItem('cart') || '[]');
    const container = document.getElementById('quote-items');
    const emptyState = document.getElementById('empty-quote');
    const submitBtn = document.getElementById('submit-quote-btn') as HTMLButtonElement | null;

    if (cart.length === 0) {
      container!.classList.add('hidden');
      emptyState!.classList.remove('hidden');
      if (submitBtn) submitBtn.disabled = true;
      return;
    }

    container!.classList.remove('hidden');
    emptyState!.classList.add('hidden');
    if (submitBtn) submitBtn.disabled = false;

    container!.innerHTML = cart.map((item: any) => `
      <div class="bg-white dark:bg-dark-800 rounded-2xl p-6 border border-gray-200 dark:border-dark-700 animate-scale-in">
        <div class="flex gap-4 items-center">
          <img src="${item.image}" alt="${item.name}" class="w-20 h-20 sm:w-24 sm:h-24 object-cover rounded-lg" />
          <div class="flex-1 min-w-0">
            <h3 class="font-semibold text-sm sm:text-lg mb-1 truncate">${item.name}</h3>
            <div class="flex items-center justify-between mt-2">
              <div class="flex items-center gap-4">
                <div class="flex items-center gap-2 bg-gray-100 dark:bg-dark-700 rounded-lg">
                  <button data-decrease="${item.id}" class="px-3 py-1 hover:bg-gray-200 dark:hover:bg-dark-600 rounded-l-lg transition-colors">-</button>
                  <span class="px-3 font-semibold text-sm">${item.quantity}</span>
                  <button data-increase="${item.id}" class="px-3 py-1 hover:bg-gray-200 dark:hover:bg-dark-600 rounded-r-lg transition-colors">+</button>
                </div>
                <button data-remove="${item.id}" class="text-red-600 hover:text-red-700 text-sm font-semibold transition-colors">Remove</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    `).join('');

    document.querySelectorAll('[data-increase]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.increase!;
        const item = cart.find((i: any) => i.id === id);
        if (item) {
          item.quantity += 1;
          localStorage.setItem('cart', JSON.stringify(cart));
          renderQuoteItems();
        }
      });
    });

    document.querySelectorAll('[data-decrease]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.decrease!;
        const item = cart.find((i: any) => i.id === id);
        if (item && item.quantity > 1) {
          item.quantity -= 1;
          localStorage.setItem('cart', JSON.stringify(cart));
          renderQuoteItems();
        }
      });
    });

    document.querySelectorAll('[data-remove]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.remove!;
        const newCart = cart.filter((i: any) => i.id !== id);
        localStorage.setItem('cart', JSON.stringify(newCart));
        renderQuoteItems();

        const count = newCart.reduce((sum: number, item: any) => sum + item.quantity, 0);
        document.querySelectorAll('[data-cart-count]').forEach(el => {
          el.textContent = count.toString();
        });
      });
    });
  }

  function showError(message: string) {
    const err = document.getElementById('quote-error');
    if (!err) return;
    err.textContent = message;
    err.classList.remove('hidden');
  }

  const form = document.getElementById('quote-form');
  form!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = document.getElementById('quote-error');
    if (err) err.classList.add('hidden');

    const cart = JSON.parse(localStorage.getItem('cart') || '[]');
    if (cart.length === 0) {
      showError('Your quote list is empty. Add some products first.');
      return;
    }

    const name = (document.getElementById('quote-name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('quote-email') as HTMLInputElement).value.trim();
    const company = (document.getElementById('quote-company') as HTMLInputElement).value.trim();
    const phone = (document.getElementById('quote-phone') as HTMLInputElement).value.trim();
    const message = (document.getElementById('quote-message') as HTMLTextAreaElement).value.trim();

    const submitBtn = document.getElementById('submit-quote-btn') as HTMLButtonElement | null;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';
    }

    try {
      const res = await fetch('/api/inquiry/submit', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          name,
          email,
          company,
          phone,
          message,
          items: cart.map((item: any) => ({ id: item.id, name: item.name, quantity: item.quantity })),
        }),
      });

      const data = await res.json();

      if (!res.ok || !data.ok) {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Quote Request';
        }
        showError(data.message || 'Something went wrong. Please try again.');
        return;
      }

      // Clear the quote list and refresh cart counts
      localStorage.setItem('cart', '[]');
      document.querySelectorAll('[data-cart-count]').forEach(el => {
        el.textContent = '0';
      });
      renderQuoteItems();

      // Show success modal
      const modal = document.getElementById('quote-success');
      modal!.classList.remove('hidden');

      // Reset the form
      form!.reset();
    } catch {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Quote Request';
      }
      showError('Network error. Please check your connection and try again.');
    }
  });

  renderQuoteItems();

  // Close success modal on backdrop click
  const modal = document.getElementById('quote-success');
  modal!.addEventListener('click', (e) => {
    if (e.target === modal) modal!.classList.add('hidden');
  });
</script>