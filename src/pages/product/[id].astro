---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getSeoMeta, getSiteSettings } from 'emdash';
import { createPublicPageContext } from 'emdash/page';
import { PortableText } from 'emdash/ui';
import { getProductDetail, getProducts, getProductsBySeries, getSeries, getCategories } from '../../lib/shop';
import { localizePath } from '../../lib/i18n';
const currentLocale = Astro.currentLocale ?? 'en';
function localizeUrl(url: string): string {
  return localizePath(url, currentLocale);
}

const product = await getProductDetail(Astro.params.id ?? '');

const relatedProducts = (await getProducts())
  .filter((p) => p.id !== (Astro.params.id ?? ''))
  .slice(0, 4);

const [allSeries, allCategories, seriesProducts] = await Promise.all([
  getSeries(),
  getCategories(),
  product.series ? getProductsBySeries(product.series) : Promise.resolve([]),
]);

const currentSeries = allSeries.find((s) => s.slug === product.series);
const seriesName = currentSeries?.name ?? '';
const seriesDescription = currentSeries?.description ?? '';
const categoryLabelBySlug = new Map(allCategories.map((c) => [c.slug, c.name]));

const seriesSetProducts = seriesProducts.filter((p) => p.image);

const seriesGroups = (() => {
  const groups = new Map<string, ShopProduct[]>();
  for (const item of seriesSetProducts) {
    const key = item.category ?? '';
    if (!groups.has(key)) groups.set(key, []);
    (groups.get(key) as ShopProduct[]).push(item);
  }
  let running = 1;
  return [...groups.entries()].map(([slug, items]) => {
    const start = running;
    running += items.length;
    return {
      slug,
      name: slug ? (categoryLabelBySlug.get(slug) ?? slug.replace(/-/g, ' ')) : 'Other',
      items,
      start,
      end: start + items.length - 1,
    };
  });
})();

const seriesQuoteItems = seriesSetProducts.map((item) => ({
  id: item.id,
  name: item.name,
  price: item.price,
  image: item.image,
}));

const projectPricingPopover = {
  heading: 'About Project-Based Pricing',
  lead:
    'We do not offer a fixed, single-unit retail price because our supply chain operates exclusively on a B2B contract basis for multifamily, hospitality, and commercial building developments. Your unified package quotation is dynamically value-engineered based on:',
  bullets: [
    {
      label: 'Project Scale & Volume Brackets',
      text:
        'Customized contract tiered pricing mapped directly to your required multi-unit BOM (Bill of Materials).',
    },
    {
      label: 'Logistics & Delivery Channel',
      text:
        'Balanced options between US Local Warehouse Quick-Ship (LTL Truck Delivery) for immediate on-site deployment and China Factory-Direct Ocean Cargo (Mixed FCL Container) to maximize your margin.',
    },
    {
      label: 'Spatial Finishes Synchronization',
      text:
        'Bundling multiple specifications (e.g., matching kitchen & bath plumbing hardware color consistency) to trigger additional multi-category project discounts.',
    },
  ],
  footer:
    'Add your estimated portfolio list to the quote cart and submit your project ZIP Code. Our engineering desk will issue a formalized DDP/FOB contract quotation package within 12 business hours.',
};

const b2bCapabilities = [
  {
    title: 'Project-Based Pricing Available',
    detail:
      'Volume-tiered engineering pricing is available for project bids. Submit your bill of quantities to receive a formal quotation with consolidated freight terms.',
    popover: projectPricingPopover,
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
    tint: 'text-green-600 dark:text-green-400',
    bg: 'bg-green-50 dark:bg-green-900/20',
    accent: 'bg-green-600 hover:bg-green-700 ring-green-600/30',
  },
  {
    title: 'Private-Label & OEM Customization',
    detail:
      'We support proprietary brand registration. Unbranded technical CAD drawings, material spectroscopy reports (DZR Brass), and factory authorization deeds can be provided to accelerate your local IAPMO/CSA filing.',
    popover: {
      heading: 'About Private-Label & OEM Customization',
      lead:
        'We support proprietary brand registration for regional specifiers, importers, and mid-to-large wholesalers building their own local brand.',
      bullets: [
        {
          label: 'Brand Registration Support',
          text:
            'Unbranded technical CAD drawings, neutral product photography, and blind-ship packaging are released for your private-label program.',
        },
        {
          label: 'Material Documentation',
          text:
            'DZR brass and lead-free material spectroscopy reports are issued per production batch for your local compliance filing.',
        },
        {
          label: 'Factory Authorization',
          text:
            'Notarized factory authorization deeds and audit summaries accelerate your IAPMO/CSA certification applications.',
        },
      ],
      footer:
        'Request an NDA before sharing brand assets. Our OEM desk returns a full private-label feasibility pack within 12 business hours.',
    },
    icon: 'M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z',
    tint: 'text-blue-600 dark:text-blue-400',
    bg: 'bg-blue-50 dark:bg-blue-900/20',
    accent: 'bg-blue-600 hover:bg-blue-700 ring-blue-600/30',
  },
  {
    title: 'Custom Finishes & Colors',
    detail:
      'Support uniform surface finish synchronization (PVD Brushed Gold, Matte Black, etc.) across kitchen & bath collections to ensure 100% zero color variation in full-room specifications.',
    popover: {
      heading: 'About Custom Finishes & Colors',
      lead:
        'Surface finishes are synchronized across the entire kitchen & bath collection to guarantee 100% zero color variation in full-room specifications.',
      bullets: [
        {
          label: 'PVD Finish Range',
          text:
            'Brushed Gold, Champagne Bronze, Matte Black, Gunmetal, and custom RAL-matched PVD colors are available on request.',
        },
        {
          label: 'Cross-Category Synchronization',
          text:
            'Faucets, shower systems, accessories, and cabinet hardware are plated under the same bath protocol for a single matched batch.',
        },
        {
          label: 'Sample Approval',
          text:
            'Physical finish swatches and gloss-level certificates are shipped for sign-off before bulk production is released.',
        },
      ],
      footer:
        'Add your target finish codes to the quote cart and our finishing engineer will confirm plating feasibility and lead time.',
    },
    icon: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
    tint: 'text-purple-600 dark:text-purple-400',
    bg: 'bg-purple-50 dark:bg-purple-900/20',
    accent: 'bg-purple-600 hover:bg-purple-700 ring-purple-600/30',
  },
  {
    title: 'US Warehouse Quick-Ship',
    detail:
      'For urgent engineering contracts, ready-to-ship inventory is available directly via our US East/West Coast local logistics hubs for rapid LTL truck dispatch.',
    popover: {
      heading: 'About US Warehouse Quick-Ship',
      lead:
        'For urgent engineering contracts, ready-to-ship inventory is available directly through our US East and West Coast logistics hubs.',
      bullets: [
        {
          label: 'LTL Truck Dispatch',
          text:
            'Pallets are staged for next-day LTL pickup and delivered curbside or directly to the job site.',
        },
        {
          label: 'Split Allocation',
          text:
            'Inventory can be split across multiple job sites or phased construction schedules without extra handling fees.',
        },
        {
          label: 'Live Stock Visibility',
          text:
            'Available SKU quantities are confirmed by our logistics desk before you commit the purchase order.',
        },
      ],
      footer:
        'Submit your project ZIP Code with the quote request so transit time from the nearest hub can be calculated.',
    },
    icon: 'M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0zM13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0',
    tint: 'text-amber-600 dark:text-amber-400',
    bg: 'bg-amber-50 dark:bg-amber-900/20',
    accent: 'bg-amber-600 hover:bg-amber-700 ring-amber-600/30',
  },
  {
    title: 'Factory-Direct FCL Consolidation',
    detail:
      'Optimize your procurement margin through factory-direct ocean freight. We support full container load (FCL) mixed consolidation across plumbing fixtures and cabinet portfolios.',
    popover: {
      heading: 'About Factory-Direct FCL Consolidation',
      lead:
        'Procurement margin is optimized through factory-direct ocean freight instead of layered distributor markups.',
      bullets: [
        {
          label: 'Mixed FCL Consolidation',
          text:
            'Faucets, shower systems, sinks, and bathroom vanities can share a single container under one bill of lading.',
        },
        {
          label: 'Loading Optimization',
          text:
            'Carton nesting and pallet layout are engineered to maximize container utilization per cubic meter.',
        },
        {
          label: 'Terms Flexibility',
          text:
            'Both FOB and DDP contract terms are quoted, with destination port and inland delivery options included.',
        },
      ],
      footer:
        'Share your target container volume and destination port for a consolidated freight estimate.',
    },
    icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
    tint: 'text-indigo-600 dark:text-indigo-400',
    bg: 'bg-indigo-50 dark:bg-indigo-900/20',
    accent: 'bg-indigo-600 hover:bg-indigo-700 ring-indigo-600/30',
  },
  {
    title: '100% Pre-Shipment QA/QC Inspection',
    detail:
      'Every single batch undergoes rigorous 100% independent operational, sealing, and pressure inspection prior to clearing the container terminal.',
    popover: {
      heading: 'About 100% Pre-Shipment QA/QC Inspection',
      lead:
        'Every batch is inspected before it clears the container terminal, not after it arrives at your warehouse.',
      bullets: [
        {
          label: '100% Operational Check',
          text:
            'Cartridge rotation, handle travel, diverter function, and spray pattern are tested on every single unit.',
        },
        {
          label: 'Sealing & Pressure Test',
          text:
            'Static and dynamic pressure tests confirm leak-free performance at rated flow conditions.',
        },
        {
          label: 'Inspection Records',
          text:
            'Photo and video documentation plus signed inspection reports are attached to each shipment file.',
        },
      ],
      footer:
        'Third-party inspection (SGS, BV, Intertek) can be scheduled on request at the buyer\u2019s cost.',
    },
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
    tint: 'text-teal-600 dark:text-teal-400',
    bg: 'bg-teal-50 dark:bg-teal-900/20',
    accent: 'bg-teal-600 hover:bg-teal-700 ring-teal-600/30',
  },
  {
    title: 'BIM & CAD Spec Submittals',
    detail:
      'Architect-ready submittal packages, including detailed spec sheets, CAD files, and BIM models, are instantly exportable to streamline your project approval process.',
    popover: {
      heading: 'About BIM & CAD Spec Submittals',
      lead:
        'Architect-ready submittal packages are exportable on demand so your approval process never waits on documentation.',
      bullets: [
        {
          label: 'Submittal Package',
          text:
            'Detailed spec sheets, rough-in dimensions, flow rate data, and compliance declarations delivered as one PDF set.',
        },
        {
          label: 'CAD & BIM Files',
          text:
            'DWG drawings and Revit families are provided for coordination with mechanical and architectural trades.',
        },
        {
          label: 'Revision Control',
          text:
            'Files are version-stamped so your consultant team always works from the current release.',
        },
      ],
      footer:
        'Request the submittal package through the quote cart and specify your required Revit version.',
    },
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
    tint: 'text-slate-600 dark:text-slate-300',
    bg: 'bg-slate-100 dark:bg-slate-800',
    accent: 'bg-slate-600 hover:bg-slate-700 ring-slate-600/30',
  },
];

const siteSettings = await getSiteSettings();
const siteTitle = siteSettings.title || 'MrKB';
const titleSeparator = siteSettings.seo?.titleSeparator || ' | ';
const siteUrl = siteSettings.url || Astro.url.origin;

const seoMeta = getSeoMeta(
  {
    data: {
      seo: {
        title: product.seoTitle || null,
        description: product.seoDescription || null,
        image: product.seoImage || null,
        canonical: product.seoCanonical || null,
        noIndex: product.seoNoIndex,
      },
    },
  },
  {
    siteTitle,
    siteUrl,
    titleSeparator,
    path: Astro.url.pathname,
    defaultTitle: product.name,
    defaultDescription: product.description,
    defaultOgImage: product.images[0] || null,
  },
);

const pageContext = createPublicPageContext({
  Astro,
  kind: 'content',
  pageType: 'website',
  title: seoMeta.title,
  description: seoMeta.description,
  canonical: seoMeta.canonical,
  image: seoMeta.ogImage || product.images[0] || null,
  content: product.entryId ? { collection: 'products', id: product.entryId, slug: product.id } : undefined,
  seo: {
    ogTitle: seoMeta.ogTitle,
    ogDescription: seoMeta.ogDescription,
    ogImage: seoMeta.ogImage,
    robots: seoMeta.robots,
  },
  siteName: siteTitle,
  siteUrl,
  breadcrumbs: [
    { name: 'Home', url: localizeUrl('/') },
    { name: 'Products', url: localizeUrl('/products') },
    { name: product.category, url: localizeUrl(`/categories/${product.categorySlug}`) },
  ],
});
---

<BaseLayout title={pageContext.title ?? ''} page={pageContext}>
  <div class="container mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm mb-8 animate-fade-in">
      <a href={localizeUrl("/")} class="text-gray-600 dark:text-gray-400 hover:text-primary-600">Home</a>
      <span class="text-gray-400">/</span>
      <a href={localizeUrl("/products")} class="text-gray-600 dark:text-gray-400 hover:text-primary-600">Products</a>
      <span class="text-gray-400">/</span>
      <a href={localizeUrl(`/categories/${product.categorySlug}`)} class="text-gray-600 dark:text-gray-400 hover:text-primary-600">{product.category}</a>
    </nav>

    <!-- Product Details -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
      <!-- Images -->
      <div class="space-y-4 animate-slide-up">
        <div class="relative aspect-square rounded-2xl overflow-hidden bg-gray-100 dark:bg-dark-800 border border-gray-200 dark:border-dark-700">
          <img id="main-image" src={product.images[0]} alt={product.name} class="w-full h-full object-cover" />
          <button
            id="gallery-prev"
            type="button"
            aria-label="Previous image"
            class="absolute start-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/80 dark:bg-dark-800/80 hover:bg-primary-600 hover:text-white text-gray-800 dark:text-gray-200 shadow-lg flex items-center justify-center transition-colors z-10"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" /></svg>
          </button>
          <button
            id="gallery-next"
            type="button"
            aria-label="Next image"
            class="absolute end-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/80 dark:bg-dark-800/80 hover:bg-primary-600 hover:text-white text-gray-800 dark:text-gray-200 shadow-lg flex items-center justify-center transition-colors z-10"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
        <div class="grid grid-cols-4 gap-4">
          {product.images.map((img, i) => (
            <button
              data-image={img}
              class={`aspect-square rounded-lg overflow-hidden border-2 ${i === 0 ? 'border-primary-600' : 'border-gray-200 dark:border-dark-700'} hover:border-primary-600 transition-colors`}
            >
              <img src={img} alt={`${product.name} ${i + 1}`} class="w-full h-full object-cover" />
            </button>
          ))}
        </div>
      </div>

      <!-- Info -->
      <div class="animate-slide-up" style="animation-delay: 0.1s;">
        <div class="mb-4">
          <span class="inline-block px-3 py-1 bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 rounded-full text-sm font-semibold">
            {product.category}
          </span>
        </div>

        <h1 class="text-4xl font-bold mb-4">{product.name}</h1>

        <!-- Rating -->
        <div class="flex items-center gap-4 mb-6">
          <div class="flex items-center gap-1">
            {Array.from({ length: 5 }).map((_, i) => (
              <svg
                class={`w-5 h-5 ${i < Math.floor(product.rating) ? 'text-yellow-400' : 'text-gray-300 dark:text-dark-600'}`}
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <span class="text-gray-600 dark:text-gray-400">{product.rating}</span>
        </div>

        <!-- Price -->
        <div class="flex items-center gap-4 mb-6">
          <span class="inline-flex items-baseline gap-1.5 text-4xl font-bold text-primary-600 dark:text-primary-400">
            <span>$</span>
            <span class="text-2xl tracking-tight">??</span>
          </span>
          {product.originalPrice && (
            <>
              <span class="inline-flex items-baseline gap-1.5 text-2xl text-gray-500 dark:text-gray-400 line-through">
                <span>$</span>
                <span class="text-lg tracking-tight">??</span>
              </span>
              <span class="px-3 py-1 bg-red-600 text-white rounded-full text-sm font-bold">
                Save {Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100)}%
              </span>
            </>
          )}
        </div>

        <!-- B2B Availability Matrix -->
        <div class="mb-6">
          <h2 class="text-sm font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">
            Available Services
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            {b2bCapabilities.map((capability, index) => (
              <div
                tabindex="0"
                data-b2b-card={index}
                class="group relative flex items-center gap-2.5 px-3 py-2.5 rounded-xl border border-gray-200 dark:border-dark-700 bg-white dark:bg-dark-800 hover:border-primary-400 dark:hover:border-primary-600 focus:outline-none focus:ring-2 focus:ring-primary-500/40 transition-colors md:cursor-default cursor-pointer"
              >
                <span class={`flex-shrink-0 w-8 h-8 rounded-lg ${capability.bg} ${capability.tint} flex items-center justify-center`}>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={capability.icon} />
                  </svg>
                </span>
                <span class="flex-1 text-sm font-semibold text-gray-800 dark:text-gray-200 leading-snug">{capability.title}</span>

                <button
                  type="button"
                  data-b2b-info={index}
                  aria-label={`Details about ${capability.title}`}
                  aria-haspopup="dialog"
                  class="flex-shrink-0 w-6 h-6 rounded-full border-2 border-gray-400 dark:border-dark-500 bg-transparent text-gray-600 dark:text-gray-300 hover:border-gray-600 dark:hover:border-dark-300 hover:text-gray-800 dark:hover:text-white flex items-center justify-center transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500/50"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8h.01M12 12v4" />
                  </svg>
                </button>

                <div
                  class={`pointer-events-none absolute top-full mt-2 w-80 max-w-[85vw] hidden md:block invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-opacity duration-200 z-20 bg-dark-950 text-white rounded-xl p-4 shadow-2xl text-start ${index % 2 === 1 ? 'sm:start-auto sm:end-0' : 'start-0'}`}
                >
                  <p class="text-sm font-bold mb-2">{capability.popover.heading}</p>
                  <p class="text-xs leading-relaxed text-gray-300 mb-2">{capability.popover.lead}</p>
                  <ul class="space-y-1.5 mb-2">
                    {capability.popover.bullets.map((bullet) => (
                      <li class="text-xs leading-relaxed text-gray-300 flex gap-1.5">
                        <span class="text-primary-400 flex-shrink-0">•</span>
                        <span>
                          <span class="font-semibold text-white">{bullet.label}:</span> {bullet.text}
                        </span>
                      </li>
                    ))}
                  </ul>
                  <p class="text-xs leading-relaxed text-gray-300 pt-2 border-t border-white/10">{capability.popover.footer}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Features -->
        {product.featuresRich && (
          <div class="mb-6 bg-gray-50 dark:bg-dark-800 border border-gray-200 dark:border-dark-700 rounded-2xl p-6">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">Key Features</h3>
            <div class="richtext">
              <PortableText value={product.featuresRich as any} />
            </div>
          </div>
        )}

        <!-- Quantity & Actions -->
        <div class="flex flex-wrap gap-4 mb-8">
          <div class="flex items-center gap-2 bg-gray-100 dark:bg-dark-800 rounded-xl p-2">
            <button id="decrease-qty" class="px-4 py-2 hover:bg-gray-200 dark:hover:bg-dark-700 rounded-lg transition-colors">-</button>
            <span id="quantity" class="px-6 font-bold text-lg">1</span>
            <button id="increase-qty" class="px-4 py-2 hover:bg-gray-200 dark:hover:bg-dark-700 rounded-lg transition-colors">+</button>
          </div>
          <button
            id="add-to-cart-btn"
            class="flex-1 py-4 bg-primary-600 hover:bg-primary-700 text-white rounded-xl font-bold transition-all duration-300 hover:shadow-lg transform hover:scale-105"
          >
            Add to Quote List
          </button>
          <button
            id="wishlist-btn"
            class="p-4 border-2 border-gray-200 dark:border-dark-700 hover:border-primary-600 dark:hover:border-primary-600 rounded-xl transition-all duration-300"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </button>
        </div>

        <!-- Product Info -->
        <div class="space-y-4 border-t border-gray-200 dark:border-dark-700 pt-6">
          <div class="flex items-center gap-3">
            <span class="text-gray-600 dark:text-gray-400">SKU:</span>
            <span class="font-semibold">{product.sku}</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-gray-600 dark:text-gray-400">Brand:</span>
            <span class="font-semibold">{product.brand}</span>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-gray-600 dark:text-gray-400">Category:</span>
            <a href={localizeUrl(`/categories/${product.categorySlug}`)} class="font-semibold text-primary-600 dark:text-primary-400 hover:underline">{product.category}</a>
          </div>
          {product.topics.length > 0 && (
            <div class="flex items-start gap-3">
              <span class="text-gray-600 dark:text-gray-400 flex-shrink-0">Topic:</span>
              <div class="flex flex-wrap gap-x-2 gap-y-1">
                {product.topics.map((topic, i) => (
                  <>
                    {i > 0 && <span class="text-gray-400">/</span>}
                    <a href={localizeUrl(`/topics/${topic.slug}`)} class="font-semibold text-primary-600 dark:text-primary-400 hover:underline">{topic.name}</a>
                  </>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Matched Set: same-series products -->
    {seriesSetProducts.length > 1 && product.series && (
      <section class="mb-16 animate-on-scroll">
        <div class="rounded-2xl border border-gray-300 dark:border-dark-700 bg-[#F8F6EC] dark:bg-dark-800 p-6 sm:p-8">
          <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6 lg:gap-10">
            <div class="max-w-2xl">
              <p class="flex items-center gap-2 mb-3 text-[11px] uppercase tracking-[0.2em] text-gray-500 dark:text-gray-400">
                <span class="w-6 h-px bg-gray-400 dark:bg-dark-500"></span>
                Matched Set · One Design
              </p>
              <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-gray-900 dark:text-white">
                {seriesName || 'This Series'}
              </h2>
              {seriesDescription && (
                <p class="mt-3 text-sm sm:text-base text-gray-600 dark:text-gray-400 leading-relaxed">
                  {seriesDescription}
                </p>
              )}
            </div>

            <div class="w-full lg:w-64 flex-shrink-0 border border-gray-300 dark:border-dark-600 rounded-lg p-4">
              <div class="flex items-baseline gap-3">
                <span class="text-4xl font-semibold tabular-nums text-gray-900 dark:text-white">
                  {String(seriesSetProducts.length).padStart(2, '0')}
                </span>
                <span class="text-[10px] uppercase tracking-[0.15em] leading-tight text-gray-500 dark:text-gray-400">
                  Pieces<br />One set
                </span>
              </div>
              <div class="mt-3 pt-3 space-y-1.5 border-t border-dashed border-gray-300 dark:border-dark-600">
                {seriesGroups.map((group) => (
                  <div class="flex items-center gap-2 text-[11px] uppercase tracking-[0.12em] text-gray-500 dark:text-gray-400">
                    <span class="truncate">{group.name}</span>
                    <span class="flex-1 border-b border-dotted border-gray-300 dark:border-dark-600"></span>
                    <span class="tabular-nums">
                      {String(group.start).padStart(2, '0')}
                      {group.end > group.start ? `-${String(group.end).padStart(2, '0')}` : ''}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div class="mt-8 space-y-8">
            {seriesGroups.map((group) => (
              <div>
                <div class="flex items-center gap-2 mb-4">
                  <span class="text-[10px] uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400 whitespace-nowrap">
                    {group.name}
                  </span>
                  <span class="flex-1 h-px bg-gray-300 dark:bg-dark-600"></span>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
                  {group.items.map((item, itemIndex) => {
                    const isCurrent = item.id === product.id;
                    const position = group.start + itemIndex;
                    return (
                      <a href={localizeUrl(`/product/${item.id}`)} class="group block">
                        <div class={`relative ${isCurrent ? 'border-2 border-gray-900 dark:border-white' : 'border border-transparent'}`}>
                          {isCurrent && (
                            <span class="absolute start-0 top-0 z-10 bg-gray-900 dark:bg-white text-white dark:text-gray-900 text-[9px] font-semibold uppercase tracking-[0.15em] px-2 py-1">
                              This piece
                            </span>
                          )}
                          <div class="aspect-square flex items-center justify-center p-3 sm:p-4">
                            <img
                              src={item.image}
                              alt={item.name}
                              class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
                              loading="lazy"
                            />
                          </div>
                        </div>

                        <div class="mt-3 flex items-start gap-2">
                          <span class={`mt-1.5 w-2 h-2 rounded-full flex-shrink-0 ${isCurrent ? 'bg-[#C08A6E]' : 'bg-gray-300 dark:bg-dark-600'}`}></span>
                          <div class="min-w-0">
                            <p class="text-[10px] uppercase tracking-[0.15em] text-gray-500 dark:text-gray-400 truncate">
                              {String(position).padStart(2, '0')} {item.sku}
                            </p>
                            <p class="text-sm font-medium text-gray-900 dark:text-white truncate group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                              {item.name}
                            </p>
                          </div>
                        </div>
                      </a>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>

          <div class="mt-8">
            <button
              type="button"
              data-series-quote
              data-series-products={JSON.stringify(seriesQuoteItems)}
              class="w-full flex items-center justify-between gap-4 bg-gray-950 dark:bg-black hover:bg-gray-900 dark:hover:bg-dark-900 text-white rounded-lg px-5 py-4 transition-colors group/quote"
            >
              <span class="flex items-center gap-3 min-w-0 text-start">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span class="min-w-0">
                  <span class="block text-sm sm:text-base font-semibold">Get one quote for the complete set</span>
                  <span data-series-quote-label class="block text-[11px] sm:text-xs text-gray-400 truncate">
                    All {seriesSetProducts.length} pieces · one enquiry covers the whole set
                  </span>
                </span>
              </span>
              <svg class="w-5 h-5 flex-shrink-0 group-hover/quote:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14m-6-6l6 6-6 6" />
              </svg>
            </button>

            <div class="mt-4">
              <a
                href={localizeUrl(`/series/${product.series}`)}
                class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-gray-900 dark:text-white underline decoration-gray-400 dark:decoration-dark-500 underline-offset-4 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
              >
                View the full {seriesName || 'series'} set
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Tabs -->
    <div class="mb-16 animate-on-scroll">
      <div class="border-b border-gray-200 dark:border-dark-700 mb-6">
        <div class="flex gap-8">
          <button class="tab-btn active pb-4 border-b-2 border-primary-600 font-semibold" data-tab="description">Description</button>
          <button class="tab-btn pb-4 border-b-2 border-transparent hover:border-gray-300 dark:hover:border-dark-600 font-semibold transition-colors" data-tab="specifications">Specifications</button>
        </div>
      </div>

      <div id="description" class="tab-content">
        <div class="bg-white dark:bg-dark-800 rounded-2xl p-8 border border-gray-200 dark:border-dark-700">
          <h3 class="text-2xl font-bold mb-4">Product Description</h3>
          {product.descriptionRich ? (
            <div class="richtext">
              <PortableText value={product.descriptionRich as any} />
            </div>
          ) : (
            <>
              <p class="text-gray-600 dark:text-gray-400 mb-6 text-lg">{product.description}</p>
              <ul class="space-y-3">
                {product.features.map(feature => (
                  <li class="flex items-start gap-3">
                    <svg class="w-6 h-6 text-primary-600 dark:text-primary-400 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span class="text-gray-600 dark:text-gray-400">{feature}</span>
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>
      </div>

      <div id="specifications" class="tab-content hidden">
        <div class="bg-white dark:bg-dark-800 rounded-2xl p-8 border border-gray-200 dark:border-dark-700">
          <h3 class="text-2xl font-bold mb-6">Technical Specifications</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {Object.entries(product.specifications).map(([key, value]) => (
              <div class="flex justify-between p-4 bg-gray-50 dark:bg-dark-900 rounded-lg">
                <span class="font-semibold">{key}:</span>
                <span class="text-gray-600 dark:text-gray-400">{value}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Related Products -->
    <section class="animate-on-scroll">
      <h2 class="text-3xl font-bold mb-8">Related Products</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {relatedProducts.map(p => (
          <ProductCard {...p} />
        ))}
      </div>
    </section>
  </div>

  <!-- Mobile Bottom Sheet: Available Services details -->
  <div id="b2b-sheet-overlay" class="fixed inset-0 bg-black/50 z-40 hidden md:hidden opacity-0 transition-opacity duration-300"></div>
  <div
    id="b2b-sheet"
    class="fixed bottom-0 start-0 end-0 z-50 md:hidden translate-y-full transition-transform duration-300 ease-out bg-white dark:bg-dark-900 rounded-t-2xl shadow-2xl max-h-[80vh] overflow-y-auto"
    role="dialog"
    aria-modal="true"
    aria-labelledby="b2b-sheet-heading"
    aria-hidden="true"
  >
    <div class="sticky top-0 bg-white dark:bg-dark-900 pt-3 pb-2 px-5 border-b border-gray-200 dark:border-dark-700">
      <div class="w-10 h-1 bg-gray-300 dark:bg-dark-600 rounded-full mx-auto mb-3"></div>
      <div class="flex items-start justify-between gap-4">
        <div class="flex items-start gap-3 min-w-0">
          <span id="b2b-sheet-icon" class="flex-shrink-0 w-9 h-9 rounded-lg bg-gray-100 dark:bg-dark-800 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path id="b2b-sheet-icon-path" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="" />
            </svg>
          </span>
          <h3 id="b2b-sheet-heading" class="text-base font-bold text-gray-900 dark:text-white leading-snug"></h3>
        </div>
        <button
          id="b2b-sheet-close"
          type="button"
          aria-label="Close details"
          class="flex-shrink-0 w-9 h-9 rounded-full bg-gray-100 dark:bg-dark-800 hover:bg-gray-200 dark:hover:bg-dark-700 flex items-center justify-center text-gray-600 dark:text-gray-300 transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
    <div class="px-5 py-4">
      <p id="b2b-sheet-lead" class="text-sm leading-relaxed text-gray-600 dark:text-gray-400 mb-3"></p>
      <ul id="b2b-sheet-bullets" class="space-y-2 mb-3"></ul>
      <p id="b2b-sheet-footer" class="text-sm leading-relaxed text-gray-600 dark:text-gray-400 pt-3 border-t border-gray-200 dark:border-dark-700"></p>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ product, b2bCapabilities }}>
  // Image gallery - pure JS (thumbnails + prev/next arrows)
  var galleryImages = product.images || [];
  var currentIndex = 0;

  function setGalleryIndex(index) {
    if (!galleryImages.length) return;
    var len = galleryImages.length;
    // wrap around
    currentIndex = ((index % len) + len) % len;
    var main = document.getElementById('main-image');
    if (main) main.setAttribute('src', galleryImages[currentIndex]);
    var thumbs = document.querySelectorAll('[data-image]');
    for (var t = 0; t < thumbs.length; t++) {
      thumbs[t].classList.remove('border-primary-600');
      if (thumbs[t].getAttribute('data-image') === galleryImages[currentIndex]) {
        thumbs[t].classList.add('border-primary-600');
      }
    }
  }

  // Thumbnail click (event delegation)
  document.addEventListener('click', function (e) {
    var n = e.target;
    while (n && n.nodeType === 1) {
      if (n.hasAttribute && n.hasAttribute('data-image')) {
        var src = n.getAttribute('data-image');
        for (var i = 0; i < galleryImages.length; i++) {
          if (galleryImages[i] === src) { setGalleryIndex(i); break; }
        }
        return;
      }
      n = n.parentNode;
    }
  });

  // Prev / Next arrows
  var prevBtn = document.getElementById('gallery-prev');
  if (prevBtn) prevBtn.addEventListener('click', function () { setGalleryIndex(currentIndex - 1); });
  var nextBtn = document.getElementById('gallery-next');
  if (nextBtn) nextBtn.addEventListener('click', function () { setGalleryIndex(currentIndex + 1); });

  // Quantity
  var quantity = 1;
  var incBtn = document.getElementById('increase-qty');
  if (incBtn) incBtn.addEventListener('click', function () {
    quantity++;
    var q = document.getElementById('quantity');
    if (q) q.textContent = quantity.toString();
  });
  var decBtn = document.getElementById('decrease-qty');
  if (decBtn) decBtn.addEventListener('click', function () {
    if (quantity > 1) {
      quantity--;
      var q = document.getElementById('quantity');
      if (q) q.textContent = quantity.toString();
    }
  });

  // Add to cart
  var cartBtn = document.getElementById('add-to-cart-btn');
  if (cartBtn) cartBtn.addEventListener('click', function () {
    var cart = [];
    try { cart = JSON.parse(localStorage.getItem('cart') || '[]'); } catch (err) { cart = []; }
    var existing = null;
    for (var i = 0; i < cart.length; i++) {
      if (cart[i].id === product.id) { existing = cart[i]; break; }
    }
    if (existing) {
      existing.quantity += quantity;
    } else {
      cart.push({ id: product.id, name: product.name, price: product.price, image: product.images[0], quantity: quantity });
    }
    try { localStorage.setItem('cart', JSON.stringify(cart)); } catch (err) {}
    var count = 0;
    for (var j = 0; j < cart.length; j++) count += cart[j].quantity;
    var cc = document.querySelectorAll('[data-cart-count]');
    for (var k = 0; k < cc.length; k++) cc[k].textContent = count.toString();
    if (cartBtn) cartBtn.textContent = 'Added to Quote List!';
    setTimeout(function () { if (cartBtn) cartBtn.textContent = 'Add to Quote List'; }, 2000);
  });

  // Wishlist
  var wishBtn = document.getElementById('wishlist-btn');
  if (wishBtn) wishBtn.addEventListener('click', function () {
    var wishlist = [];
    try { wishlist = JSON.parse(localStorage.getItem('wishlist') || '[]'); } catch (err) { wishlist = []; }
    var idx = wishlist.indexOf(product.id);
    if (idx > -1) { wishlist.splice(idx, 1); } else { wishlist.push(product.id); }
    try { localStorage.setItem('wishlist', JSON.stringify(wishlist)); } catch (err) {}
    var wc = document.querySelectorAll('[data-wishlist-count]');
    for (var w = 0; w < wc.length; w++) wc[w].textContent = wishlist.length.toString();
  });

  // Tabs
  var tabBtns = document.querySelectorAll('.tab-btn');
  for (var t = 0; t < tabBtns.length; t++) {
    tabBtns[t].addEventListener('click', function () {
      var tab = this.getAttribute('data-tab');
      for (var a = 0; a < tabBtns.length; a++) {
        tabBtns[a].classList.remove('active', 'border-primary-600');
        tabBtns[a].classList.add('border-transparent');
      }
      this.classList.add('active', 'border-primary-600');
      this.classList.remove('border-transparent');
      var contents = document.querySelectorAll('.tab-content');
      for (var c = 0; c < contents.length; c++) contents[c].classList.add('hidden');
      var target = document.getElementById(tab);
      if (target) target.classList.remove('hidden');
    });
  }

  // B2B detail bottom sheet (mobile)
  var sheet = document.getElementById('b2b-sheet');
  var sheetOverlay = document.getElementById('b2b-sheet-overlay');
  var sheetHeading = document.getElementById('b2b-sheet-heading');
  var sheetLead = document.getElementById('b2b-sheet-lead');
  var sheetBullets = document.getElementById('b2b-sheet-bullets');
  var sheetFooter = document.getElementById('b2b-sheet-footer');
  var sheetClose = document.getElementById('b2b-sheet-close');
  var sheetIcon = document.getElementById('b2b-sheet-icon');
  var sheetIconPath = document.getElementById('b2b-sheet-icon-path');

  function openB2BSheet(index) {
    var capability = b2bCapabilities[index];
    if (!capability || !capability.popover || !sheet || !sheetOverlay) return;
    var popover = capability.popover;

    sheetHeading.textContent = popover.heading;
    if (sheetIcon) sheetIcon.className = 'flex-shrink-0 w-9 h-9 rounded-lg ' + capability.bg + ' ' + capability.tint + ' flex items-center justify-center';
    if (sheetIconPath) sheetIconPath.setAttribute('d', capability.icon);

    sheetLead.textContent = popover.lead;
    sheetBullets.innerHTML = '';
    for (var b = 0; b < popover.bullets.length; b++) {
      var bullet = popover.bullets[b];
      var li = document.createElement('li');
      li.className = 'text-sm leading-relaxed text-gray-600 dark:text-gray-400 flex gap-2';
      var dot = document.createElement('span');
      dot.className = 'text-primary-600 dark:text-primary-400 flex-shrink-0';
      dot.textContent = '\u2022';
      var body = document.createElement('span');
      var label = document.createElement('span');
      label.className = 'font-semibold text-gray-900 dark:text-white';
      label.textContent = bullet.label + ': ';
      body.appendChild(label);
      body.appendChild(document.createTextNode(bullet.text));
      li.appendChild(dot);
      li.appendChild(body);
      sheetBullets.appendChild(li);
    }
    sheetFooter.textContent = popover.footer;
    sheetOverlay.classList.remove('hidden');
    sheet.setAttribute('aria-hidden', 'false');
    sheet.scrollTop = 0;
    document.body.classList.add('overflow-hidden');
    requestAnimationFrame(function () {
      sheetOverlay.classList.remove('opacity-0');
      sheet.classList.remove('translate-y-full');
    });
  }

  function closeB2BSheet() {
    if (!sheet || !sheetOverlay) return;
    sheetOverlay.classList.add('opacity-0');
    sheet.classList.add('translate-y-full');
    sheet.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('overflow-hidden');
    setTimeout(function () { sheetOverlay.classList.add('hidden'); }, 300);
  }

  if (sheetClose) sheetClose.addEventListener('click', closeB2BSheet);
  if (sheetOverlay) sheetOverlay.addEventListener('click', closeB2BSheet);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeB2BSheet();
  });

  var infoButtons = document.querySelectorAll('[data-b2b-info]');
  for (var ib = 0; ib < infoButtons.length; ib++) {
    infoButtons[ib].addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      var idx = parseInt(this.getAttribute('data-b2b-info'), 10);
      if (window.matchMedia('(max-width: 767px)').matches) openB2BSheet(idx);
    });
  }

  var b2bCards = document.querySelectorAll('[data-b2b-card]');
  for (var bc = 0; bc < b2bCards.length; bc++) {
    b2bCards[bc].addEventListener('click', function (e) {
      if (e.target.closest('[data-b2b-info]')) return;
      var idx = parseInt(this.getAttribute('data-b2b-card'), 10);
      if (window.matchMedia('(max-width: 767px)').matches) openB2BSheet(idx);
    });
    b2bCards[bc].addEventListener('keydown', function (e) {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      e.preventDefault();
      var idx = parseInt(this.getAttribute('data-b2b-card'), 10);
      if (window.matchMedia('(max-width: 767px)').matches) openB2BSheet(idx);
    });
  }

  // Add the whole matched set to the quote list
  var seriesQuoteBtn = document.querySelector('[data-series-quote]');
  if (seriesQuoteBtn) {
    seriesQuoteBtn.addEventListener('click', function () {
      var raw = seriesQuoteBtn.getAttribute('data-series-products');
      if (!raw) return;
      var items = [];
      try { items = JSON.parse(raw); } catch (err) { return; }
      if (!items.length) return;

      var cart = [];
      try { cart = JSON.parse(localStorage.getItem('cart') || '[]'); } catch (err) { cart = []; }
      if (!Array.isArray(cart)) cart = [];

      for (var si = 0; si < items.length; si++) {
        var item = items[si];
        var found = false;
        for (var ci = 0; ci < cart.length; ci++) {
          if (cart[ci].id === item.id) { found = true; break; }
        }
        if (!found) cart.push({ id: item.id, name: item.name, price: item.price, image: item.image, quantity: 1 });
      }

      try { localStorage.setItem('cart', JSON.stringify(cart)); } catch (err) { return; }

      var count = 0;
      for (var cc = 0; cc < cart.length; cc++) count += Number(cart[cc].quantity) || 0;
      var counters = document.querySelectorAll('[data-cart-count]');
      for (var ci2 = 0; ci2 < counters.length; ci2++) counters[ci2].textContent = count.toString();

      var label = seriesQuoteBtn.querySelector('[data-series-quote-label]');
      if (label) {
        var original = label.getAttribute('data-original-text') || label.textContent;
        label.setAttribute('data-original-text', original);
        label.textContent = 'Added ' + items.length + ' pieces to your quote list';
        seriesQuoteBtn.classList.add('!bg-green-700');
        setTimeout(function () {
          label.textContent = original;
          seriesQuoteBtn.classList.remove('!bg-green-700');
        }, 2000);
      }
    });
  }
</script>