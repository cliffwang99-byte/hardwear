      },
    ],
    lines: 'خلاطات مطابخ · أعمدة دش · اكسسوارات حمام',
    action: 'أضف حزمة مواصفات الاتحاد الأوروبي/المملكة المتحدة إلى قائمة عرض السعر',
  },
  {
    id: 'latin-america',
    title: 'أمريكا اللاتينية (المكسيك وأمريكا الجنوبية)',
    short: 'أمريكا اللاتينية',
    badge: 'قيمة درجة المقاول · خيط مزدوج (NPT + BSP) · جاهز للتدفق بالجاذبية',
    pitch: 'تجهيزات بتحكم في التكلفة مبنية لضغط مياه منخفض ودوران جملة سريع.',
    specs: [
      {
        label: 'خيوط مزدوجة المعايير',
        text: 'خطوط NPT 1/2 بوصة + 3/8 بوصة للمكسيك؛ خيوط مترية BSP G1/2" لتشيلي وكولومبيا وبيرو والأرجنتين.',
      },
      {
        label: 'ضغط منخفض ومضاد للرواسب',
        text: 'هندسة لخزانات الجاذبية على الأسطح (Flujo por Gravedad) مع مهويات قابلة للإزالة بدون أدوات تزيل الرمال بسرعة.',
      },
      {
        label: 'التحكم في تكلفة الوحدة',
        text: 'خيارات سبائك زنك متينة وفولاذ مقاوم للصدأ مضغوط معبأة للتحميل عالي الحجم في الحاويات.',
      },
    ],
    lines: 'خلاطات زنك وفولاذ · مغاسل مطابخ مضغوطة · أرفف تخزين قابلة للطي',
    action: 'أضف حزمة مواصفات أمريكا اللاتينية إلى قائمة عرض السعر',
  },
];

const solutionBlocks = [
  {
    id: 'multifamily',
    title: 'التطورات متعددة الوحدات والشقق',
    short: 'متعدد الوحدات',
    risk: 'الأجزاء المفقودة توقف فرق السباكة عبر أكثر من 200 وحدة، بينما تتطلب الميزانيات المحدودة هندسة قيمة ذكية.',
    points: [
      {
        label: 'تجهيزات معبأة لكل وحدة',
        text: 'نعبأ الخلاطات وصمامات الزاوية والمصارف ومنظمات الخزانة حسب وحدة الشقة بحيث لا تهدر الفرق ساعات في فرز الصناديق.',
      },
      {
        label: 'هندسة القيمة',
        text: 'امزج مغاسل فولاذ مضغوط قياس 18 في الوحدات القياسية مع مغاسل مصنوعة يدويًا قياس 16 في وحدات البنتهاوس، كل ذلك في حاوية واحدة.',
      },
    ],
    bundle:
      'خلاط مطبخ بتدفق سفلي بمقبض واحد + مغسلة فولاذ أسفل السطح + مجموعة دش متوازنة الضغط + منظم خزانة قابل للسحب.',
    action: 'أضف حزمة متعدد الوحدات إلى قائمة عرض السعر',
    guide: '',
  },
  {
    id: 'ada-compliance',
    title: 'مشاريع متوافقة مع ADA (ANSI A117.1)',
    short: 'الامتثال ADA',
    risk: 'الأحواض العميقة أو المقابض القاسية أو عناصر التحكم في الدش في غير مكانها تفشل في فحوصات إمكانية الوصول البلدية وتفرض إزالة مكلفة.',
    points: [
      {
        label: 'أحواض ADA ضحلة',
        text: 'مغاسل مطبخ وحمام من الفولاذ المقاوم للصدأ بعمق حوض حتى 5.5 بوصات ومصارف مزاحة للخلف لمساحة كاملة لركبتي الكرسي المتحرك.',
      },
      {
        label: 'عناصر تحكم برافعة منخفضة القوة',
