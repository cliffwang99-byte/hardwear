      },
      {
        label: 'صناديق تثبيت سريعة التركيب',
        text: 'صمامات دش مخفية نحاسية بميزان فقاعات مدمج تقلل عمالة سباكة التجديد حتى 40%.',
      },
      {
        label: 'مرايا LED مضادة للتكسر',
        text: 'مرايا بفضة خالية من النحاس وغشاء أمان CAT II ومشغلات LED IP44 قابلة للاستبدال.',
      },
    ],
    bundle:
