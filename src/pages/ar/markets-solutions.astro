    action: 'أضف حزمة الضيافة إلى قائمة عرض السعر',
    guide: '',
  },
  {
    id: 'cabinet-storage',
    title: 'ترقية جملة تخزين خزائن المطبخ',
    short: 'تخزين الخزائن',
    risk: 'خزائن المطبخ القياسية بالجملة تُشحن كصناديق خشبية فارغة بدون أي تنظيم داخلي.',
    points: [
      {
        label: 'تركيز معدني فقط',
        text: 'لا نبيع خزائن خشبية، بل نوفر أرفف توابل قابلة للسحب عالية التحمل ومنظمات زوايا عمياء وأنظمة جدارية سوداء غير لامعة.',
      },
      {
        label: 'مضاعف الهامش',
        text: 'ضاعف هامش إعادة بيع الخزائن بدون أي تعرض جمركي لخزائن الخشب.',
