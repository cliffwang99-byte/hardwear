    action: 'أضف حزمة تخزين الخزائن إلى قائمة عرض السعر',
    guide: '/solutions/wholesale-kitchen-cabinets-storage/',
  },
];

const faqs = [
  {
    question: 'هل يمكنني مزج منتجات من مواصفات إقليمية أو حزم مشاريع مختلفة في حاوية واحدة؟',
    answer:
      'نعم. نوحّد الخلاطات ومغاسل الفولاذ المقاوم للصدأ وصمامات الدش المخفية ومنظمات الخزائن والمغاسل المعدنية في حاوية واحدة 20 قدمًا أو 40HQ من قوانغتشو أو شنتشن، مع وضع علامات واضحة على الكراتين حسب مرحلة المشروع أو نوع الغرفة.',
  },
  {
    question: 'هل توفرون خزائن مطابخ خشبية أو أسطح حجرية؟',
    answer:
      'لا. نركز حصريًا على التجهيزات المعدنية وتركيبات السباكة ومنظمات التخزين. إذا كنت تشتري صناديق الخزائن أو ألواح الحجر بشكل منفصل، نوفر لك السلال القابلة للسحب المطابقة والمغاسل أسفل السطح مع قوالب قص 1:1 والخلاطات المطابقة للألوان.',
  },
  {
    question: 'كيف تمنعون اختلافات الألوان عبر الخلاطات ومجموعات تشطيب الدش وتجهيزات الخزائن؟',
    answer:
      'نطبق معيار ألوان رقمي موحد (دلتا E أقل من 1.5) عبر ورش التشطيب الشريكة. قطعك بالأسود غير اللامع وPVD الذهب المصقول والداكن متطابقة باستمرار في كل غرفة.',
  },
  {
    question: 'كيف نطلب أسعار الحجم المتدرجة ورسومات CAD غير الموسومة؟',
    answer:
      'انقر فوق إضافة إلى قائمة عرض سعر المشروع على أي حزمة أو صفحة منتج، ثم أرسل ميناء الوجهة أو الرمز البريدي لمشروعك. يرسل فريق الهندسة لدينا أسعارًا مفصلة FOB/CIF وحسابات تحميل الحاوية CBM وأوراق مواصفات غير موسومة خلال 24 ساعة.',
  },
];

const pageContext = createPublicPageContext({
  Astro,
  kind: 'custom',
  pageType: 'website',
  title: `${pageName}${titleSeparator}توريد تجاري للمطبخ والحمام`,
  description: pageDescription,
  canonical: pageUrl,
  siteName: siteTitle,
  siteUrl,
  breadcrumbs: [
    { name: 'الرئيسية', url: localizeUrl('/') },
    { name: pageName, url: Astro.url.pathname },
  ],
});

const breadcrumbJsonLd = safeJsonLdSerialize({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${pageUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: `${siteBaseUrl}${localizeUrl('/')}` },
    { '@type': 'ListItem', position: 2, name: pageName, item: pageUrl },
  ],
});

const collectionJsonLd = safeJsonLdSerialize({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': pageUrl,
  name: pageHeading,
  description: pageDescription,
  url: pageUrl,
  isPartOf: { '@id': siteBaseUrl },
  breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
  about: [
    { '@type': 'Thing', name: 'تجهيزات المطبخ' },
    { '@type': 'Thing', name: 'تجهيزات الحمام' },
  ],
  hasPart: {
    '@type': 'WebPageElement',
    name: 'الأسواق والحلول',
    cssSelector: '#solutions',
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: solutionBlocks.length,
    itemListElement: solutionBlocks.map((block, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: block.title,
      url: `${siteBaseUrl}${localizeUrl(`/markets-solutions#${block.id}`)}`,
    })),
  },
});

const faqJsonLd = safeJsonLdSerialize({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
});
---

<BaseLayout title={pageContext.title ?? ''} page={pageContext}>
  <script type="application/ld+json" set:html={breadcrumbJsonLd}></script>
  <script type="application/ld+json" set:html={collectionJsonLd}></script>
  <script type="application/ld+json" set:html={faqJsonLd}></script>
  <style is:global>
    html { scroll-behavior: smooth; }
    :root { --site-header-h: 76px; }
    [id] { scroll-margin-top: calc(var(--site-header-h) + 74px); }
    #markets-solutions-subnav { top: var(--site-header-h); }
    @keyframes anchor-flash {
      0% { box-shadow: 0 0 0 0 rgba(249, 115, 22, 0.8); }
      100% { box-shadow: 0 0 0 14px rgba(249, 115, 22, 0); }
    }
    .anchor-flash { animation: anchor-flash 2s ease-out; }
  </style>

  <section class="relative overflow-hidden text-white">
    <div class="absolute inset-0 bg-gradient-to-br from-dark-950 via-primary-950 to-dark-950"></div>
    <div class="absolute inset-0 opacity-[0.04]">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="markets-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
            <path d="M 100 0 L 0 0 0 100" fill="none" stroke="white" stroke-width="0.5"/>
            <circle cx="0" cy="0" r="2" fill="white"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#markets-pattern)"/>
      </svg>
    </div>

    <div class="container mx-auto px-4 py-16 md:py-24 relative z-10">
      <div class="max-w-4xl">
        <nav class="flex items-center gap-2 text-sm mb-6">
