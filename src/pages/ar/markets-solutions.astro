      },
    ],
    bundle:
      'صمام دش ثرموستاتي مضاد للحرق + خلاط حوض بمقبض شفرة + مصرف أرضي خطي + قضبان إمساك أمان 304.',
    action: 'أضف حزمة رعاية كبار السن إلى قائمة عرض السعر',
    guide: '',
  },
  {
    id: 'hospitality-motels',
    title: 'الضيافة والفنادق والموتيلات',
    short: 'الضيافة والموتيلات',
    risk: 'دوران النزلاء العالي يسبب خراطيش تسريب ومغاسل خشبية منتفخة وقضبان مناشف فضفاضة.',
    points: [
      {
        label: 'مغاسل معدنية مقاومة للرطوبة',
