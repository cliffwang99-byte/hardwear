  },
  {
    id: 'australia-nz',
    title: 'أستراليا ونيوزيلندا',
    short: 'أستراليا ونيوزيلندا',
    badge: 'WaterMark · تصنيف المياه WELS · SAA / RCM',
    pitch: 'هندسة وفق أكواد السباكة الأسترالية الصارمة وتصاميم حديثة مدمجة.',
