---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteSettings } from 'emdash';
import { createPublicPageContext, safeJsonLdSerialize } from 'emdash/page';
import { localizePath } from '../../lib/i18n';

const currentLocale = Astro.currentLocale ?? 'en';
function localizeUrl(url: string): string {
  return localizePath(url, currentLocale);
}

const pageName = 'الأسواق والحلول';
const pageHeading = 'الأسواق العالمية وحلول التجهيزات التجارية';
const pageDescription =
  'تجهيزات مطابخ وحمامات بمستوى المواصفات حسب المنطقة (cUPC وWaterMark وSASO وCE) ونوع المشروع (متعدد الوحدات وADA ومساكن كبار السن وموتيلات). اطلب عروض أسعار بالجملة.';

const siteSettings = await getSiteSettings();
const siteTitle = siteSettings.title || 'MrKB';
const titleSeparator = siteSettings.seo?.titleSeparator || ' | ';
const siteUrl = siteSettings.url || Astro.url.origin;
const siteBaseUrl = siteUrl.replace(/\/+$/, '');
const pageUrl = `${siteBaseUrl}${Astro.url.pathname}`;

const marketBlocks = [
  {
    id: 'north-america',
    title: 'أمريكا الشمالية (الولايات المتحدة وكندا)',
    short: 'أمريكا الشمالية',
    badge: 'cUPC · NSF-61 خالٍ من الرصاص · ADA · UL 962 / ETL',
    pitch: 'مصمم لاجتياز فحوصات السباكة البلدية في أمريكا الشمالية دون تأخير.',
    specs: [
      {
        label: 'التوصيلات',
        text: 'مداخل NPT 1/2 بوصة وخطوط إمداد ضغط 3/8 بوصة جاهزة للتوصيلات الداخلية الأمريكية/الكندية.',
      },
      {
