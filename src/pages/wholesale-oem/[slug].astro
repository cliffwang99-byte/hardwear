---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getSeoMeta, getSiteSettings } from 'emdash';
import { createPublicPageContext } from 'emdash/page';
import { PortableText } from 'emdash/ui';
import {
  getLandingPageData,
  getProducts,
  getProductsByCategory,
  faqBlocksToItems,
} from '../../lib/shop';

const { slug } = Astro.params;
const landingSlug = slug ?? '';

// ---- CMS content (opt-in). Falls back to the registry below when absent. ----
const landingMeta = await getLandingPageData(landingSlug);

// ---- Frontend fallback registry: slug -> hero/description/category ----
const registry: Record<string, any> = {
  faucets: {
    name: 'Wholesale Faucets',
    description:
      'Factory-direct wholesale faucets for contractors, specifiers, and distributors. OEM/private-label, mixed FCL consolidation, US warehouse quick-ship, and full compliance support.',
    banner: 'https://images.unsplash.com/photo-1584622650111-993a426fbf0a?w=1200&h=400&fit=crop',
    category: 'faucets',
  },
  shower: {
    name: 'Wholesale Shower Systems',
    description:
      'Wholesale shower heads, valves, and complete systems for multifamily and hospitality projects. Factory-direct pricing and flexible fulfillment options.',
    banner: 'https://images.unsplash.com/photo-1507652313519-d4e9174996dd?w=1200&h=400&fit=crop',
    category: 'showers',
  },
  bathtub: {
    name: 'Wholesale Bathtubs',
    description:
      'Wholesale bathtubs and tub/shower combos for commercial and residential developments. Bulk pricing available on every order.',
    banner: 'https://images.unsplash.com/photo-1584622781564-1d987f7333c1?w=1200&h=400&fit=crop',
    category: 'bathtubs',
  },
  'cabinet-hardware': {
    name: 'Wholesale Cabinet Hardware',
    description:
      'Wholesale cabinet knobs, pulls, and hinges in matched finishes. Zero color-variation coordination across full-room specifications.',
    banner: 'https://images.unsplash.com/photo-1556911220-bff31c812dba?w=1200&h=400&fit=crop',
    category: 'cabinet-hardware',
  },
};

const fallback =
  registry[landingSlug] ||
  ({
    name: 'Wholesale Supply',
    description:
      'Factory-direct wholesale building and plumbing hardware for contractors, specifiers, and distributors worldwide.',
    banner: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=1200&h=400&fit=crop',
    category: '',
  } as any);

const pageName = landingMeta?.customizationH1 || landingMeta?.name || fallback.name;
const pageDescription =
  landingMeta?.termDescription || landingMeta?.seoDescription || fallback.description;
const pageBanner = landingMeta?.banner || fallback.banner;

// ---- Products (real CMS products; optionally filtered by CMS `categories`) ----
const allProducts = await getProducts();
const categorySlugs =
  landingMeta && landingMeta.categories.length > 0
    ? landingMeta.categories
    : fallback.category
      ? [fallback.category]
      : [];
let featuredProducts: typeof allProducts = [];
if (categorySlugs.length > 0) {
  for (const cat of categorySlugs) {
    const matched = await getProductsByCategory(cat).catch(() => [] as typeof allProducts);
    for (const p of matched) {
      if (!featuredProducts.some((f) => f.id === p.id)) featuredProducts.push(p);
    }
    if (featuredProducts.length >= 8) break;
  }
}
const products = featuredProducts.length > 0 ? featuredProducts.slice(0, 8) : allProducts.slice(0, 8);

// ---- Longtext SEO blocks + FAQ (from CMS, when present) ----
const longtextBlocks = landingMeta?.longDescriptionBlocks ?? [];
const faqBlocks = landingMeta?.faqBlocks ?? [];
const faqItems = faqBlocksToItems(faqBlocks);
const hasFaq = faqItems.length > 0;

// ---- B2B availability services (mirrors the product detail page matrix) ----
const b2bCapabilities = [
  { title: 'Project-Based Pricing Available', tone: 'text-emerald-600 dark:text-emerald-400' },
  { title: 'Private-Label & OEM Customization Available', tone: 'text-blue-600 dark:text-blue-400' },
  { title: 'Custom Finishes & Colors Available', tone: 'text-violet-600 dark:text-violet-400' },
  { title: 'US Warehouse Quick-Ship Available', tone: 'text-amber-600 dark:text-amber-400' },
  { title: 'Factory-Direct FCL Consolidation Available', tone: 'text-indigo-600 dark:text-indigo-400' },
  { title: '100% Pre-Shipment QA/QC Inspection Available', tone: 'text-cyan-600 dark:text-cyan-400' },
  { title: 'BIM & CAD Spec Submittals Available', tone: 'text-slate-600 dark:text-slate-400' },
];

// ---- SEO ----
const siteSettings = await getSiteSettings();
const siteTitle = siteSettings.title || 'Kitchen & Bath Hardware';
const titleSeparator = siteSettings.seo?.titleSeparator || ' | ';
const siteUrl = siteSettings.url || Astro.url.origin;

const seoMeta = getSeoMeta(
  {
    data: {
      seo: {
        title: landingMeta?.seoTitle || null,
        description: landingMeta?.seoDescription || null,
        image: landingMeta?.seoImage || null,
        canonical: landingMeta?.seoCanonical || null,
        noIndex: landingMeta?.seoNoIndex ?? false,
      },
    },
  },
  {
    siteTitle,
    siteUrl,
    titleSeparator,
    path: Astro.url.pathname,
    defaultTitle: pageName,
    defaultDescription: pageDescription,
    defaultOgImage: pageBanner,
  },
);

const pageContext = createPublicPageContext({
  Astro,
  kind: 'content',
  pageType: 'website',
  title: seoMeta.title,
  description: seoMeta.description,
  canonical: seoMeta.canonical,
  image: seoMeta.ogImage || pageBanner,
  content: landingMeta?.entryId
    ? { collection: landingMeta.collection, id: landingMeta.entryId, slug: landingSlug }
    : undefined,
  seo: {
    ogTitle: seoMeta.ogTitle,
    ogDescription: seoMeta.ogDescription,
    ogImage: seoMeta.ogImage,
    robots: seoMeta.robots,
  },
  siteName: siteTitle,
  siteUrl,
  breadcrumbs: [
    { name: 'Home', url: '/' },
    { name: 'Wholesale & OEM', url: '/wholesale-oem/faucets' },
    { name: pageName, url: Astro.url.pathname },
  ],
});
---

<BaseLayout title={pageContext.title ?? ''} page={pageContext}>
  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-dark-950 via-primary-950 to-dark-950 text-white overflow-hidden">
    <div class="absolute inset-0">
      <img src={pageBanner} alt={pageName} class="w-full h-full object-cover opacity-20" />
      <div class="absolute inset-0 bg-gradient-to-r from-dark-950/90 via-dark-950/70 to-dark-950/90"></div>
    </div>

    <div class="container mx-auto px-4 py-16 md:py-20 relative z-10">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm mb-6 animate-fade-in">
        <a href="/" class="text-primary-300 hover:text-white transition-colors duration-300">Home</a>
        <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <a href="/wholesale-oem/faucets" class="text-primary-300 hover:text-white transition-colors duration-300">Wholesale & OEM</a>
        <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-white font-medium">{pageName}</span>
      </nav>

      <!-- Header -->
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-black mb-4 animate-fade-in">{pageName}</h1>
        <p class="text-xl text-primary-200 leading-relaxed mb-8 animate-fade-in" style="animation-delay: 0.1s;">
          {pageDescription}
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/cart"
            class="px-8 py-4 bg-primary-600 hover:bg-primary-700 text-white rounded-xl font-bold transition-all duration-300 hover:scale-105 hover:shadow-2xl"
          >
            Request a Quote
          </a>
          <a
            href="#products"
            class="px-8 py-4 bg-white/10 backdrop-blur-sm border-2 border-white/30 text-white rounded-xl font-bold hover:bg-white/20 transition-all duration-300 hover:scale-105"
          >
            Browse Products
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- B2B Availability Matrix -->
  <section class="py-12 bg-gray-50 dark:bg-dark-800 border-b border-gray-200 dark:border-dark-700">
    <div class="container mx-auto px-4">
      <div class="flex flex-wrap gap-3 justify-center lg:justify-start">
        {b2bCapabilities.map((c) => (
          <span
            class="inline-flex items-center gap-2 px-4 py-2 bg-white dark:bg-dark-900 rounded-xl border border-gray-200 dark:border-dark-700 text-sm font-semibold"
          >
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class={c.tone}>{c.title}</span>
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Products -->
  <section id="products" class="py-16 sm:py-20">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">Wholesale Faucets & Hardware</h2>
        <div class="w-20 h-1 bg-gradient-to-r from-primary-600 to-orange-500 mx-auto rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {products.map((p) => (
          <ProductCard {...p} />
        ))}
      </div>
    </div>
  </section>

  <!-- Longtext SEO Blocks (from CMS) -->
  {longtextBlocks.length > 0 && (
    <section class="py-16 sm:py-20 bg-gray-50 dark:bg-dark-800 border-t border-gray-200 dark:border-dark-700">
      <div class="container mx-auto px-4 max-w-4xl">
        <div class="bg-white dark:bg-dark-900 rounded-2xl p-8 border border-gray-200 dark:border-dark-700">
          <div class="richtext">
            <PortableText value={longtextBlocks as any} />
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  {hasFaq && (
    <section class="py-16 sm:py-20">
      <div class="container mx-auto px-4 max-w-3xl">
        <h2 class="text-3xl sm:text-4xl font-bold text-center text-gray-900 dark:text-white mb-10">
          Wholesale FAQs
        </h2>
        <div class="space-y-4">
          {faqItems.map((item) => (
            <details class="group bg-white dark:bg-dark-800 rounded-xl border border-gray-200 dark:border-dark-700 overflow-hidden">
              <summary class="flex items-center justify-between gap-4 cursor-pointer p-5 font-semibold text-gray-900 dark:text-white list-none">
                {item.question}
                <svg class="w-5 h-5 text-primary-600 flex-shrink-0 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-5 pb-5 text-gray-600 dark:text-gray-400 richtext">
                <PortableText value={item.answerBlocks as any} />
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Bottom CTA -->
  <section class="py-16 sm:py-20 bg-gradient-to-br from-dark-950 via-primary-950 to-dark-950 text-white text-center">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">Wholesale Pricing On Your Terms</h2>
      <p class="text-xl text-primary-200 mb-8 max-w-2xl mx-auto">
        Build your bulk quote list today — we'll respond with a formalized DDP/FOB contract quotation within 12 business hours.
      </p>
      <a
        href="/cart"
        class="inline-block px-10 py-4 bg-primary-600 hover:bg-primary-700 text-white rounded-xl font-bold transition-all duration-300 hover:scale-105 hover:shadow-2xl"
      >
        Request a Quote
      </a>
    </div>
  </section>
</BaseLayout>