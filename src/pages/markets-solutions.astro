---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteSettings } from 'emdash';
import { createPublicPageContext, safeJsonLdSerialize } from 'emdash/page';
import { localizePath } from '../lib/i18n';

const currentLocale = Astro.currentLocale ?? 'en';
function localizeUrl(url: string): string {
  return localizePath(url, currentLocale);
}

const pageName = 'Markets & Solutions';
const pageHeading = 'Global Markets & Commercial Hardware Solutions';
const pageDescription =
  'Spec-grade kitchen and bath hardware by region (cUPC, WaterMark, SASO, CE) and project type (Multifamily, ADA, Senior Living, Motels). Request bulk quotes.';

const siteSettings = await getSiteSettings();
const siteTitle = siteSettings.title || 'MrKB';
const titleSeparator = siteSettings.seo?.titleSeparator || ' | ';
const siteUrl = siteSettings.url || Astro.url.origin;
const siteBaseUrl = siteUrl.replace(/\/+$/, '');
const pageUrl = `${siteBaseUrl}${Astro.url.pathname}`;

const marketBlocks = [
  {
    id: 'north-america',
    title: 'North America (USA & Canada)',
    short: 'North America',
    badge: 'cUPC · NSF-61 Lead-Free · ADA · UL 962 / ETL',
    pitch: 'Built to pass North American municipal plumbing inspections without delays.',
    specs: [
      {
        label: 'Connections',
        text: '1/2" NPT inlets and 3/8" Compression supply lines ready for US/Canadian rough-ins.',
      },
      {
        label: 'Submittal Support',
        text: 'Unbranded 2D CAD line drawings and spec sheets provided for contractor bids.',
      },
      {
        label: 'Tariff-Safe Vanities',
        text: 'SUS 304 stainless steel and honeycomb aluminum vanities eliminate wooden-cabinet AD/CVD duties.',
      },
    ],
    lines: 'Kitchen Sinks · Concealed Shower Systems · Metal Vanities & LED Mirrors',
    action: 'Add North America Spec Pack to Quote List',
  },
  {
    id: 'australia-nz',
    title: 'Australia & New Zealand',
    short: 'Australia & NZ',
    badge: 'WaterMark · WELS Water Rating · SAA / RCM',
    pitch: 'Engineered for strict Australian plumbing codes and compact modern layouts.',
    specs: [
      {
        label: 'Connections',
        text: 'Standard G1/2" (BSP) metric threads and compliant flexible hoses.',
      },
      {
        label: 'Compact Metric Sizing',
        text: 'Wall-hung metal vanities (600mm–1000mm) and slim-frame LED mirrors (220V–240V / 50Hz).',
      },
      {
        label: 'Water Efficiency',
        text: 'WELS-compliant aerators and thermostatic shower mixers built for residential and hotel towers.',
      },
    ],
    lines: 'Basin & Vanity Faucets · Shower Systems · Vanities & LED Mirrors',
    action: 'Add ANZ Spec Pack to Quote List',
  },
  {
    id: 'middle-east',
    title: 'Middle East (Saudi Arabia & UAE)',
    short: 'Middle East',
    badge: 'SASO / SABER · 48h–72h Acid Salt Spray · 1.6 MPa Tested',
    pitch: 'Heavy-duty solid brass and SUS 304 hardware built for high heat, high pressure, and coastal humidity.',
    specs: [
      {
        label: 'Water-Saving Mandate',
        text: 'Swiss Neoperl aerators capped at ≤ 5.7 LPM (1.5 GPM) to pass Saudi Vision 2030 and UAE green building rules.',
      },
      {
        label: 'High-Pressure Protection',
        text: 'Anti-water hammer ceramic cartridges tested up to 1.6 MPa (16 bar) for high-rise booster pumps.',
      },
      {
        label: 'UV-Stable Finishes',
        text: 'PVD Brushed Gold and Gunmetal finishes resist desert heat and coastal salt corrosion (G1/2" BSP threads).',
      },
    ],
    lines: 'Solid Brass Faucets · Thermostatic Showers · 304 Floor Drains',
    action: 'Add Middle East Spec Pack to Quote List',
  },
  {
    id: 'europe-uk',
    title: 'Europe & United Kingdom',
    short: 'Europe & UK',
    badge: 'CE (EN-817) · UKCA · RoHS · IP44 Electrical',
    pitch: 'Clean European metric sizing with lead-free compliance and moisture-sealed LED mirrors.',
    specs: [
      {
        label: 'Connections',
        text: 'G1/2" and G3/8" BSP braided supply hoses matched to European angle valves.',
      },
      {
        label: 'Electrical Safety',
        text: '220V–240V / 50Hz LED mirrors and mirror cabinets with copper-free silver glass and safety backing film.',
      },
      {
        label: 'Color Consistency',
        text: 'Digital Delta E < 1.5 color matching across matte black faucets, shower columns, and towel bars.',
      },
    ],
    lines: 'Kitchen Faucets · Shower Columns · Bathroom Accessories',
    action: 'Add EU/UK Spec Pack to Quote List',
  },
  {
    id: 'latin-america',
    title: 'Latin America (Mexico & South America)',
    short: 'Latin America',
    badge: 'Builder-Grade Value · Dual-Thread (NPT + BSP) · Gravity-Flow Ready',
    pitch: 'Cost-controlled hardware built for low water pressure and fast wholesale turnover.',
    specs: [
      {
        label: 'Dual-Standard Threads',
        text: '1/2" NPT + 3/8" lines for Mexico; G1/2" BSP metric threads for Chile, Colombia, Peru, and Argentina.',
      },
      {
        label: 'Low-Pressure & Anti-Sediment',
        text: 'Engineered for rooftop gravity tanks (Flujo por Gravedad) with tool-free removable aerators that clear sand fast.',
      },
      {
        label: 'Unit-Cost Control',
        text: 'Durable zinc alloy and pressed stainless steel options packed for high-volume container loading.',
      },
    ],
    lines: 'Zinc & SS Faucets · Pressed Kitchen Sinks · Flat-Pack Storage Racks',
    action: 'Add LatAm Spec Pack to Quote List',
  },
];

const solutionBlocks = [
  {
    id: 'multifamily',
    title: 'Multifamily & Apartment Developments',
    short: 'Multifamily',
    risk: 'Missing parts stall plumbing crews across 200+ units, while tight budgets require smart value engineering.',
    points: [
      {
        label: 'Unit-Packed Kitting',
        text: 'We pack faucets, angle valves, drains, and cabinet organizers by apartment unit so crews never waste hours sorting boxes.',
      },
      {
        label: 'Value Engineering',
        text: 'Mix 18-gauge pressed stainless sinks in standard units with 16-gauge handmade sinks in penthouse units—all in one container.',
      },
    ],
    bundle:
      'Single-Handle Pull-Down Kitchen Faucet + Undermount SS Sink + Pressure-Balance Shower Kit + Pull-Out Cabinet Organizer.',
    action: 'Add Multifamily Package to Quote List',
    guide: '',
  },
  {
    id: 'ada-compliance',
    title: 'ADA Compliant Projects (ANSI A117.1)',
    short: 'ADA Compliance',
    risk: 'Deep sink bowls, stiff faucet handles, or misplaced shower controls fail municipal accessibility inspections and force costly tear-outs.',
    points: [
      {
        label: 'Shallow-Bowl ADA Sinks',
        text: 'Stainless steel kitchen and vanity sinks with ≤ 5.5" bowl depth and rear-offset drains for full wheelchair knee clearance.',
      },
      {
        label: 'Low-Force Lever Controls',
        text: 'Single-lever faucets and diverters requiring less than 5 lbs of operating force without tight grasping or wrist twisting.',
      },
      {
        label: 'ADA Shower & Grab Bars',
        text: 'Slide-bar handheld showers (38"–48" reach range) paired with heavy-duty SUS 304 wall grab bars.',
      },
    ],
    bundle:
      '5.5" Deep ADA Kitchen Sink + Lever Kitchen Faucet + ADA Slide-Bar Shower System + 304 Grab Bar Set.',
    action: 'Add ADA Package to Quote List',
    guide: '',
  },
  {
    id: 'senior-living',
    title: 'Senior Living & Healthcare Facilities',
    short: 'Senior Living',
    risk: 'Sudden water temperature spikes scald residents, while weak grip strength makes standard knobs hard to turn.',
    points: [
      {
        label: 'Anti-Scald Thermostatic Valves',
        text: '38°C (100°F) thermostatic valves lock safe water temperature instantly even when adjacent rooms flush toilets.',
      },
      {
        label: 'Extended Medical/Blade Handles',
        text: 'Long ergonomic lever handles allow effortless wrist or elbow operation.',
      },
      {
        label: 'Slip & Fall Prevention',
        text: 'High-load SUS 304 grab bars and flush linear tile-insert floor drains that eliminate shower curb trip hazards.',
      },
    ],
    bundle:
      'Thermostatic Anti-Scald Shower Valve + Blade-Handle Basin Faucet + Linear Floor Drain + 304 Safety Grab Bars.',
    action: 'Add Senior Living Package to Quote List',
    guide: '',
  },
  {
    id: 'hospitality-motels',
    title: 'Hospitality, Hotels & Motels',
    short: 'Hospitality & Motels',
    risk: 'High guest turnover causes leaky cartridges, swollen wooden vanities, and loose bathroom towel bars.',
    points: [
      {
        label: 'Moisture-Proof Metal Vanities',
        text: 'Wood-touch SUS 304 stainless steel and honeycomb aluminum vanities shrug off steam and mop water—outlasting wooden cabinets in coastal hotels and motels.',
      },
      {
        label: 'Fast-Install Rough-In Boxes',
        text: 'Brass concealed shower valves with built-in bubble levels cut renovation plumbing labor by up to 40%.',
      },
      {
        label: 'Anti-Shatter LED Mirrors',
        text: 'Copper-free silver mirrors with CAT II safety backing film and replaceable IP44 LED drivers.',
      },
    ],
    bundle:
      'Metal Vanity + Anti-Fog LED Mirror + Concealed Shower Kit + Heavy-Duty 4-Piece Bath Hardware Set.',
    action: 'Add Hospitality Package to Quote List',
    guide: '',
  },
  {
    id: 'cabinet-storage',
    title: 'Wholesale Kitchen Cabinet Storage Upgrades',
    short: 'Cabinet Storage',
    risk: 'Standard wholesale kitchen cabinets ship as empty wooden boxes with zero internal organization.',
    points: [
      {
        label: 'Metal-Only Focus',
        text: 'We do not sell wooden cabinets—we supply heavy-duty pull-out spice racks, blind-corner organizers, and matte black wall rail systems.',
      },
      {
        label: 'Margin Multiplier',
        text: 'Double your cabinet resale margin with zero wooden-cabinet tariff exposure.',
      },
    ],
    bundle: 'Pull-Out Spice Racks + Blind-Corner Organizers + Matte Black Wall Rail Systems.',
    action: 'Add Cabinet Storage Package to Quote List',
    guide: '/solutions/wholesale-kitchen-cabinets-storage/',
  },
];

const faqs = [
  {
    question: 'Can I mix products from different regional specs or project packages in one container?',
    answer:
      'Yes. We consolidate faucets, stainless steel sinks, concealed shower valves, cabinet organizers, and metal vanities into a single 20ft or 40HQ container from Guangzhou or Shenzhen, labeling cartons clearly by project phase or room type.',
  },
  {
    question: 'Do you supply wooden kitchen cabinets or stone countertops?',
    answer:
      'No. We focus strictly on metal hardware, plumbing fixtures, and storage organizers. If you source cabinet boxes or stone slabs separately, we supply the matching pull-out baskets, undermount sinks with 1:1 cutout templates, and color-matched faucets.',
  },
  {
    question: 'How do you prevent color differences across faucets, shower trim kits, and cabinet hardware?',
    answer:
      'We enforce a unified digital color standard (Delta E < 1.5) across our partner finishing workshops. Your Matte Black, PVD Brushed Gold, and Gunmetal pieces match consistently across every room.',
  },
  {
    question: 'How do we request tiered volume pricing and unbranded CAD drawings?',
    answer:
      'Click Add to Project Quote List on any package or product page, then submit your destination port or project ZIP code. Our engineering team sends itemized FOB/CIF pricing, CBM container loading math, and unbranded spec sheets within 24 hours.',
  },
];

const pageContext = createPublicPageContext({
  Astro,
  kind: 'custom',
  pageType: 'website',
  title: `${pageName}${titleSeparator}Commercial Kitchen & Bath Supply`,
  description: pageDescription,
  canonical: pageUrl,
  siteName: siteTitle,
  siteUrl,
  breadcrumbs: [
    { name: 'Home', url: localizeUrl('/') },
    { name: pageName, url: Astro.url.pathname },
  ],
});

const breadcrumbJsonLd = safeJsonLdSerialize({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${pageUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteBaseUrl}${localizeUrl('/')}` },
    { '@type': 'ListItem', position: 2, name: pageName, item: pageUrl },
  ],
});

const collectionJsonLd = safeJsonLdSerialize({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': pageUrl,
  name: pageHeading,
  description: pageDescription,
  url: pageUrl,
  isPartOf: { '@id': siteBaseUrl },
  breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
  about: [
    { '@type': 'Thing', name: 'Kitchen Hardware' },
    { '@type': 'Thing', name: 'Bathroom Hardware' },
  ],
  hasPart: {
    '@type': 'WebPageElement',
    name: 'Markets & Solutions',
    cssSelector: '#solutions',
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: solutionBlocks.length,
    itemListElement: solutionBlocks.map((block, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: block.title,
      url: `${siteBaseUrl}${localizeUrl(`/markets-solutions#${block.id}`)}`,
    })),
  },
});

const faqJsonLd = safeJsonLdSerialize({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
});
---

<BaseLayout title={pageContext.title ?? ''} page={pageContext}>
  <script type="application/ld+json" set:html={breadcrumbJsonLd}></script>
  <script type="application/ld+json" set:html={collectionJsonLd}></script>
  <script type="application/ld+json" set:html={faqJsonLd}></script>
  <style is:global>
    html { scroll-behavior: smooth; }
    :root { --site-header-h: 76px; }
    [id] { scroll-margin-top: calc(var(--site-header-h) + 74px); }
    #markets-solutions-subnav { top: var(--site-header-h); }
    @keyframes anchor-flash {
      0% { box-shadow: 0 0 0 0 rgba(249, 115, 22, 0.8); }
      100% { box-shadow: 0 0 0 14px rgba(249, 115, 22, 0); }
    }
    .anchor-flash { animation: anchor-flash 2s ease-out; }
  </style>

  <section class="relative overflow-hidden text-white">
    <div class="absolute inset-0 bg-gradient-to-br from-dark-950 via-primary-950 to-dark-950"></div>
    <div class="absolute inset-0 opacity-[0.04]">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="markets-pattern" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
            <path d="M 100 0 L 0 0 0 100" fill="none" stroke="white" stroke-width="0.5"/>
            <circle cx="0" cy="0" r="2" fill="white"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#markets-pattern)"/>
      </svg>
    </div>

    <div class="container mx-auto px-4 py-16 md:py-24 relative z-10">
      <div class="max-w-4xl">
        <nav class="flex items-center gap-2 text-sm mb-6">
          <a href={localizeUrl("/")} class="text-primary-300 hover:text-white transition-colors duration-300">Home</a>
          <svg class="w-4 h-4 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-white font-medium">{pageName}</span>
        </nav>

        <span class="inline-flex items-center gap-2 px-4 py-1.5 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full text-xs font-bold uppercase tracking-widest text-primary-200 mb-6">
          {pageName}
        </span>

        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6 leading-tight">{pageHeading}</h1>

        <p class="text-lg text-white/90 leading-relaxed mb-4">
          One factory-direct supply network built for regional codes and job-site schedules.
        </p>
        <p class="text-base text-white/70 leading-relaxed mb-8 max-w-3xl">
          We do not manufacture wooden cabinets or stone slabs. We supply certified metal faucets, sinks, concealed showers, cabinet organizers, and metal vanities—matched to Delta E &lt; 1.5 finish consistency and consolidated into one container from Guangzhou or Shenzhen.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="#markets"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-primary-600 hover:bg-primary-700 text-white rounded-xl font-bold transition-all duration-300 hover:scale-105 hover:shadow-2xl"
          >
            Browse by Regional Market (#markets)
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7-7-7M12 21V3" />
            </svg>
          </a>
          <a
            href="#solutions"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 backdrop-blur-sm border-2 border-white/30 text-white rounded-xl font-bold hover:bg-white/20 transition-all duration-300 hover:scale-105"
          >
            Browse by Project Solution (#solutions)
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7-7-7M12 21V3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <div id="markets-solutions-subnav" class="sticky z-40 bg-white/90 dark:bg-dark-900/90 backdrop-blur-xl border-b border-gray-200/60 dark:border-dark-800/60 shadow-sm">
    <div class="container mx-auto px-4 py-3 overflow-x-auto">
      <div class="flex items-center gap-2 text-sm whitespace-nowrap min-w-max">
        <span class="font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wide text-xs me-1">Jump To:</span>
        <a href="#markets" class="px-3 py-1.5 rounded-lg font-semibold text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-900/20 border border-primary-200 dark:border-primary-800 hover:bg-primary-100 dark:hover:bg-primary-900/40 transition-colors">Markets</a>
        {marketBlocks.map((block) => (
          <a href={`#${block.id}`} class="px-3 py-1.5 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-dark-800 transition-colors">{block.short}</a>
        ))}
        <a href="#solutions" class="px-3 py-1.5 rounded-lg font-semibold text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-900/20 border border-primary-200 dark:border-primary-800 hover:bg-primary-100 dark:hover:bg-primary-900/40 transition-colors">Solutions</a>
        {solutionBlocks.map((block) => (
          <a href={`#${block.id}`} class="px-3 py-1.5 rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-dark-800 transition-colors">{block.short}</a>
        ))}
      </div>
    </div>
  </div>

  <section id="markets" class="py-16 sm:py-20 bg-white dark:bg-dark-900">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <span class="text-xs font-bold uppercase tracking-widest text-primary-600 dark:text-primary-400 mb-2 inline-block">By Regional Market &amp; Code</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">Regional Markets &amp; Compliance Standards</h2>
          <div class="w-20 h-1 bg-gradient-to-r from-primary-600 to-orange-500 mx-auto rounded-full"></div>
          <p class="mt-6 text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
            A faucet built for North America will fail in the Middle East or Latin America. Pick your region to see exact thread, pressure, and certification specs.
          </p>
        </div>

        <div class="space-y-10">
          {marketBlocks.map((block, blockIndex) => (
            <div id={block.id} class="anchor-target bg-gray-50 dark:bg-dark-800 rounded-2xl p-8 sm:p-10 border border-gray-200 dark:border-dark-700 shadow-sm">
              <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white">
                  <span class="text-primary-600 dark:text-primary-400 me-2 font-mono">{String(blockIndex + 1).padStart(2, '0')}</span>
                  {block.title}
                </h3>
                <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-white dark:bg-dark-900 border border-gray-200 dark:border-dark-600 rounded-full text-xs font-bold text-gray-700 dark:text-gray-200 uppercase tracking-wide">
                  {block.badge}
                </span>
              </div>

              <p class="text-lg text-gray-700 dark:text-gray-300 mb-6">{block.pitch}</p>

              <ul class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                {block.specs.map((spec) => (
                  <li class="bg-white dark:bg-dark-900 rounded-xl p-5 border border-gray-200 dark:border-dark-700">
                    <p class="text-xs font-bold uppercase tracking-wider text-primary-600 dark:text-primary-400 mb-1">{spec.label}</p>
                    <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{spec.text}</p>
                  </li>
                ))}
              </ul>

              <div class="flex flex-wrap items-center gap-3 mb-6">
                <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Specified Lines:</p>
                <p class="text-sm font-semibold text-gray-900 dark:text-white">{block.lines}</p>
              </div>

              <div class="flex flex-wrap items-center justify-between gap-4 pt-5 border-t border-gray-200 dark:border-dark-700">
                <p class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
                  <span class="font-semibold text-gray-900 dark:text-white">Tiered Pricing: $ ??.?? / Unit</span>
                  <span class="inline-flex items-center gap-1 text-xs bg-gray-100 dark:bg-dark-700 px-2 py-0.5 rounded-full text-gray-500 dark:text-gray-400">
                    🔒 Protected
                  </span>
                </p>
                <a
                  href={localizeUrl("/cart")}
                  class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary-600 hover:bg-primary-700 text-white rounded-xl font-semibold text-sm transition-all duration-300 hover:scale-105"
                >
                  + {block.action}
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="solutions" class="py-16 sm:py-20 bg-gray-50 dark:bg-dark-800">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <span class="text-xs font-bold uppercase tracking-widest text-primary-600 dark:text-primary-400 mb-2 inline-block">By Project &amp; Industry Solution</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">Commercial &amp; Industry Hardware Solutions</h2>
          <div class="w-20 h-1 bg-gradient-to-r from-primary-600 to-orange-500 mx-auto rounded-full"></div>
          <p class="mt-6 text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
            Different buildings fail in different ways. Choose your project type to see pre-matched hardware packages that lower your total cost of ownership.
          </p>
        </div>

        <div class="space-y-10">
          {solutionBlocks.map((block, blockIndex) => (
            <div id={block.id} class="anchor-target bg-white dark:bg-dark-900 rounded-2xl p-8 sm:p-10 border border-gray-200 dark:border-dark-700 shadow-sm">
              <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white">
                  <span class="text-primary-600 dark:text-primary-400 me-2 font-mono">{String(blockIndex + 1).padStart(2, '0')}</span>
                  {block.title}
                </h3>
              </div>

              <div class="bg-red-50 dark:bg-red-950/30 border border-red-100 dark:border-red-900/40 rounded-xl px-5 py-4 mb-6">
                <p class="text-xs font-bold uppercase tracking-wider text-red-600 dark:text-red-400 mb-1">Job-Site Risk</p>
                <p class="text-gray-700 dark:text-gray-300">{block.risk}</p>
              </div>

              <ul class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                {block.points.map((point) => (
                  <li class="bg-gray-50 dark:bg-dark-800 rounded-xl p-5 border border-gray-200 dark:border-dark-700">
                    <p class="text-xs font-bold uppercase tracking-wider text-primary-600 dark:text-primary-400 mb-1">{point.label}</p>
                    <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{point.text}</p>
                  </li>
                ))}
              </ul>

              <div class="flex flex-wrap items-center gap-3 mb-6">
                <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Recommended Bundle:</p>
                <p class="text-sm font-semibold text-gray-900 dark:text-white">{block.bundle}</p>
              </div>

              {block.guide && (
                <div class="flex flex-wrap items-center gap-3 mb-6">
                  <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">Dedicated Guide:</p>
                  <a href={localizeUrl(block.guide)} class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 font-semibold text-sm hover:gap-3 transition-all duration-300">
                    Explore Full Wholesale Cabinet Storage Solutions
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </a>
                </div>
              )}

              <div class="flex flex-wrap items-center justify-between gap-4 pt-5 border-t border-gray-200 dark:border-dark-700">
                <p class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
                  <span class="font-semibold text-gray-900 dark:text-white">Project BOM Pricing: $ ??.?? / Unit</span>
                  <span class="inline-flex items-center gap-1 text-xs bg-gray-100 dark:bg-dark-700 px-2 py-0.5 rounded-full text-gray-500 dark:text-gray-400">
                    🔒 Protected
                  </span>
                </p>
                <a
                  href={localizeUrl("/cart")}
                  class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary-600 hover:bg-primary-700 text-white rounded-xl font-semibold text-sm transition-all duration-300 hover:scale-105"
                >
                  + {block.action}
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

<section class="py-16 sm:py-20 bg-white dark:bg-dark-900">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">Markets &amp; Solutions FAQ</h2>
          <div class="w-20 h-1 bg-gradient-to-r from-primary-600 to-orange-500 mx-auto rounded-full"></div>
        </div>

        <div class="space-y-4">
          {faqs.map((item) => (
            <div class="faq-item bg-gray-50 dark:bg-dark-800 rounded-xl overflow-hidden border border-gray-200 dark:border-dark-700">
              <button type="button" class="faq-trigger w-full px-6 py-5 text-start flex items-center justify-between hover:bg-gray-100 dark:hover:bg-dark-700 transition-colors">
                <span class="font-semibold text-gray-900 dark:text-white pe-4">{item.question}</span>
                <svg class="w-5 h-5 shrink-0 text-gray-500 transition-transform faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="faq-content hidden px-6 pb-5">
                <p class="text-gray-600 dark:text-gray-400 leading-relaxed">{item.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-gray-50 dark:bg-dark-800">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <div class="bg-gradient-to-br from-primary-600 via-primary-500 to-orange-500 dark:from-primary-700 dark:via-primary-600 dark:to-orange-600 rounded-2xl p-8 sm:p-12 text-white relative overflow-hidden">
          <div class="absolute inset-0 opacity-10">
            <div class="absolute top-0 end-0 w-64 h-64 bg-white rounded-full blur-3xl"></div>
            <div class="absolute bottom-0 start-0 w-64 h-64 bg-white rounded-full blur-3xl"></div>
          </div>

          <div class="relative z-10 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
            <div>
              <h2 class="text-3xl sm:text-4xl font-bold mb-4">Ready to Consolidate Your Next Kitchen &amp; Bath Order?</h2>
              <p class="text-lg text-white/90 leading-relaxed">
                Send us your project BOM or target SKU list. We will match your finishes, verify regional code specs, and map out your 20ft or 40HQ container load.
              </p>
            </div>
            <div class="flex flex-col sm:flex-row md:justify-end gap-4">
              <a href={localizeUrl("/cart")} class="inline-flex items-center justify-center gap-2 px-6 py-4 bg-white text-primary-600 rounded-xl font-semibold hover:bg-gray-100 transition-colors shadow-lg">
                + Open Project Quote List
              </a>
              <a href={localizeUrl("/contact")} class="inline-flex items-center justify-center gap-2 px-6 py-4 bg-white/10 backdrop-blur-sm border-2 border-white/30 text-white rounded-xl font-semibold hover:bg-white/20 transition-colors">
                Contact Engineering Desk
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    function syncHeaderOffset() {
      var header = document.querySelector('header.sticky');
      if (!header) return;
      var h = Math.round(header.getBoundingClientRect().height);
      document.documentElement.style.setProperty('--site-header-h', h + 'px');
    }

    document.querySelectorAll('.faq-trigger').forEach(function (trigger) {
      trigger.addEventListener('click', function () {
        var content = trigger.nextElementSibling;
        var icon = trigger.querySelector('.faq-icon');
        if (!content) return;
        content.classList.toggle('hidden');
        if (icon) icon.classList.toggle('rotate-180');
      });
    });

    function flashAnchor() {
      var hash = window.location.hash;
      if (!hash) return;
      var target = document.querySelector(hash);
      if (!target || !target.classList.contains('anchor-target')) return;
      target.classList.remove('anchor-flash');
      void target.offsetWidth;
      target.classList.add('anchor-flash');
      setTimeout(function () {
        target.classList.remove('anchor-flash');
      }, 2200);
    }

    syncHeaderOffset();
    window.addEventListener('load', syncHeaderOffset);
    window.addEventListener('resize', syncHeaderOffset);
    window.addEventListener('hashchange', function () {
      syncHeaderOffset();
      flashAnchor();
    });
    window.addEventListener('load', flashAnchor);
  </script>
</BaseLayout>