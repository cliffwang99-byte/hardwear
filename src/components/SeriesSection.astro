---
import type { ShopSeriesDetail } from "../lib/shop";
import { localizePath } from "../lib/i18n";

interface Props {
  series: ShopSeriesDetail;
  locale?: string;
}

const { series, locale } = Astro.props;

const currentLocale = locale ?? Astro.currentLocale ?? "en";
const categoryLabels = new Map(series.categoryGroups.map((group) => [group.slug, group.name]));
const products = series.products;

function categoryName(slug: string | undefined): string {
  if (!slug) return "";
  return categoryLabels.get(slug) ?? slug.replace(/-/g, " ");
}

function productUrl(id: string): string {
  return localizePath(`/product/${id}`, currentLocale);
}

const quoteItems = products.map((product) => ({
  id: product.id,
  name: product.name,
  price: product.price,
  image: product.image,
}));
---

<section class="py-12 sm:py-16 border-t border-gray-200 dark:border-dark-800 animate-on-scroll">
  <div class="container mx-auto px-4">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6 pb-4 border-b border-gray-300 dark:border-dark-700">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">
          {series.name}
        </h2>
        {series.description && (
          <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed mt-2 max-w-3xl">
            {series.description}
          </p>
        )}
      </div>
      <div class="flex items-center gap-3 flex-shrink-0">
        <span class="text-xs uppercase tracking-widest text-gray-500 dark:text-gray-400">
          {products.length} {products.length === 1 ? "product" : "products"}
        </span>
        <button
          type="button"
          data-add-series
          data-series-name={series.name}
          data-series-products={JSON.stringify(quoteItems)}
          disabled={products.length === 0}
          class="inline-flex items-center gap-2 px-4 py-2.5 bg-primary-600 hover:bg-primary-700 disabled:bg-gray-300 dark:disabled:bg-dark-700 disabled:text-gray-500 dark:disabled:text-dark-500 text-white text-xs sm:text-sm font-semibold rounded-xl transition-all duration-300 hover:shadow-lg active:scale-95 disabled:cursor-not-allowed disabled:hover:shadow-none"
        >
          <svg data-series-icon class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span data-series-label>Add Series to Quote</span>
        </button>
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
      {products.map((product) => (
        <div class="group">
          <a
            href={productUrl(product.id)}
            class="block relative overflow-hidden rounded-xl border border-gray-200 dark:border-dark-700 bg-gray-50 dark:bg-dark-800 aspect-square"
          >
            {product.image ? (
              <img
                src={product.image}
                alt={product.name || categoryName(product.category) || "Product"}
                class="w-full h-full object-contain p-3 group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center text-gray-400 dark:text-dark-500">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14" />
                </svg>
              </div>
            )}
          </a>
          <a
            href={productUrl(product.id)}
            class="mt-2 block text-xs sm:text-sm font-medium text-gray-900 dark:text-white hover:text-primary-600 dark:hover:text-primary-400 transition-colors truncate"
          >
            {categoryName(product.category)}
          </a>
          {product.sku && (
            <p class="text-[11px] sm:text-xs text-gray-500 dark:text-gray-400">
              {product.sku}
            </p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function bindSeriesQuote(): void {
    const flag = "__seriesQuoteBound";
    const win = window as unknown as Record<string, boolean>;
    if (win[flag]) return;
    win[flag] = true;

    document.addEventListener("click", (event) => {
      const target = (event.target as HTMLElement | null)?.closest("[data-add-series]");
      if (!(target instanceof HTMLElement)) return;

      const raw = target.dataset.seriesProducts;
      if (!raw) return;

      let items: { id: string; name: string; price: number; image: string }[] = [];
      try {
        items = JSON.parse(raw);
      } catch {
        return;
      }
      if (!items.length) return;

      let cart: any[] = [];
      try {
        cart = JSON.parse(localStorage.getItem("cart") || "[]");
      } catch {
        cart = [];
      }
      if (!Array.isArray(cart)) cart = [];

      for (const item of items) {
        const existing = cart.find((entry: any) => entry.id === item.id);
        if (existing) {
          existing.quantity = Math.max(1, Number(existing.quantity) || 1);
        } else {
          cart.push({ ...item, quantity: 1 });
        }
      }

      try {
        localStorage.setItem("cart", JSON.stringify(cart));
      } catch {
        return;
      }

      const count = cart.reduce((sum: number, item: any) => sum + (Number(item.quantity) || 0), 0);
      document.querySelectorAll("[data-cart-count]").forEach((el) => {
        el.textContent = count.toString();
      });

      const label = target.querySelector("[data-series-label]");
      if (!label) return;
      const original = label.textContent ?? "Add Series to Quote";
      label.textContent = `Added ${items.length} products`;
      target.classList.add("!bg-green-600", "hover:!bg-green-700");

      window.setTimeout(() => {
        label.textContent = original;
        target.classList.remove("!bg-green-600", "hover:!bg-green-700");
      }, 2000);
    });
  }

  bindSeriesQuote();
</script>