---
import { localizePath } from "../lib/i18n";
import type { ShopSeriesDetail } from "../lib/shop";

interface Props {
  series: ShopSeriesDetail;
  locale?: string;
  image?: string;
}

const { series, locale = "en", image = "" } = Astro.props;
const seriesUrl = localizePath(`/series/${series.slug}`, locale);
const fallbackImage = series.products[0]?.image ?? "";
const heroImage = image || fallbackImage;
const totalProducts = series.totalProducts;
---

<section class="py-12 sm:py-16 border-t border-gray-200 dark:border-dark-800 animate-on-scroll">
  <div class="container mx-auto px-4">
    <div class="grid gap-8 lg:grid-cols-2 lg:gap-12 items-center">
      <div class="relative overflow-hidden rounded-2xl bg-gray-100 dark:bg-dark-800 aspect-[4/3]">
        {heroImage ? (
          <img
            src={heroImage}
            alt={series.name}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-gray-200 to-gray-300 dark:from-dark-700 dark:to-dark-800">
            <svg class="w-16 h-16 text-gray-400 dark:text-dark-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M14 8h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        )}
      </div>

      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mb-3">
          {series.name}
        </h2>
        {series.description && (
          <p class="text-sm sm:text-base text-gray-600 dark:text-gray-400 leading-relaxed mb-6">
            {series.description}
          </p>
        )}
        <div class="flex flex-wrap items-center gap-4">
          <a
            href={seriesUrl}
            class="inline-flex items-center gap-2 px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-lg transition-colors"
          >
            See All {series.name}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <span class="text-xs uppercase tracking-widest text-gray-500 dark:text-gray-400">
            {totalProducts} {totalProducts === 1 ? "product" : "products"}
          </span>
        </div>
      </div>
    </div>

    {series.categoryGroups.length > 0 && (
      <div class="mt-10 sm:mt-12">
        <h3 class="text-xs sm:text-sm uppercase tracking-widest font-semibold text-gray-500 dark:text-gray-400 mb-5">
          Featured Product Categories
        </h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {series.categoryGroups.map((group) => (
            <a
              href={localizePath(`/categories/${group.slug}`, locale)}
              class="group block rounded-xl border border-gray-200 dark:border-dark-700 bg-white dark:bg-dark-800 p-3 hover:border-primary-500 dark:hover:border-primary-500 hover:shadow-lg transition-all"
            >
              <div class="aspect-square overflow-hidden rounded-lg bg-gray-100 dark:bg-dark-700 mb-3">
                {group.products[0]?.image ? (
                  <img
                    src={group.products[0].image}
                    alt={group.name}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-gray-400 dark:text-dark-500">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14" />
                    </svg>
                  </div>
                )}
              </div>
              <p class="text-xs sm:text-sm font-semibold text-gray-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                {group.name}
              </p>
              <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">
                {group.products.length} {group.products.length === 1 ? "item" : "items"}
              </p>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</section>