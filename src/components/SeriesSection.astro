---
import type { ShopSeriesDetail } from "../lib/shop";

interface Props {
  series: ShopSeriesDetail;
  locale?: string;
}

const { series } = Astro.props;

const categoryLabels = new Map(series.categoryGroups.map((group) => [group.slug, group.name]));
const products = series.products;

function categoryName(slug: string | undefined): string {
  if (!slug) return "";
  return categoryLabels.get(slug) ?? slug.replace(/-/g, " ");
}
---

<section class="py-12 sm:py-16 border-t border-gray-200 dark:border-dark-800 animate-on-scroll">
  <div class="container mx-auto px-4">
    <div class="flex items-end justify-between gap-4 mb-6 pb-4 border-b border-gray-300 dark:border-dark-700">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">
          {series.name}
        </h2>
        {series.description && (
          <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed mt-2 max-w-3xl">
            {series.description}
          </p>
        )}
      </div>
      <span class="flex-shrink-0 text-xs uppercase tracking-widest text-gray-500 dark:text-gray-400">
        {products.length} {products.length === 1 ? "product" : "products"}
      </span>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
      {products.map((product) => (
        <div class="group">
          <div class="relative overflow-hidden rounded-xl border border-gray-200 dark:border-dark-700 bg-gray-50 dark:bg-dark-800 aspect-square">
            {product.image ? (
              <img
                src={product.image}
                alt={product.name || categoryName(product.category) || "Product"}
                class="w-full h-full object-contain p-3 group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center text-gray-400 dark:text-dark-500">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14" />
                </svg>
              </div>
            )}
          </div>
          <p class="mt-2 text-xs sm:text-sm font-medium text-gray-900 dark:text-white">
            {categoryName(product.category)}
          </p>
          {product.sku && (
            <p class="text-[11px] sm:text-xs text-gray-500 dark:text-gray-400">
              {product.sku}
            </p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>