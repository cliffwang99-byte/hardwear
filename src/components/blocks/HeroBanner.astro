---
// src/components/blocks/HeroBanner.astro
import { Image } from "emdash/ui";

interface Props {
  value?: {
    _type?: string;
    _key?: string;
    eyebrow?: string;
    heading?: string;
    sub_text?: string;
    bg_image?: unknown;
    cta_label?: string;
    cta_href?: string;
  };
}

const { value } = Astro.props;
if (!value) return null;

const { heading, sub_text, eyebrow, bg_image, cta_label, cta_href } = value;
---

<section class="relative overflow-hidden">
  {bg_image && (
    <Image
      image={bg_image}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      priority
      placeholder={false}
    />
  )}
  <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70"></div>

  <div class="relative mx-auto max-w-5xl px-4 py-14 text-center text-white sm:py-24">
    {eyebrow && (
      <p class="mb-4 text-sm font-bold uppercase tracking-widest text-primary-300 sm:text-base">
        {eyebrow}
      </p>
    )}
    {heading && (
      <h1 class="mb-6 text-3xl leading-tight font-bold drop-shadow-lg sm:text-5xl md:text-6xl">
        {heading}
      </h1>
    )}
    {sub_text && (
      <p class="mx-auto mb-8 max-w-2xl text-base leading-relaxed text-white/90 sm:text-lg">
        {sub_text}
      </p>
    )}
    {cta_href && (
      <a
        href={cta_href}
        class="inline-flex items-center gap-2 rounded-xl bg-primary-600 px-8 py-3.5 text-sm font-bold text-white transition-all duration-300 hover:scale-105 hover:bg-primary-700 hover:shadow-lg"
      >
        {cta_label || "Learn More"}
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    )}
  </div>
</section>