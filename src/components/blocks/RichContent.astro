---
// src/components/blocks/RichContent.astro
import { PortableText } from "emdash/ui";

interface Props {
  value?: {
    _type?: string;
    _key?: string;
    heading?: string;
    body?: unknown;
  };
}

const { value } = Astro.props;
const heading = value?.heading;
const body = value?.body;

if (!heading && !Array.isArray(body)) return null;
---

<section class="mx-auto max-w-6xl px-4 py-14">
  <div class="mx-auto max-w-5xl">
    {heading && (
      <h2 class="mb-8 text-center text-2xl font-bold text-gray-900 dark:text-white sm:text-3xl">
        {heading}
      </h2>
    )}
    {Array.isArray(body) && (
      <article class="richtext mx-auto max-w-[50.4rem]">
        <PortableText value={body} />
      </article>
    )}
  </div>
</section>