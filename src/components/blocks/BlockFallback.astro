---
// src/components/blocks/BlockFallback.astro

interface Props {
  value?: unknown;
}

const { value } = Astro.props;
const type = typeof value === "object" && value !== null
  ? (value as { _type?: string })._type ?? "unknown"
  : "unknown";
---

{type !== "unknown" && (
  <div class="py-10 text-center text-sm text-gray-400 dark:text-gray-500">
    [Block "{type}" has no renderer yet]
  </div>
)}