---
// src/components/blocks/ImageCards.astro
import { Image } from "emdash/ui";

interface Card {
  _key?: string;
  image?: unknown;
  title?: string;
  desc?: string;
}

interface Props {
  value?: {
    _type?: string;
    _key?: string;
    section_title?: string;
    sub_text?: string;
    cards?: Card[];
    cols?: string;
  };
}

const { value } = Astro.props;
const sectionTitle = value?.section_title;
const subText = value?.sub_text;
const cards = Array.isArray(value?.cards) ? value.cards : [];
const cols = value?.cols ?? "3";

if (!sectionTitle && !subText && cards.length === 0) return null;

const gridClass =
  cols === "2" ? "sm:grid-cols-2" : cols === "4" ? "sm:grid-cols-2 lg:grid-cols-4" : "sm:grid-cols-2 lg:grid-cols-3";
---

<section class="border-y border-gray-200 bg-gray-50 py-14 dark:border-dark-800 dark:bg-dark-900">
  <div class="mx-auto max-w-6xl px-4">
    {sectionTitle && (
      <h2 class="mb-4 text-center text-2xl font-bold text-gray-900 dark:text-white sm:text-3xl">
        {sectionTitle}
      </h2>
    )}
    {subText && (
      <p class="mb-12 text-center text-gray-600 dark:text-gray-300">{subText}</p>
    )}
    <div class={`grid grid-cols-1 gap-6 ${gridClass}`}>
      {cards.map((card) => (
        <div
          class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl dark:border-dark-700 dark:bg-dark-800"
          key={card._key}
        >
          {card.image && (
            <div class="aspect-[4/3] overflow-hidden">
              <Image image={card.image} alt={card.title ?? ""} class="h-full w-full object-cover transition-transform duration-300 hover:scale-105" placeholder={false} />
            </div>
          )}
          <div class="p-6">
            {card.title && (
              <h3 class="mb-2 text-lg font-bold text-gray-900 dark:text-white">{card.title}</h3>
            )}
            {card.desc && (
              <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">{card.desc}</p>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>