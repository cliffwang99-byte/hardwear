---
// src/components/blocks/SpecTable.astro

interface Row {
  _key?: string;
  label?: string;
  value?: string;
}

interface Props {
  value?: {
    _type?: string;
    _key?: string;
    title?: string;
    caption?: string;
    rows?: Row[];
    cols?: Row[];
  };
}

const { value } = Astro.props;
const { title, caption, rows: rowData, cols: colData } = value ?? {};
const rows = Array.isArray(rowData) ? rowData : [];
const cols = Array.isArray(colData) ? colData : [];

if (!title && rows.length === 0 && cols.length === 0) return null;
---

<section class="mx-auto max-w-6xl px-4 py-14">
  <div class="mx-auto max-w-4xl overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-dark-700 dark:bg-dark-800">
    {title && (
      <div class="border-b border-gray-200 px-6 py-5 dark:border-dark-700">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white sm:text-2xl">{title}</h2>
        {caption && <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{caption}</p>}
      </div>
    )}

    {cols.length > 0 ? (
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <tbody>
            {cols.map((col) => (
              <tr
                class="border-b border-gray-100 bg-gray-50 first:bg-transparent last:border-0 dark:border-dark-700 dark:bg-dark-900/50 dark:first:bg-transparent"
                key={col._key}
              >
                <th class="w-1/2 px-6 py-4 text-start font-semibold text-gray-900 dark:text-white">
                  {col.label}
                </th>
                <td class="px-6 py-4 whitespace-pre-wrap text-gray-600 dark:text-gray-300">
                  {col.value}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <tbody>
            {rows.map((row) => (
              <tr class="border-b border-gray-100 last:border-0 dark:border-dark-700" key={row._key}>
                <th class="w-1/3 bg-gray-50 px-6 py-4 text-start font-semibold text-gray-900 dark:bg-dark-900/50 dark:text-white">
                  {row.label}
                </th>
                <td class="px-6 py-4 whitespace-pre-wrap text-gray-600 dark:text-gray-300">
                  {row.value}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</section>