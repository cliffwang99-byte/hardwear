---
// src/components/blocks/FaqAccordion.astro
import { PortableText } from "emdash/ui";
import { faqBlocksToItems, portableTextToText } from "../../lib/shop";

interface LegacyFaq {
  _key?: string;
  question?: string;
  answer?: string;
}

interface Props {
  value?: {
    _type?: string;
    _key?: string;
    title?: string;
    body?: unknown;
    faqs?: LegacyFaq[];
  };
}

const { value } = Astro.props;
const title = value?.title;

// v2：富文本正文，H2/H3/H4 标题作为问题、后续块作为答案；一次输入即可。
const bodyItems = faqBlocksToItems(Array.isArray(value?.body) ? (value.body as unknown[]) : []);

// 兼容 v1 历史数据：身上没有富文本时回退旧 repeater 结构。
const legacyFaqs = (Array.isArray(value?.faqs) ? value.faqs : []).filter(
  (f) => f?.question && f?.answer,
);

const faqs =
  bodyItems.length > 0
    ? bodyItems
    : legacyFaqs.map((f) => ({
        question: f.question,
        answerBlocks: [{ _type: "block", style: "normal", children: [{ _type: "span", text: f.answer }] }],
      }));

if (faqs.length === 0) return null;

const faqLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: portableTextToText(f.answerBlocks) },
  })),
});
---

<section class="mx-auto max-w-4xl px-4 py-14">
  {title && (
    <h2 class="mb-10 text-center text-2xl font-bold text-gray-900 dark:text-white sm:text-3xl">
      {title}
    </h2>
  )}

  <div class="space-y-3">
    {faqs.map((faq) => (
      <div
        class="faq-item overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-dark-700 dark:bg-dark-800"
      >
        <button
          type="button"
          class="faq-trigger flex w-full items-center justify-between gap-4 px-6 py-5 text-start transition-colors hover:bg-gray-50 dark:hover:bg-dark-700"
        >
          <span class="font-semibold text-gray-900 dark:text-white">{faq.question}</span>
          <svg class="faq-icon h-5 w-5 shrink-0 text-gray-500 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="faq-content hidden px-6 pb-5 text-sm leading-relaxed text-gray-600 dark:text-gray-300 richtext max-w-none">
          <PortableText value={faq.answerBlocks as never} />
        </div>
      </div>
    ))}
  </div>
</section>

<script is:inline>
  document.querySelectorAll('.faq-trigger').forEach(function (trigger) {
    trigger.addEventListener('click', function () {
      var content = trigger.nextElementSibling;
      var icon = trigger.querySelector('.faq-icon');
      if (!content) return;
      content.classList.toggle('hidden');
      if (icon) icon.classList.toggle('rotate-180');
    });
  });
</script>

<script set:html={faqLd} type="application/ld+json" />