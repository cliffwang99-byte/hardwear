---
// src/components/blocks/FeatureGrid.astro
import { Image } from "emdash/ui";

interface GridItem {
  _key?: string;
  icon?: unknown;
  title?: string;
  desc?: string;
}

interface Props {
  value?: {
    _type?: string;
    _key?: string;
  section_title?: string;
  items?: GridItem[];
  };
}

const { value } = Astro.props;
const sectionTitle = value?.section_title;
const items = Array.isArray(value?.items) ? value.items : [];

if (!sectionTitle && items.length === 0) return null;
---

<section class="border-y border-gray-200 bg-gray-50 py-14 dark:border-dark-800 dark:bg-dark-900">
  <div class="mx-auto max-w-6xl px-4">
    {sectionTitle && (
      <h2 class="mb-12 text-center text-2xl font-bold text-gray-900 dark:text-white sm:text-3xl">
        {sectionTitle}
      </h2>
    )}
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <div
          class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl dark:border-dark-700 dark:bg-dark-800"
          key={item._key}
        >
          {item.icon && (
            <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-xl bg-primary-50 dark:bg-dark-700">
              <Image image={item.icon} alt="" width={48} height={48} class="h-9 w-9 object-contain" />
            </div>
          )}
          {item.title && (
            <h3 class="mb-2 text-lg font-bold text-gray-900 dark:text-white">{item.title}</h3>
          )}
          {item.desc && (
            <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">{item.desc}</p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>