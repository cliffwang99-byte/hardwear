---
import { localizePath } from '../lib/i18n';
import { getCatalogCategoryOptions } from '../lib/shop';
interface Props {
  categoryName: string;
  scopeType?: 'category' | 'topic' | 'landing';
}
const { categoryName, scopeType = 'category' } = Astro.props;
const catalogOptions = await getCatalogCategoryOptions();
const locale = Astro.currentLocale ?? 'en';
const isRtl = locale === 'ar';
const quoteUrl = localizePath('/cart', locale);
const COPY = {
  en: {
    badge: 'FULL FACTORY MOLD LIBRARY',
    title: 'Need More Styles, Sizes, or Custom Specs?',
    body: 'We only display our top spec-grade models online to keep your selection fast. Our member workshops hold 500+ ready-to-use molds across kitchen and bath hardware. Request our full unbranded PDF catalog or send your project BOM for exact cross-referencing.',
    trust: ['500+ ready molds', 'Zinc / SS304 / Brass', 'NPT & G1/2 threads'],
    emailLabel: 'Work Email *',
    emailPlaceholder: 'you@company.com',
    geoLabel: 'Country *',
    geoPlaceholder: 'e.g. United States, Canada, Mexico',
    geoKind: 'country',
    catalogLabel: 'Which catalogs do you need?',
    catalogPlaceholder: 'Select catalogs...',
    cta: 'Request Full PDF Catalog',
    bomLink: 'Have a BOM or competitor model list? Send it with your request ->',
    quoteLink: 'Already building a quote? Add a note for full catalog access ->',
    modalTitle: 'Send your BOM or competitor list',
    modalSub: 'We will cross-reference your list against our mold library and reply with matching model numbers.',
    companyLabel: 'Company (optional)',
    companyPlaceholder: 'ACME Builders',
    bomLabel: 'BOM / competitor model list (optional)',
    bomPlaceholder: 'Paste model numbers, quantities, or a link to your spec sheet.',
    submit: 'Send Request',
    cancel: 'Cancel',
    errRequired: 'Please fill in the required fields.',
    errEmail: 'Please enter a valid work email.',
    errGeneric: 'Something went wrong. Please try again.',
    success: 'Catalog request received. We will email the full PDF within 1 business day.',
  },
  es: {
    badge: 'CATALOGO COMPLETO DE FABRICA',
    title: 'Busca Mas Modelos o Precios por Contenedor?',
    body: 'En linea solo mostramos nuestros modelos de mayor rotacion para agilizar su compra. Nuestras fabricas asociadas cuentan con mas de 500 moldes listos en aleacion de zinc, acero inoxidable y laton con roscas NPT y G1/2. Solicite el catalogo completo en PDF para mayoristas y proyectos.',
    trust: ['500+ moldes listos', 'Zinc / Acero inox. / Laton', 'Rosca NPT y G1/2'],
    emailLabel: 'Correo Corporativo *',
    emailPlaceholder: 'usted@empresa.com',
    geoLabel: 'País *',
    geoPlaceholder: 'Ej. Estados Unidos, México, Perú',
    geoKind: 'country',
    catalogLabel: '¿Qué catálogos necesita?',
    catalogPlaceholder: 'Seleccione catálogos...',
    cta: 'Solicitar Catalogo PDF Completo',
    bomLink: 'Tiene un BOM o lista de modelos? Enviela junto con su solicitud ->',
    quoteLink: 'Ya esta armando una cotizacion? Agregue una nota para el catalogo completo ->',
    modalTitle: 'Envie su BOM o lista de modelos de la competencia',
    modalSub: 'Compararemos su lista con nuestra biblioteca de moldes y le responderemos con los modelos equivalentes.',
    companyLabel: 'Empresa (opcional)',
    companyPlaceholder: 'ACME Builders',
    bomLabel: 'BOM / lista de modelos (opcional)',
    bomPlaceholder: 'Pegue numeros de modelo, cantidades o un enlace a su ficha tecnica.',
    submit: 'Enviar Solicitud',
    cancel: 'Cancelar',
    errRequired: 'Complete los campos obligatorios.',
    errEmail: 'Ingrese un correo corporativo valido.',
    errGeneric: 'Ocurrio un error. Intentelo de nuevo.',
    success: 'Solicitud recibida. Le enviaremos el catalogo PDF completo en 1 dia habil.',
  },
  ar: {
    badge: 'كتالوج المصنع الكامل للمشاريع الهندسية',
    title: 'هل تبحث عن موديلات إضافية أو مواصفات خاصة لمشروعك؟',
    body: 'نعرض عبر الإنترنت الموديلات الهندسية الأكثر طلباً لتسريع عملية الاختيار. تمتلك مصانعنا الشريكة أكثر من 500 قالب جاهز من النحاس الأصفر والستانلس ستيل المطابقة لمعايير SASO و SABER. اطلب الكتالوج الكامل بصيغة PDF أو أرسل جدول الكميات (BOQ) للمطابقة الفورية.',
    trust: ['أكثر من 500 قالب جاهز', 'نحاس أصفر / ستانلس ستيل', 'معايير SASO و SABER'],
    emailLabel: 'البريد الإلكتروني للعمل *',
    emailPlaceholder: 'you@company.com',
    geoLabel: 'الدولة *',
    geoPlaceholder: 'مثل: السعودية، الإمارات، مصر',
    geoKind: 'country',
    catalogLabel: 'ما الكتالوجات التي تحتاجها؟',
    catalogPlaceholder: 'اختر الكتالوجات...',
    crLabel: 'رقم السجل التجاري (CR Number)',
    cta: 'طلب الكتالوج الهندسي الكامل (PDF)',
    bomLink: 'هل لديك جدول كميات أو قائمة موديلات؟ أرسلها مع طلبك',
    quoteLink: 'هل بدأت ببناء عرض سعر؟ أضف ملاحظة للحصول على الكتالوج الكامل',
    modalTitle: 'أرسل جدول الكميات أو قائمة موديلات المنافسين',
    modalSub: 'سنقوم بمطابقة قائمتك مع مكتبة القوالب لدينا ونرد عليك بأرقام الموديلات المطابقة.',
    companyLabel: 'الشركة (اختياري)',
    companyPlaceholder: 'ACME Builders',
    bomLabel: 'جدول الكميات / قائمة الموديلات (اختياري)',
    bomPlaceholder: 'الصق أرقام الموديلات أو الكميات أو رابط جدول المواصفات.',
    submit: 'إرسال الطلب',
    cancel: 'إلغاء',
    errRequired: 'يرجى إكمال الحقول المطلوبة.',
    errEmail: 'يرجى إدخال بريد إلكتروني للعمل صالح.',
    errGeneric: 'حدث خطأ. يرجى المحاولة مرة أخرى.',
    success: 'تم استلام طلبك. سنرسل الكتالوج الكامل بصيغة PDF خلال يوم عمل واحد.',
  },
} as const;
const t = COPY[locale as keyof typeof COPY] ?? COPY.en;
const scopeLabel = scopeType === 'topic' ? categoryName + ' Topic' : scopeType === 'landing' ? categoryName + ' Landing' : categoryName + ' Category';
const fieldClass = 'w-full px-3.5 py-2.5 rounded-lg bg-white/10 border border-white/15 text-white placeholder:text-white/40 text-sm focus:outline-none focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/25 transition';
const labelClass = 'block text-xs font-semibold text-emerald-100/90 mb-1.5';
---

<section class="bg-[#0e2a22] text-white overflow-hidden" data-catalog-banner>
  <div class="container mx-auto px-4 py-14 sm:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-14 items-start">
      <div class="lg:col-span-3">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-400/10 border border-emerald-400/30 text-emerald-300 text-[11px] sm:text-xs font-bold tracking-[0.14em] uppercase">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          {t.badge}
        </span>
        <h3 class="mt-5 text-2xl sm:text-3xl lg:text-[2.1rem] font-bold leading-tight text-white">{t.title}</h3>
        <p class="mt-4 text-sm sm:text-base text-emerald-50/75 leading-relaxed max-w-2xl">{t.body}</p>
        <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-3">
          {t.trust.map((item) => (
            <li class="flex items-center gap-2 text-xs sm:text-sm text-emerald-100/85">
              <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-2 w-full">
        <form data-catalog-form data-catalog-mode="quick" data-scope-type={scopeType} data-scope-name={categoryName} data-locale={locale} data-geo-kind={t.geoKind} class="bg-white/[0.06] border border-white/10 rounded-2xl p-5 sm:p-6 backdrop-blur-sm">
          <input type="hidden" name="scope_type" value={scopeType}/>
          <input type="hidden" name="scope_name" value={categoryName}/>
          <input type="hidden" name="scope_label" value={scopeLabel}/>
          <input type="hidden" name="locale" value={locale}/>
          <input type="hidden" name="geo_kind" value={t.geoKind}/>
          <div class="absolute -left-[9999px] top-auto" aria-hidden="true">
            <label>Website</label>
            <input type="text" name="honeypot_website" tabindex="-1" autocomplete="off"/>
          </div>
          <input type="hidden" name="submitted_at" value=""/>
          <div class="space-y-3">
            <div>
              <label class={labelClass}>{t.emailLabel}</label>
              <input data-field="email" type="email" name="work_email" required placeholder={t.emailPlaceholder} class={fieldClass}/>
            </div>
            <div>
              <label class={labelClass}>{t.geoLabel}</label>
              <input data-field="geo" type="text" name="geo_value" required placeholder={t.geoPlaceholder} class={fieldClass}/>
            </div>
            <div>
              <label class={labelClass}>{t.catalogLabel}</label>
              <div data-catalog-dropdown class="relative">
                <details class="group">
                  <summary class="flex items-center justify-between gap-2 cursor-pointer list-none select-none px-3.5 py-2.5 rounded-lg bg-white/10 border border-white/15 hover:border-emerald-400 focus-within:border-emerald-400 focus-within:ring-2 focus-within:ring-emerald-400/25 transition">
                    <span data-catalog-value-label data-placeholder={t.catalogPlaceholder} class="text-sm text-white/60 truncate">{t.catalogPlaceholder}</span>
                    <svg class="w-4 h-4 shrink-0 text-white/50 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                  </summary>
                  <div class="absolute z-30 start-0 w-full mt-1.5 max-h-56 overflow-auto rounded-lg bg-[#0e2a22] border border-white/15 shadow-2xl p-2 space-y-0.5">
                    {catalogOptions.map((opt) => (
                      <label class="flex items-center gap-2.5 px-2.5 py-2 rounded-md hover:bg-white/10 cursor-pointer text-sm text-white/90">
                        <input type="checkbox" value={opt.slug} data-catalog-opt class="w-4 h-4 accent-emerald-400 shrink-0"/>
                        <span class="truncate">{opt.name}</span>
                      </label>
                    ))}
                  </div>
                </details>
                <input type="hidden" name="catalog_categories" data-catalog-value/>
              </div>
            </div>
          </div>
          <button type="submit" data-catalog-submit class="mt-4 w-full py-3 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-[#0b1f19] font-bold text-sm transition-colors active:scale-[0.99] disabled:opacity-60 disabled:cursor-not-allowed">{t.cta}</button>
          <p data-catalog-status class="hidden mt-3 text-xs leading-relaxed"></p>
          <div class="mt-4 pt-4 border-t border-white/10 space-y-2">
            <button type="button" data-catalog-open class="block w-full text-start text-xs text-emerald-200/80 hover:text-emerald-300 transition-colors">{t.bomLink}</button>
            <a href={quoteUrl} class="block text-xs text-emerald-200/80 hover:text-emerald-300 transition-colors">{t.quoteLink}</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<div data-catalog-modal class="hidden fixed inset-0 z-[80]">
  <div data-catalog-backdrop class="absolute inset-0 bg-black/70 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>
  <div data-catalog-panel class="absolute top-0 end-0 h-full w-full sm:w-[480px] bg-[#0e2a22] border-s border-white/10 shadow-2xl overflow-y-auto translate-x-full rtl:-translate-x-full transition-transform duration-300">
    <div class="sticky top-0 bg-[#0e2a22] px-5 py-4 border-b border-white/10 flex items-start justify-between gap-4">
      <div>
        <h4 class="text-base sm:text-lg font-bold text-white leading-snug">{t.modalTitle}</h4>
        <p class="mt-1 text-xs text-emerald-100/65 leading-relaxed">{t.modalSub}</p>
      </div>
      <button type="button" data-catalog-close class="p-2 -me-1 text-white/70 hover:text-white rounded-lg hover:bg-white/10 transition-colors shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <form data-catalog-form data-catalog-mode="full" data-scope-type={scopeType} data-scope-name={categoryName} data-locale={locale} data-geo-kind={t.geoKind} class="p-5 space-y-3">
      <input type="hidden" name="scope_type" value={scopeType}/>
      <input type="hidden" name="scope_name" value={categoryName}/>
      <input type="hidden" name="scope_label" value={scopeLabel}/>
      <input type="hidden" name="locale" value={locale}/>
      <input type="hidden" name="geo_kind" value={t.geoKind}/>
      <div class="absolute -left-[9999px] top-auto" aria-hidden="true">
        <label>Website</label>
        <input type="text" name="honeypot_website" tabindex="-1" autocomplete="off"/>
      </div>
      <input type="hidden" name="submitted_at" value=""/>
      <div>
        <label class={labelClass}>{t.emailLabel}</label>
        <input data-field="email" type="email" name="work_email" required placeholder={t.emailPlaceholder} class={fieldClass}/>
      </div>
      <div>
        <label class={labelClass}>{t.geoLabel}</label>
        <input data-field="geo" type="text" name="geo_value" required placeholder={t.geoPlaceholder} class={fieldClass}/>
      </div>
      <div>
        <label class={labelClass}>{t.catalogLabel}</label>
        <div data-catalog-dropdown class="relative">
          <details class="group">
            <summary class="flex items-center justify-between gap-2 cursor-pointer list-none select-none px-3.5 py-2.5 rounded-lg bg-white/10 border border-white/15 hover:border-emerald-400 focus-within:border-emerald-400 focus-within:ring-2 focus-within:ring-emerald-400/25 transition">
              <span data-catalog-value-label data-placeholder={t.catalogPlaceholder} class="text-sm text-white/60 truncate">{t.catalogPlaceholder}</span>
              <svg class="w-4 h-4 shrink-0 text-white/50 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="absolute z-30 start-0 w-full mt-1.5 max-h-60 overflow-auto rounded-lg bg-[#0e2a22] border border-white/15 shadow-2xl p-2 space-y-0.5">
              {catalogOptions.map((opt) => (
                <label class="flex items-center gap-2.5 px-2.5 py-2 rounded-md hover:bg-white/10 cursor-pointer text-sm text-white/90">
                  <input type="checkbox" value={opt.slug} data-catalog-opt class="w-4 h-4 accent-emerald-400 shrink-0"/>
                  <span class="truncate">{opt.name}</span>
                </label>
              ))}
            </div>
          </details>
          <input type="hidden" name="catalog_categories" data-catalog-value/>
        </div>
      </div>
      {isRtl && (
        <div>
          <label class={labelClass}>{t.crLabel}</label>
          <input data-field="cr" type="text" name="cr_number" class={fieldClass}/>
        </div>
      )}
      <div>
        <label class={labelClass}>{t.companyLabel}</label>
        <input data-field="company" type="text" name="company_name" placeholder={t.companyPlaceholder} class={fieldClass}/>
      </div>
      <div>
        <label class={labelClass}>{t.bomLabel}</label>
        <textarea data-field="bom" name="bom_note" rows="5" placeholder={t.bomPlaceholder} class={fieldClass + ' resize-y'}></textarea>
      </div>
      <p data-catalog-status class="hidden text-xs leading-relaxed"></p>
      <div class="pt-2 space-y-2">
        <button type="submit" data-catalog-submit class="w-full py-3 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-[#0b1f19] font-bold text-sm transition-colors active:scale-[0.99] disabled:opacity-60 disabled:cursor-not-allowed">{t.submit}</button>
        <button type="button" data-catalog-close class="w-full py-2.5 rounded-lg bg-white/10 hover:bg-white/20 text-white/80 text-sm font-medium transition-colors">{t.cancel}</button>
      </div>
    </form>
  </div>
</div>

<script>
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const HINTS = {
    en: { required: 'Please fill in the required fields.', email: 'Please enter a valid work email.', generic: 'Something went wrong. Please try again.', success: 'Catalog request received. We will email the full PDF within 1 business day.' },
    es: { required: 'Complete los campos obligatorios.', email: 'Ingrese un correo corporativo valido.', generic: 'Ocurrio un error. Intentelo de nuevo.', success: 'Solicitud recibida. Le enviaremos el catalogo PDF completo en 1 dia habil.' },
    ar: { required: 'يرجى إكمال الحقول المطلوبة.', email: 'يرجى إدخال بريد إلكتروني للعمل صالح.', generic: 'حدث خطأ. يرجى المحاولة مرة أخرى.', success: 'تم استلام طلبك. سنرسل الكتالوج الكامل بصيغة PDF خلال يوم عمل واحد.' },
  };
  function hintsFor(form) { return HINTS[form.dataset.locale || 'en'] || HINTS.en; }
  function catalogOptionsSelected(dropdown) {
    if (!dropdown) return [];
    const checked = dropdown.querySelectorAll('[data-catalog-opt]:checked');
    return Array.prototype.map.call(checked, function (o) { return o.value; });
  }
  function updateDropdownLabel(dropdown) {
    if (!dropdown) return;
    const values = catalogOptionsSelected(dropdown);
    const label = dropdown.querySelector('[data-catalog-value-label]');
    const hidden = dropdown.querySelector('[data-catalog-value]');
    if (label) {
      if (values.length === 0) {
        label.textContent = (label.dataset.placeholder || '').trim() || label.dataset.placeholder || '';
      } else {
        label.textContent = values.length + ' selected';
      }
    }
    if (hidden) hidden.value = values.join(',');
  }
  function copyCatalogSelection(fromForm, toForm) {
    if (!fromForm || !toForm) return;
    const fromDd = fromForm.querySelector('[data-catalog-dropdown]');
    const toDd = toForm.querySelector('[data-catalog-dropdown]');
    if (!fromDd || !toDd) return;
    const fromValues = catalogOptionsSelected(fromDd);
    const set = fromValues.reduce(function (acc, v) { acc[v] = true; return acc; }, {});
    Array.prototype.forEach.call(toDd.querySelectorAll('[data-catalog-opt]'), function (cb) { cb.checked = !!set[cb.value]; });
    updateDropdownLabel(toDd);
  }
  function setStatus(form, message, ok) {
    const el = form.querySelector('[data-catalog-status]');
    if (!el) return;
    el.textContent = message;
    el.classList.remove('hidden', 'text-emerald-300', 'text-red-300');
    el.classList.add(ok ? 'text-emerald-300' : 'text-red-300');
  }
  function clearStatus(form) {
    const el = form.querySelector('[data-catalog-status]');
    if (!el) return;
    el.textContent = '';
    el.classList.add('hidden');
  }
  const modal = document.querySelector('[data-catalog-modal]');
  const backdrop = document.querySelector('[data-catalog-backdrop]');
  const panel = document.querySelector('[data-catalog-panel]');
  const quickForm = document.querySelector('form[data-catalog-form][data-catalog-mode="quick"]');
  const fullForm = document.querySelector('form[data-catalog-form][data-catalog-mode="full"]');
  function openModal() {
    if (!modal) return;
    modal.classList.remove('hidden');
    const email = quickForm && quickForm.querySelector('[data-field="email"]');
    const geo = quickForm && quickForm.querySelector('[data-field="geo"]');
    const fullEmail = fullForm && fullForm.querySelector('[data-field="email"]');
    const fullGeo = fullForm && fullForm.querySelector('[data-field="geo"]');
    if (fullEmail && email) fullEmail.value = email.value;
    if (fullGeo && geo) fullGeo.value = geo.value;
    copyCatalogSelection(quickForm, fullForm);
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(function () {
      if (backdrop) backdrop.classList.remove('opacity-0');
      if (panel) { panel.classList.remove('translate-x-full', 'rtl:-translate-x-full'); panel.classList.add('translate-x-0'); }
    });
    window.setTimeout(function () { const b = fullForm && fullForm.querySelector('[data-field="bom"]'); if (b) b.focus(); }, 320);
  }
  function closeModal() {
    if (!modal) return;
    if (backdrop) backdrop.classList.add('opacity-0');
    if (panel) { panel.classList.add('translate-x-full', 'rtl:-translate-x-full'); panel.classList.remove('translate-x-0'); }
    window.setTimeout(function () { modal.classList.add('hidden'); document.body.style.overflow = ''; }, 300);
  }
  document.querySelectorAll('[data-catalog-open]').forEach(function (btn) { btn.addEventListener('click', function (e) { e.preventDefault(); openModal(); }); });
  document.addEventListener('change', function (e) {
    const target = e.target;
    if (target && target.matches && target.matches('[data-catalog-opt]')) {
      const dd = target.closest('[data-catalog-dropdown]');
      updateDropdownLabel(dd);
    }
  });
  document.querySelectorAll('[data-catalog-close]').forEach(function (btn) { btn.addEventListener('click', closeModal); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) closeModal(); });
  document.querySelectorAll('form[data-catalog-form]').forEach(function (formEl) {
    const form = formEl;
    const submitBtn = form.querySelector('[data-catalog-submit]');
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      clearStatus(form);
      const hints = hintsFor(form);
      const emailInput = form.querySelector('[data-field="email"]');
      const geoInput = form.querySelector('[data-field="geo"]');
      const crInput = form.querySelector('[data-field="cr"]');
      const companyInput = form.querySelector('[data-field="company"]');
      const bomInput = form.querySelector('[data-field="bom"]');
      const catalogsDropdown = form.querySelector('[data-catalog-dropdown]');
      const email = (emailInput && emailInput.value || '').trim();
      const geo = (geoInput && geoInput.value || '').trim();
      if (!email || !geo) { setStatus(form, hints.required, false); return; }
      if (!EMAIL_RE.test(email)) { setStatus(form, hints.email, false); return; }
      if (catalogsDropdown) updateDropdownLabel(catalogsDropdown);
      const catalogCategories = catalogOptionsSelected(catalogsDropdown);
      const payload = {
        work_email: email,
        geo_value: geo,
        geo_kind: form.dataset.geoKind || 'zip',
        catalog_categories: catalogCategories,
        cr_number: (crInput && crInput.value || '').trim(),
        company_name: (companyInput && companyInput.value || '').trim(),
        bom_note: (bomInput && bomInput.value || '').trim(),
        scope_type: form.dataset.scopeType || 'category',
        scope_name: form.dataset.scopeName || '',
        request_locale: form.dataset.locale || 'en',
        honeypot_website: (form.querySelector('input[name="honeypot_website"]') || {}).value || '',
        submitted_at: Date.now(),
      };
      if (submitBtn) submitBtn.disabled = true;
      try {
        const res = await fetch('/api/catalog/request', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
        const data = await res.json().catch(function () { return {}; });
        if (res.ok && data.ok) {
          if (window.gtag) {
            gtag('event', 'generate_lead', {
              method: 'catalog_request',
            });
          }
          setStatus(form, hints.success, true);
          form.querySelectorAll('input, textarea').forEach(function (el) { if (el.type !== 'hidden') el.value = ''; });
          Array.prototype.forEach.call(form.querySelectorAll('[data-catalog-opt]'), function (cb) { cb.checked = false; });
          if (catalogsDropdown) updateDropdownLabel(catalogsDropdown);
          if (form.dataset.catalogMode === 'full') window.setTimeout(closeModal, 1800);
        } else {
          setStatus(form, data.message || hints.generic, false);
        }
      } catch (err) {
        setStatus(form, hints.generic, false);
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  });
</script>