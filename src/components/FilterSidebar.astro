---
interface TopicTerm {
  slug: string;
  name: string;
  totalProducts: number;
  children?: TopicTerm[];
}

interface Props {
  categories: { slug: string; name: string; totalProducts: number }[];
  topics: TopicTerm[];
}

const { categories = [], topics = [] } = Astro.props;
---

<!-- Mobile Filter Toggle Button -->
<button id="mobile-filter-toggle" class="lg:hidden fixed bottom-4 end-4 z-40 flex items-center gap-2 px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-full shadow-2xl font-bold text-sm transition-all duration-300 hover:scale-105 active:scale-95">
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
  </svg>
  <span>Filters</span>
</button>

<!-- Mobile Filter Overlay -->
<div id="mobile-filter-overlay" class="lg:hidden hidden fixed inset-0 bg-black/50 z-50">
  <div class="bg-white dark:bg-dark-900 w-full max-w-sm h-full ms-auto overflow-y-auto">
    <div class="sticky top-0 bg-white dark:bg-dark-900 border-b border-gray-200 dark:border-dark-700 p-4 flex items-center justify-between z-10">
      <h2 class="font-bold text-lg">Filters</h2>
      <button id="mobile-filter-close" class="p-2 hover:bg-gray-100 dark:hover:bg-dark-800 rounded-lg transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="p-4 space-y-6" id="mobile-filter-content">
      <!-- Filter content will be cloned here -->
    </div>
    <div class="sticky bottom-0 bg-white dark:bg-dark-900 border-t border-gray-200 dark:border-dark-700 p-4 flex gap-3">
      <button id="mobile-filter-clear" class="flex-1 py-3 bg-gray-200 dark:bg-dark-700 hover:bg-gray-300 dark:hover:bg-dark-600 rounded-xl font-semibold transition-colors text-sm">
        Clear All
      </button>
      <button id="mobile-filter-apply" class="flex-1 py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-xl font-semibold transition-colors text-sm">
        Apply Filters
      </button>
    </div>
  </div>
</div>

<!-- Desktop Sidebar - Touch-Friendly Inputs -->
<aside class="w-full lg:w-64 space-y-6 animate-on-scroll hidden lg:block" id="desktop-filters">
  <!-- Categories - Touch-Friendly -->
  <div class="bg-white dark:bg-dark-800 rounded-xl p-5 sm:p-6 border border-gray-200 dark:border-dark-700">
    <h3 class="font-bold text-base sm:text-lg mb-4">Categories</h3>
    <div class="space-y-3">
      {categories.length > 0 ? categories.map(category => (
        <label class="flex items-center gap-3 cursor-pointer group py-1">
          <input type="checkbox" value={category.slug} data-filter="category" class="w-5 h-5 accent-primary-600 rounded cursor-pointer" />
          <span class="text-sm group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">{category.name}</span>
          <span class="ms-auto text-xs text-gray-400">{category.totalProducts}</span>
        </label>
      )) : <p class="text-sm text-gray-400">No categories</p>}
    </div>
  </div>

  <!-- Topics - Touch-Friendly -->
  <div class="bg-white dark:bg-dark-800 rounded-xl p-5 sm:p-6 border border-gray-200 dark:border-dark-700">
    <h3 class="font-bold text-base sm:text-lg mb-4">Topics</h3>
    <div class="space-y-2">
      {topics.length > 0 ? topics.map(topic => (
        (topic.children && topic.children.length > 0) ? (
          <div class="topic-group border-b border-gray-100 dark:border-dark-700 last:border-0 pb-2 last:pb-0" data-topic-group>
            <button
              type="button"
              data-topic-toggle
              aria-expanded="true"
              class="w-full flex items-center gap-2 py-2 text-start group"
            >
              <span class="text-sm font-semibold text-gray-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">{topic.name}</span>
              <span class="text-xs text-gray-400">{topic.totalProducts}</span>
              <svg data-topic-chevron class="w-4 h-4 ms-auto text-gray-400 transition-transform duration-300 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div data-topic-panel class="space-y-2 ps-3 pt-1">
              {topic.children.map(child => (
                <label class="flex items-center gap-3 cursor-pointer group py-1">
                  <input type="checkbox" value={child.slug} data-filter="topic" class="w-5 h-5 accent-primary-600 rounded cursor-pointer" />
                  <span class="text-sm group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">{child.name}</span>
                  <span class="ms-auto text-xs text-gray-400">{child.totalProducts}</span>
                </label>
              ))}
            </div>
          </div>
        ) : (
          <label class="flex items-center gap-3 cursor-pointer group py-1">
            <input type="checkbox" value={topic.slug} data-filter="topic" class="w-5 h-5 accent-primary-600 rounded cursor-pointer" />
            <span class="text-sm group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">{topic.name}</span>
            <span class="ms-auto text-xs text-gray-400">{topic.totalProducts}</span>
          </label>
        )
      )) : <p class="text-sm text-gray-400">No topics</p>}
    </div>
  </div>

  <!-- Clear Filters - Touch-Friendly -->
  <button data-filter-clear class="w-full py-3 sm:py-3.5 bg-gray-200 dark:bg-dark-700 hover:bg-gray-300 dark:hover:bg-dark-600 rounded-xl font-semibold transition-colors duration-300 text-sm sm:text-base active:scale-95">
    Clear All Filters
  </button>
</aside>

<script>
  const desktopFilters = document.getElementById('desktop-filters');
  const mobileFilterOverlay = document.getElementById('mobile-filter-overlay');
  const mobileFilterContent = document.getElementById('mobile-filter-content');

  interface FilterState {
    category: string[];
    topic: string[];
  }

  function readState(container: HTMLElement | null): FilterState {
    const state: FilterState = { category: [], topic: [] };
    if (!container) return state;
    container.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((checkbox) => {
      if (!checkbox.checked) return;
      const kind = checkbox.dataset.filter;
      if (kind === 'category') state.category.push(checkbox.value);
      else if (kind === 'topic') state.topic.push(checkbox.value);
    });
    return state;
  }

  function cardMatches(card: HTMLElement, state: FilterState): boolean {
    const slugsOf = (attr: string): string[] => (card.dataset[attr] ?? '').split(/\s+/).filter(Boolean);

    if (state.category.length > 0) {
      const cardCategories = slugsOf('productCategory');
      if (!state.category.some((slug) => cardCategories.includes(slug))) return false;
    }

    if (state.topic.length > 0) {
      const cardTopics = slugsOf('productTopic');
      if (!state.topic.some((slug) => cardTopics.includes(slug))) return false;
    }

    return true;
  }

  function applyFilters(): void {
    const grid = document.querySelector<HTMLElement>('[data-filter-grid]');
    if (!grid) return;
    const state = readState(desktopFilters);
    let visible = 0;

    grid.querySelectorAll<HTMLElement>('[data-product-card]').forEach((card) => {
      const matched = cardMatches(card, state);
      const wrapper = card.parentElement && card.parentElement !== grid ? card.parentElement : card;
      wrapper.classList.toggle('hidden', !matched);
      if (matched) visible += 1;
    });

    document.querySelectorAll('[data-filter-count]').forEach((el) => {
      el.textContent = String(visible);
    });

    const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
    empty?.classList.toggle('hidden', visible > 0);
  }

  function syncMobileToDesktop(): void {
    if (!desktopFilters || !mobileFilterContent) return;
    const mobileCheckboxes = mobileFilterContent.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
    mobileCheckboxes.forEach((mobileCheckbox) => {
      const kind = mobileCheckbox.dataset.filter;
      if (!kind) return;
      desktopFilters
        .querySelectorAll<HTMLInputElement>(`input[type="checkbox"][data-filter="${kind}"][value="${mobileCheckbox.value}"]`)
        .forEach((desktopCheckbox) => {
          desktopCheckbox.checked = mobileCheckbox.checked;
        });
    });
  }

  function clearAll(): void {
    document
      .querySelectorAll<HTMLInputElement>('[data-filter="category"], [data-filter="topic"]')
      .forEach((checkbox) => {
        checkbox.checked = false;
      });
    applyFilters();
  }

  // Any checkbox change re-applies the filters immediately.
  document.addEventListener('change', (e) => {
    const checkbox = (e.target as HTMLElement)?.closest<HTMLInputElement>('input[type="checkbox"][data-filter]');
    if (!checkbox) return;
    applyFilters();
  });

  // Clear All Filters button.
  document.addEventListener('click', (e) => {
    const clear = (e.target as HTMLElement)?.closest('[data-filter-clear]');
    if (!clear) return;
    clearAll();
  });

  // Mobile Filter Toggle
  const mobileFilterToggle = document.getElementById('mobile-filter-toggle');
  const mobileFilterClose = document.getElementById('mobile-filter-close');
  const mobileFilterApply = document.getElementById('mobile-filter-apply');
  const mobileFilterClear = document.getElementById('mobile-filter-clear');

  // Clone desktop filters to mobile on first open
  let filtersCloned = false;

  mobileFilterToggle?.addEventListener('click', () => {
    if (!filtersCloned && desktopFilters && mobileFilterContent) {
      mobileFilterContent.innerHTML = desktopFilters.innerHTML;
      filtersCloned = true;
    }
    mobileFilterOverlay?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  });

  mobileFilterClose?.addEventListener('click', () => {
    mobileFilterOverlay?.classList.add('hidden');
    document.body.style.overflow = '';
  });

  mobileFilterApply?.addEventListener('click', () => {
    syncMobileToDesktop();
    mobileFilterOverlay?.classList.add('hidden');
    document.body.style.overflow = '';
    applyFilters();
  });

  mobileFilterClear?.addEventListener('click', () => {
    mobileFilterContent?.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((checkbox) => {
      checkbox.checked = false;
    });
    clearAll();
  });

  mobileFilterOverlay?.addEventListener('click', (e) => {
    if (e.target === mobileFilterOverlay) {
      mobileFilterOverlay.classList.add('hidden');
      document.body.style.overflow = '';
    }
  });

  // Topic groups: level-1 term is the heading, level-2 terms are the options.
  // Delegated so the desktop panel and its cloned mobile copy both respond.
  document.addEventListener('click', (e) => {
    const toggle = (e.target as HTMLElement)?.closest('[data-topic-toggle]');
    if (!toggle) return;
    const group = toggle.closest('[data-topic-group]');
    const panel = group?.querySelector('[data-topic-panel]');
    const chevron = group?.querySelector('[data-topic-chevron]');
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
    panel?.classList.toggle('hidden', expanded);
    chevron?.classList.toggle('rotate-180', !expanded);
  });
</script>