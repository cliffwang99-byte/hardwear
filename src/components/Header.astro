            </svg>
          </button>
        </div>
        
        <!-- Main Navigation -->
        <nav class="p-4" style="display: block; visibility: visible;">
          <div class="mb-2">
            <p class="px-3 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">Categories</p>
            <ul class="space-y-1" style="display: block; visibility: visible;">
              <NavMenu items={navItems} variant="mobile" />
              <li>
                <a href={localizeUrl("/cart")} class="group flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-gray-100 dark:hover:bg-dark-800 transition-all text-gray-900 dark:text-white relative">
