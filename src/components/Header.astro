          <p class="text-xs text-gray-500 dark:text-gray-400 text-center">
            © 2026 MrKB. All rights reserved.
          </p>
        </div>
      </div>
    </div>

    <!-- Navigation with Smooth Animated Underline - Desktop Only -->
