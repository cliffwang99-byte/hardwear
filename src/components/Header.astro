                <a href={localizeUrl("/track-order")} class="group flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-gray-100 dark:hover:bg-dark-800 transition-all text-gray-900 dark:text-white relative">
                  <span class="absolute start-0 top-0 bottom-0 w-1 bg-primary-600 rounded-e opacity-0 group-hover:opacity-100 transition-opacity"></span>
