---
import { getMenu, getTaxonomyTerms, type MenuItem } from "emdash";
import NavMenu from "./NavMenu.astro";
import { localizePath } from "../lib/i18n";

const currentLocale = Astro.currentLocale ?? "en";

function localizeUrl(url: string): string {
  return localizePath(url, currentLocale);
}

function termToMenuItem(term: {
  id: string;
  label: string;
  slug: string;
  children?: any[];
}): MenuItem {
  return {
    id: term.id,
    label: term.label,
    url: localizeUrl(`/categories/${term.slug}`),
    children: (term.children ?? []).map(termToMenuItem),
  };
}

// 递归为所有菜单项 url 添加语种前缀
function localizeMenuItems(items: MenuItem[]): MenuItem[] {
  return items.map((item) => ({
    ...item,
    url: localizeUrl(item.url),
    children: item.children ? localizeMenuItems(item.children) : item.children,
  }));
}

let navItems: MenuItem[] = [];

try {
  const primary = await getMenu("primary");
  navItems = localizeMenuItems(primary?.items ?? []);
} catch {
  navItems = [];
}

if (navItems.length === 0) {
  try {
    const terms = await getTaxonomyTerms("collection", { includeCounts: false });
    navItems = terms.map(termToMenuItem);
  } catch {
    navItems = [];
  }
}
---

