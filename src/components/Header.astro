    <!-- Mobile Menu Overlay - PREMIUM POLISH -->
    <div id="mobile-menu-overlay" class="hidden lg:hidden fixed inset-0 z-[60]" style="display: none;">
      <!-- Backdrop - Darker & Blur -->
      <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
      
      <!-- Menu Drawer - Full Screen on Small Devices -->
      <div class="absolute start-0 top-0 h-full w-full sm:w-[420px] sm:max-w-[85vw] bg-white dark:bg-dark-900 shadow-2xl overflow-y-auto" style="min-height: 100vh;">
        <!-- Header - Sticky with Close -->
        <div class="sticky top-0 p-4 border-b border-gray-200 dark:border-dark-700 flex items-center justify-end bg-white dark:bg-dark-900 z-10">
          <button id="mobile-menu-close" class="p-2 hover:bg-gray-100 dark:hover:bg-dark-800 rounded-lg transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
