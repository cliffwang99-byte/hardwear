---
import type { ShopProductDetail, ShopProduct } from "../lib/shop";

interface Props {
  product: ShopProductDetail;
  bundledProducts?: ShopProduct[];
}

const { product, bundledProducts = [] } = Astro.props;

const parseOpts = (str?: string): string[] =>
  str ? str.split(",").map((s) => s.trim()).filter(Boolean) : [];

const materials = parseOpts(product.optCabinetMaterial);
const tops = parseOpts(product.optCountertop);
const basins = parseOpts(product.optBasin);
const holes = parseOpts(product.optFaucetHole);
const drainages = parseOpts(product.optDrainageType);

// —— 柜体二级色板（Color Swatch）——
// 后台格式："[Oak] Tasmanian Oak | oak.webp, [Walnut] American Walnut, PVD Brushed Gold"
// 规则：逗号分隔选项；"[Dep] 名称 | 自定义色卡图.webp"；无自定义图时自动 `public/swatches/{slug}.webp`。

// 兜底纯色表：色卡图片未上传时平滑降级为色号圆点，绝不出现破图。
const FALLBACK_COLORS: Record<string, string> = {
  oak: "#C8A97E",
  walnut: "#5C4033",
  white: "#F5F7FA",
  grey: "#6B7280",
  gray: "#6B7280",
  black: "#1F2937",
  gold: "#D4AF37",
  chrome: "#D6DDE5",
  gunmetal: "#374151",
  silver: "#C0C8D1",
  brass: "#B08D57",
  bronze: "#8C6B3F",
};

const toSlug = (s: string): string =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

const getFallbackHex = (text: string): string => {
  const lower = text.toLowerCase();
  const hit = Object.keys(FALLBACK_COLORS).find((k) => lower.includes(k));
  return hit ? FALLBACK_COLORS[hit] : "#D1D5DB";
};

interface SwatchOption {
  dep: string; // 关联的一级材质（如 "Oak"），空 = 始终显示
  name: string; // 颜色名（如 "Tasmanian Oak"）
  swatchUrl: string; // 色卡图 URL（无图时用于 onerror 判空）
  fallbackHex: string; // 兜底色号
  slug: string; // 颜色名 slug，用于主图匹配
  hasImg: boolean;
}

const parseFinishes = (raw?: string): SwatchOption[] => {
  const out: SwatchOption[] = [];
  const parts = raw ? raw.split(",").map((s) => s.trim()).filter(Boolean) : [];
  for (const part of parts) {
    const matched = part.match(/^\[(.*?)\]\s*(.*)$/);
    const dep = matched ? matched[1].trim() : "";
    const body = matched ? matched[2].trim() : part;
    const [nameRaw, customImg] = body.split("|").map((s) => s.trim());
    if (!nameRaw) continue;
    const name = nameRaw.trim();
    const slug = toSlug(name);
    out.push({
      dep,
      name,
      swatchUrl: customImg || `/swatches/${slug}.webp`,
      fallbackHex: getFallbackHex(name),
      slug,
      hasImg: !customImg,
    });
  }
  return out;
};

const finishes = parseFinishes(product.optCabinetFinish);

// 图库缩略图工程角标（数量不足时按实际图片数截断）
const galleryLabels = [
  "Main View",
  "2D Cutout CAD",
  "U-Drawer",
  "Core Material",
  "Color Match",
  "FCL Pack",
];
const images = (product.images && product.images.length ? product.images : [product.image]).filter(Boolean);
---

<!-- 首屏双栏：左 40% 工程视觉与图纸区 + 右 60% 定制配置控制台 -->
<div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-start mb-16">
  <!-- 左侧 (2/5 = 40%) -->
  <div class="lg:col-span-2 space-y-4 animate-slide-up">
    <div class="relative aspect-square rounded-2xl overflow-hidden bg-gray-100 dark:bg-dark-800 border border-gray-200 dark:border-dark-700">
      <img
        id="vanity-main-img"
        src={images[0]}
        alt={product.name}
        class="w-full h-full object-contain"
      />
    </div>

    <!-- 带工程识别标签的缩略图切换条 -->
    {images.length > 1 && (
      <div class="grid grid-cols-3 sm:grid-cols-6 gap-2">
        {images.slice(0, galleryLabels.length).map((imgUrl, idx) => (
          <button
            type="button"
            class="vanity-thumb-btn group border border-gray-200 dark:border-dark-700 hover:border-primary-600 dark:hover:border-primary-600 rounded-lg p-1.5 text-left transition-colors"
            data-src={imgUrl}
          >
            <span class="block aspect-square overflow-hidden rounded-md bg-gray-100 dark:bg-dark-900">
              <img src={imgUrl} alt={galleryLabels[idx] ?? `View ${idx + 1}`} class="w-full h-full object-cover" />
            </span>
            <span class="block text-[11px] font-medium text-gray-700 dark:text-gray-300 mt-1.5 truncate">
              {galleryLabels[idx] ?? `View ${idx + 1}`}
            </span>
          </button>
        ))}
      </div>
    )}

    <!-- 无品牌 2D CAD & Spec Sheet 下载钩子 -->
    {product.cadSpecPdfUrl && (
      <div class="bg-gray-50 dark:bg-dark-800 border border-gray-200 dark:border-dark-700 rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <p class="text-sm font-semibold text-gray-900 dark:text-white">Submittal-Ready 2D CAD &amp; Plumbing Rough-In Spec</p>
          <p class="text-xs text-gray-600 dark:text-gray-400 mt-0.5">Includes rear back-panel cutout dimensions &amp; U-shaped drawer clearance.</p>
        </div>
        <a
          href={product.cadSpecPdfUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center px-4 py-2 border border-gray-900 dark:border-white text-xs font-semibold text-gray-900 dark:text-white rounded-lg hover:bg-gray-900 dark:hover:bg-white hover:text-white dark:hover:text-gray-900 transition shrink-0"
        >
          Download Spec PDF
        </a>
      </div>
    )}
  </div>

  <!-- 右侧 (3/5 = 60%)：定制配置控制台 -->
  <div class="lg:col-span-3 border border-gray-200 dark:border-dark-700 rounded-2xl p-6 bg-white dark:bg-dark-800 shadow-sm animate-slide-up" style="animation-delay: 0.1s;">
    <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400 mb-2">
      <span>SKU: <strong class="text-gray-800 dark:text-gray-200">{product.sku}</strong></span>
      <span class="px-2 py-0.5 bg-gray-100 dark:bg-dark-700 text-gray-800 dark:text-gray-200 font-medium rounded">Spec-Grade B2B</span>
    </div>

    <h1 class="text-2xl font-bold text-gray-900 dark:text-white leading-snug">{product.name}</h1>
    {product.description && <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">{product.description}</p>}

    <!-- 价格隐藏协议占位符 -->
    <div class="mt-4 pb-4 border-b border-gray-200 dark:border-dark-700 flex items-center justify-between">
      <div>
        <span class="font-mono text-xl font-bold text-gray-900 dark:text-white">$??.?? / Set</span>
        <span class="ml-2 inline-flex items-center px-2 py-0.5 text-xs font-medium bg-amber-50 dark:bg-amber-900/30 text-amber-800 dark:text-amber-400 border border-amber-200 dark:border-amber-800 rounded">
          🔒 Protected
        </span>
      </div>
      <span class="text-xs text-gray-500 dark:text-gray-400">FOB / CIF · FCL Consolidation</span>
    </div>

    <!-- 定制表单 -->
    <form id="vanity-quote-form" class="mt-5 space-y-5">
      <!-- STEP 1 区域标题：H3 支持 config_section_title 扁平字段配置（未配置回退默认） -->
      <div class="border-l-2 border-primary-600 pl-3">
        <div class="flex items-center gap-2">
          <span class="px-1.5 py-0.5 rounded bg-primary-600/10 text-primary-700 dark:text-primary-400 text-[10px] font-bold uppercase tracking-wider">
            Step 1
          </span>
          <h3 class="text-sm font-bold text-gray-900 dark:text-white">
            {product.configSectionTitle || "Customize Your Vanity"}
          </h3>
        </div>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
          Pick your board, finish, countertop, and basin for OEM production.
        </p>
      </div>

      <!-- 1. 柜体材质 -->
      {materials.length > 0 && (
        <div>
          <label class="block text-xs font-semibold text-gray-800 dark:text-gray-200 mb-1.5">Cabinet Material &amp; Finish</label>
          <div class="flex flex-wrap gap-2">
            {materials.map((item, i) => (
              <label class="cursor-pointer">
                <input type="radio" name="opt_material" value={item} checked={i === 0} class="peer sr-only" />
                <span class="inline-block px-3 py-1.5 border border-gray-300 dark:border-dark-600 rounded-lg text-xs font-medium text-gray-700 dark:text-gray-300 peer-checked:border-primary-600 peer-checked:bg-primary-600 peer-checked:text-white dark:peer-checked:text-white transition">
                  {item}
                </span>
              </label>
            ))}
          </div>
        </div>
      )}

      <!-- 1.5 柜体颜色色板（二级定制，按材质联动；色卡图缺图自动兜底） -->
      {finishes.length > 0 && (
        <div id="finish-swatch-group">
          <div class="flex items-center justify-between mb-1.5">
            <label class="block text-xs font-semibold text-gray-800 dark:text-gray-200">Cabinet Color / Wood Veneer</label>
            <span class="selected-swatch-name text-xs font-medium text-gray-500 dark:text-gray-400 truncate max-w-[55%]">
              {finishes[0].name}
            </span>
          </div>
          <div id="finish-swatch-options" class="flex flex-wrap gap-2">
            {finishes.map((sw, i) => (
              <label
                class="cursor-pointer finish-swatch-option"
                data-dep={sw.dep.toLowerCase()}
                data-slug={sw.slug}
              >
                <input
                  type="radio"
                  name="opt_finish"
                  value={sw.name}
                  checked={i === 0}
                  class="peer sr-only"
                />
                <span
                  class="inline-flex items-center gap-2 px-2 py-1.5 pr-3 border border-gray-300 dark:border-dark-600 rounded-lg bg-white dark:bg-dark-900 peer-checked:border-primary-600 peer-checked:ring-1 peer-checked:ring-primary-600 transition"
                >
                  <span
                    class="w-7 h-7 rounded border border-gray-200 dark:border-dark-600 overflow-hidden shrink-0 block"
                    style={`background-color: ${sw.fallbackHex}`}
                  >
                    <img
                      src={sw.swatchUrl}
                      alt={sw.name}
                      loading="lazy"
                      class="w-full h-full object-cover"
                      onerror="this.style.display='none'"
                    />
                  </span>
                  <span class="text-xs font-medium text-gray-700 dark:text-gray-300">{sw.name}</span>
                </span>
              </label>
            ))}
          </div>
        </div>
      )}

      <!-- 2. 台面选项 -->
      {tops.length > 0 && (
        <div>
          <label class="block text-xs font-semibold text-gray-800 dark:text-gray-200 mb-1.5">Countertop Option</label>
          <div class="flex flex-wrap gap-2">
            {tops.map((item, i) => (
              <label class="cursor-pointer">
                <input type="radio" name="opt_top" value={item} checked={i === 0} class="peer sr-only" />
                <span class="inline-block px-3 py-1.5 border border-gray-300 dark:border-dark-600 rounded-lg text-xs font-medium text-gray-700 dark:text-gray-300 peer-checked:border-primary-600 peer-checked:bg-primary-600 peer-checked:text-white dark:peer-checked:text-white transition">
                  {item}
                </span>
              </label>
            ))}
          </div>
        </div>
      )}

      <!-- 3. 面盆选项 -->
      {basins.length > 0 && (
        <div>
          <label class="block text-xs font-semibold text-gray-800 dark:text-gray-200 mb-1.5">Basin Option</label>
          <div class="flex flex-wrap gap-2">
            {basins.map((item, i) => (
              <label class="cursor-pointer">
                <input type="radio" name="opt_basin" value={item} checked={i === 0} class="peer sr-only" />
                <span class="inline-block px-3 py-1.5 border border-gray-300 dark:border-dark-600 rounded-lg text-xs font-medium text-gray-700 dark:text-gray-300 peer-checked:border-primary-600 peer-checked:bg-primary-600 peer-checked:text-white dark:peer-checked:text-white transition">
                  {item}
                </span>
              </label>
            ))}
          </div>
        </div>
      )}

      <!-- 5. 排水方式（工程术语 + 大白话括号说明；Wall 为默认第 1 项，覆盖欧美澳中东新装，拉美/翻新切 Floor） -->
      {drainages.length > 0 && (
        <div>
          <label class="block text-xs font-semibold text-gray-800 dark:text-gray-200 mb-1.5">Drainage Type</label>
          <div class="flex flex-wrap gap-2">
            {drainages.map((item, i) => (
              <label class="cursor-pointer">
                <input type="radio" name="opt_drain" value={item} checked={i === 0} class="peer sr-only" />
                <span class="inline-block px-3 py-1.5 border border-gray-300 dark:border-dark-600 rounded-lg text-xs font-medium text-gray-700 dark:text-gray-300 peer-checked:border-primary-600 peer-checked:bg-primary-600 peer-checked:text-white dark:peer-checked:text-white transition">
                  {item}
                </span>
              </label>
            ))}
          </div>
        </div>
      )}

      <!-- 6. 台面龙头开孔（选 No Top 时自动禁用） -->
      {holes.length > 0 && (
        <div id="faucet-hole-group">
          <div class="flex items-center justify-between mb-1.5">
            <label class="block text-xs font-semibold text-gray-800 dark:text-gray-200">Faucet Hole Drilling</label>
            <span id="faucet-hole-na-tip" class="hidden text-[11px] text-amber-700 dark:text-amber-400 font-medium">
              N/A (Customer-Supplied Top)
            </span>
          </div>
          <div id="faucet-hole-options" class="flex flex-wrap gap-2">
            {holes.map((item, i) => (
              <label class="cursor-pointer">
                <input type="radio" name="opt_hole" value={item} checked={i === 0} class="peer sr-only" />
                <span class="inline-block px-3 py-1.5 border border-gray-300 dark:border-dark-600 rounded-lg text-xs font-medium text-gray-700 dark:text-gray-300 peer-checked:border-primary-600 peer-checked:bg-primary-600 peer-checked:text-white dark:peer-checked:text-white transition">
                  {item}
                </span>
              </label>
            ))}
          </div>
        </div>
      )}

      <!-- STEP 2: 跨厂水暖加购区 -->
      {bundledProducts.length > 0 && (
        <div class="pt-4 border-t border-gray-200 dark:border-dark-700 space-y-2.5">
          <div class="border-l-2 border-emerald-600 pl-3">
            <div class="flex items-center gap-2">
              <span class="px-1.5 py-0.5 rounded bg-emerald-600/10 text-emerald-700 dark:text-emerald-400 text-[10px] font-bold uppercase tracking-wider">
                Step 2
              </span>
              <h3 class="text-sm font-bold text-gray-900 dark:text-white">Cross-Factory Hardware Bundle</h3>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
              Pack inside vanity cavities — $0 extra ocean freight &amp; color-match within Delta E &lt; 1.5.
            </p>
          </div>

          <div class="space-y-2">
            {bundledProducts.map((addon) => (
              <label class="flex items-center justify-between p-2.5 border border-gray-200 dark:border-dark-700 rounded-lg hover:border-primary-600 dark:hover:border-primary-600 cursor-pointer transition">
                <div class="flex items-center gap-2.5 min-w-0">
                  <input
                    type="checkbox"
                    name="bundled_addon"
                    data-sku={addon.sku ?? ""}
                    data-title={addon.name}
                    data-image={addon.image}
                    data-id={addon.id}
                    data-price={addon.price}
                    class="w-4 h-4 rounded border-gray-300 dark:border-dark-600 text-primary-600 focus:ring-primary-600 flex-shrink-0"
                  />
                  {addon.image && (
                    <img
                      src={addon.image}
                      alt={addon.name}
                      class="w-10 h-10 object-cover rounded border border-gray-100 dark:border-dark-700 flex-shrink-0"
                    />
                  )}
                  <div class="min-w-0">
                    <p class="text-xs font-semibold text-gray-900 dark:text-white leading-tight truncate">{addon.name}</p>
                    <p class="text-[11px] text-gray-500 dark:text-gray-400">SKU: {addon.sku}</p>
                  </div>
                </div>
                <span class="font-mono text-xs font-semibold text-gray-700 dark:text-gray-300 shrink-0">$??.?? 🔒</span>
              </label>
            ))}
          </div>
        </div>
      )}

      <!-- 工程起订量与唯一转化按钮 -->
      <div class="pt-4 border-t border-gray-200 dark:border-dark-700">
        <!-- 项目特殊定制备注：默认折叠，展开填写（非必填） -->
        <details class="group mb-3 border border-gray-200 dark:border-dark-700 rounded-lg transition-colors">
          <summary class="px-3 py-2 flex items-center justify-between cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
            <span class="text-xs font-semibold text-gray-700 dark:text-gray-300">
              Custom Project Notes / OEM Specs
              <span class="text-[10px] font-normal text-gray-400 dark:text-gray-500 ml-1">(Optional)</span>
            </span>
            <svg class="w-3.5 h-3.5 text-gray-400 dark:text-gray-500 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M5 8l5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <div class="px-3 pb-3">
            <textarea
              id="vanity-notes"
              name="notes"
              rows="3"
              placeholder="e.g. Custom dimensions, brand logo embossing, special cutout positions, mixed specs per set..."
              class="w-full px-3 py-2 border border-gray-300 dark:border-dark-600 rounded-lg text-xs leading-relaxed text-gray-800 dark:text-gray-200 bg-white dark:bg-dark-900 resize-y focus:outline-none focus:border-primary-600 focus:ring-1 focus:ring-primary-600"
            ></textarea>
            <p class="text-[10px] text-gray-400 dark:text-gray-500 mt-1">Attached to your quote BOM so our engineers can review your non-standard requirements.</p>
          </div>
        </details>

        <div class="flex items-center gap-3 mb-3">
          <label for="vanity-qty" class="text-xs font-semibold text-gray-700 dark:text-gray-300">Project Qty (Sets):</label>
          <input
            id="vanity-qty"
            name="qty"
            type="number"
            min="10"
            value="50"
            class="w-24 px-2.5 py-1.5 border border-gray-300 dark:border-dark-600 rounded-lg text-sm font-semibold text-gray-900 dark:text-white bg-white dark:bg-dark-900"
          />
          <span class="text-xs text-gray-500 dark:text-gray-400">Standard MOQ: 50 Sets</span>
        </div>

        <button
          id="vanity-add-btn"
          type="submit"
          class="w-full py-3.5 px-5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-bold rounded-xl transition-all duration-300 hover:shadow-lg transform hover:scale-105 active:scale-95"
        >
          + Add Selected to Quote List
        </button>
        <p id="quote-feedback-msg" class="hidden text-xs text-emerald-700 dark:text-emerald-400 font-semibold text-center mt-2">
          Added to your Quote List. Open Quote List at top right to submit BOM.
        </p>
      </div>
    </form>
  </div>
</div>

<!-- 移动端底部吸底转化条 -->
<div class="fixed bottom-0 inset-x-0 bg-white dark:bg-dark-900 border-t border-gray-200 dark:border-dark-700 px-4 py-2.5 flex items-center justify-between lg:hidden z-40 shadow-[0_-4px_12px_rgba(0,0,0,0.05)]">
  <div>
    <span class="font-mono text-sm font-bold text-gray-900 dark:text-white">$??.?? / Set 🔒</span>
    <span class="block text-[11px] text-gray-500 dark:text-gray-400">MOQ: 50 Sets · FCL Direct</span>
  </div>
  <button
    id="vanity-sticky-add"
    type="button"
    class="px-4 py-2.5 bg-primary-600 active:bg-primary-700 text-white text-xs font-bold rounded-xl"
  >
    + Add to Quote List
  </button>
</div>

<script define:vars={{ product }}>
  // 1. 图库缩略图切换
  document.querySelectorAll(".vanity-thumb-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const mainImg = document.getElementById("vanity-main-img");
      if (mainImg && btn.dataset.src) mainImg.src = btn.dataset.src;
    });
  });

  // 2. No Top 与台面开孔防呆联动
  const topRadios = document.querySelectorAll('input[name="opt_top"]');
  const holeOptionsBox = document.getElementById("faucet-hole-options");
  const holeNaTip = document.getElementById("faucet-hole-na-tip");

  const syncHoleState = () => {
    const selectedTop = document.querySelector('input[name="opt_top"]:checked')?.value || "";
    const isNoTop = selectedTop.toLowerCase().includes("no top");
    if (holeOptionsBox && holeNaTip) {
      holeOptionsBox.classList.toggle("opacity-40", isNoTop);
      holeOptionsBox.classList.toggle("pointer-events-none", isNoTop);
      holeNaTip.classList.toggle("hidden", !isNoTop);
    }
  };
  topRadios.forEach((r) => r.addEventListener("change", syncHoleState));
  syncHoleState();

  // 2.5 柜体颜色色板联动：材质切换 → 过滤色板；选中色板 → 切换左侧主图
  // 所有图库图片（含首图），用于按颜色名匹配主图；匹配不到回退当前/首图
  const vanityImages = (product.images && product.images.length ? product.images : [product.image]).filter(Boolean);
  const mainImgEl = document.getElementById("vanity-main-img");
  const swatchOptions = document.querySelectorAll(".finish-swatch-option");
  const swatchNameBadge = document.querySelector(".selected-swatch-name");
  const materialRadios = document.querySelectorAll('input[name="opt_material"]');
  const finishSwatchGroup = document.getElementById("finish-swatch-group");

  const toSlug = (s) => (s || "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

  // 在图片 URL 文件名里匹配颜色关键词（如 "walnut"），找不到返回空
  const matchColorImage = (slug) => {
    if (!slug) return "";
    for (let k = 0; k < vanityImages.length; k++) {
      const base = (vanityImages[k].split("/").pop() || vanityImages[k]).toLowerCase();
      if (base.includes(slug)) return vanityImages[k];
    }
    return "";
  };

  // 主图镜像：优先当前选中的色板匹配图，失败则保留现有主图（不回退跳变）
  const syncMainImage = () => {
    const checkedFinish = document.querySelector('input[name="opt_finish"]:checked');
    if (!checkedFinish || !mainImgEl) return;
    const chosen = matchColorImage(toSlug(checkedFinish.value));
    if (chosen) mainImgEl.src = chosen;
  };

  const syncSwatchOptions = () => {
    if (!finishSwatchGroup || !swatchOptions.length) return;
    const selectedMaterial = (document.querySelector('input[name="opt_material"]:checked')?.value || "").toLowerCase();

    let firstVisible = null;
    let hasCheckedVisible = false;

    swatchOptions.forEach((optEl) => {
      const dep = (optEl.dataset.dep || "").toLowerCase();
      const visible = !dep || dep === selectedMaterial;
      optEl.style.display = visible ? "" : "none";
      const input = optEl.querySelector("input");
      if (!input) return;
      if (visible) {
        if (!firstVisible) firstVisible = input;
        if (input.checked) hasCheckedVisible = true;
      } else {
        input.checked = false;
      }
    });

    // 无任何匹配色板 → 整组隐藏；否则若当前无选中则自动选第一个可见项
    if (!firstVisible) {
      finishSwatchGroup.style.display = "none";
      return;
    }
    finishSwatchGroup.style.display = "";
    if (!hasCheckedVisible) firstVisible.checked = true;

    // 同步右上角当前选中色板名
    const active = document.querySelector('input[name="opt_finish"]:checked');
    if (swatchNameBadge && active) swatchNameBadge.textContent = active.value;

    syncMainImage();
  };

  materialRadios.forEach((r) => r.addEventListener("change", syncSwatchOptions));
  swatchOptions.forEach((optEl) => {
    const input = optEl.querySelector("input");
    if (input) input.addEventListener("change", syncMainImage);
  });
  syncSwatchOptions();

  // 3. 扁平写入 localStorage['cart']（沿用现有询价清单机制，与 Header 角标 / Quote List 页联动）
  const form = document.getElementById("vanity-quote-form");
  const addBtn = document.getElementById("vanity-add-btn");
  const stickyBtn = document.getElementById("vanity-sticky-add");

  function readCart() {
    try {
      var c = JSON.parse(localStorage.getItem("cart") || "[]");
      return Array.isArray(c) ? c : [];
    } catch (err) {
      return [];
    }
  }

  function pushItem(cart, item, qty) {
    if (!item.key) return;
    var existing = null;
    for (var i = 0; i < cart.length; i++) {
      if (cart[i].key === item.key) { existing = cart[i]; break; }
    }
    if (existing) {
      existing.quantity += qty;
      if (item.bundleOf) existing.bundleOf = item.bundleOf;
    }
    else cart.push({ ...item, quantity: qty });
  }

  function updateCounts(cart) {
    var count = 0;
    for (var i = 0; i < cart.length; i++) count += Number(cart[i].quantity) || 0;
    var counters = document.querySelectorAll("[data-cart-count]");
    for (var k = 0; k < counters.length; k++) counters[k].textContent = count.toString();
  }

  function submitSelection(e) {
    if (e) e.preventDefault();
    var fd = new FormData(form);
    var qty = Math.max(1, parseInt(fd.get("qty") || "50", 10));
    var selectedTop = fd.get("opt_top") || "";
    var isNoTop = selectedTop.toLowerCase().includes("no top");
    var selectedFinish = fd.get("opt_finish") || "";

    var customSpec = [
      fd.get("opt_material") ? "Material: " + fd.get("opt_material") : "",
      selectedFinish ? "Finish: " + selectedFinish : "",
      selectedTop ? "Top: " + selectedTop : "",
      fd.get("opt_basin") ? "Basin: " + fd.get("opt_basin") : "",
      fd.get("opt_drain") ? "Drainage: " + fd.get("opt_drain") : "",
      !isNoTop && fd.get("opt_hole") ? "Hole: " + fd.get("opt_hole") : "",
    ].filter(Boolean).join(" | ");

    // 镜像主图：优先当前选中的 Finish 匹配到的颜色主图，否则回退首图
    var img = ((document.getElementById("vanity-main-img") || {}).src) || (product.images && product.images[0]) || product.image || "";
    var notes = fd.get("notes") ? String(fd.get("notes")).trim() : "";
    var sku = product.sku || product.id;
    var cart = readCart();

    // 写入主浴室柜条目（key 与标准页一致：id|sku）
    pushItem(cart, {
      key: product.id + "|" + sku,
      id: product.id,
      name: product.name,
      sku: sku,
      variant: customSpec || "Standard Vanity Spec",
      notes: notes || "",
      price: product.price,
      image: img,
    }, qty);

    // 写入勾选的跨厂水暖加购条目（独立 key，Avoid 与主柜 key 冲突）
    var checked = document.querySelectorAll('input[name="bundled_addon"]:checked');
    for (var i = 0; i < checked.length; i++) {
      var cb = checked[i];
      var aSku = cb.dataset.sku || cb.dataset.id;
      pushItem(cart, {
        key: (cb.dataset.id || aSku) + "|" + aSku,
        id: cb.dataset.id || "",
        name: cb.dataset.title || "",
        sku: aSku,
        variant: "Color-Matched Bundle for " + sku,
        bundleOf: sku,
        price: Number(cb.dataset.price) || 0,
        image: cb.dataset.image || "",
      }, qty);
    }

    try { localStorage.setItem("cart", JSON.stringify(cart)); } catch (err) {}
    updateCounts(cart);

    var msg = document.getElementById("quote-feedback-msg");
    if (msg) {
      msg.classList.remove("hidden");
      setTimeout(function () { msg.classList.add("hidden"); }, 4000);
    }
    if (addBtn) addBtn.textContent = "Added to Quote List!";
    setTimeout(function () { if (addBtn) addBtn.textContent = "+ Add Selected to Quote List"; }, 2000);
  }

  if (form) form.addEventListener("submit", submitSelection);
  if (stickyBtn) stickyBtn.addEventListener("click", submitSelection);
</script>